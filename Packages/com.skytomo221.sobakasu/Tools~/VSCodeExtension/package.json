{
  "name": "sobakasu",
  "displayName": "Sobakasu Language",
  "description": "Syntax highlighting for the Sobakasu programming language and Udon Assembly",
  "version": "0.0.3",
  "publisher": "skytomo221",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sobakasu",
        "aliases": [
          "Sobakasu",
          "sobakasu"
        ],
        "extensions": [
          ".sobakasu"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "uasm",
        "aliases": [
          "Udon Assembly",
          "UASM"
        ],
        "extensions": [
          ".uasm"
        ],
        "configuration": "./uasm-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sobakasu",
        "scopeName": "source.sobakasu",
        "path": "./syntaxes/sobakasu.tmLanguage.json"
      },
      {
        "language": "uasm",
        "scopeName": "source.uasm",
        "path": "./syntaxes/uasm.tmLanguage.json"
      }
    ]
  }
}
