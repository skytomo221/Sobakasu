{
  "name": "sobakasu",
  "displayName": "Sobakasu Language",
  "description": "Syntax highlighting for the Sobakasu programming language and Udon Assembly",
  "version": "0.0.5",
  "publisher": "skytomo221",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skytomo221/Sobakasu.git",
    "directory": "Packages/com.skytomo221.sobakasu/Tools~/VSCodeExtension"
  },
  "homepage": "https://github.com/skytomo221/Sobakasu",
  "bugs": {
    "url": "https://github.com/skytomo221/Sobakasu/issues"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "sobakasu",
    "udon",
    "uasm",
    "vrchat",
    "udon assembly"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sobakasu",
        "aliases": [
          "Sobakasu",
          "sobakasu"
        ],
        "extensions": [
          ".sobakasu"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "uasm",
        "aliases": [
          "Udon Assembly",
          "UASM"
        ],
        "extensions": [
          ".uasm"
        ],
        "configuration": "./uasm-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sobakasu",
        "scopeName": "source.sobakasu",
        "path": "./syntaxes/sobakasu.tmLanguage.json"
      },
      {
        "language": "uasm",
        "scopeName": "source.uasm",
        "path": "./syntaxes/uasm.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "package:check": "vsce ls --no-dependencies",
    "package": "vsce package --no-dependencies"
  }
}
