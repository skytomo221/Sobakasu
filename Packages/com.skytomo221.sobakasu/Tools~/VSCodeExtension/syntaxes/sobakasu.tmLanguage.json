{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sobakasu",
  "scopeName": "source.sobakasu",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#quoted-identifiers"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#function-declarations"
    },
    {
      "include": "#type-declarations"
    },
    {
      "include": "#event-declarations"
    },
    {
      "include": "#sync-modes"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sobakasu",
          "match": "//.*$"
        },
        {
          "include": "#block-comments"
        }
      ]
    },
    "block-comments": {
      "name": "comment.block.sobakasu",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#block-comments"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sobakasu",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sobakasu",
              "match": "\\\\[\"\\\\nrt]"
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.sobakasu",
          "match": "'(?:\\\\.|[^'\\\\])'"
        }
      ]
    },
    "quoted-identifiers": {
      "patterns": [
        {
          "name": "entity.name.quoted.sobakasu",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.sobakasu",
          "match": "\\b(?:0[bB][01](?:_?[01])*|0[oO][0-7](?:_?[0-7])*|0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*|[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?)(?:i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)?\\b"
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "begin": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(function)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])\\s+(`[^`\\r\\n]*`\\??|[\\p{XID_Start}_\\p{Cn}][\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}]*\\??|@?(?:<<=|>>=|<<|>>|==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|[+\\-*/%<>=!~&|^]))",
          "beginCaptures": {
            "1": {
              "name": "storage.type.function.sobakasu"
            },
            "2": {
              "name": "entity.name.function.sobakasu"
            }
          },
          "end": "(?=\\{)|(?<=;)|(?=\\})",
          "patterns": [
            {
              "include": "#external-binding"
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "match": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(type|struct|enum)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])\\s+(`[^`\\r\\n]*`|[\\p{XID_Start}_\\p{Cn}][\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.sobakasu"
            },
            "2": {
              "name": "entity.name.type.sobakasu"
            }
          }
        },
        {
          "match": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(module)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])\\s+(`[^`\\r\\n]*`|[\\p{XID_Start}_\\p{Cn}][\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.sobakasu"
            },
            "2": {
              "name": "entity.name.namespace.sobakasu"
            }
          }
        }
      ]
    },
    "event-declarations": {
      "patterns": [
        {
          "match": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(on|receive)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])\\s+(`[^`\\r\\n]*`|[\\p{XID_Start}_\\p{Cn}][\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.sobakasu"
            },
            "2": {
              "name": "entity.name.function.event.sobakasu"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sobakasu",
          "match": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(?:if|else|match|while|loop|break|continue|redo|return)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])"
        },
        {
          "name": "keyword.declaration.sobakasu",
          "match": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(?:function|on|receive|type|struct|enum|implementation|module|use|as|const|state|behavior|field|let|mutable|public|extern|ref|out|sync|language|item)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])"
        },
        {
          "name": "keyword.other.sobakasu",
          "match": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(?:new|send|to)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])"
        },
        {
          "name": "variable.language.sobakasu",
          "match": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(?:self|Self)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])"
        },
        {
          "name": "invalid.deprecated.sobakasu",
          "match": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(?:static)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.sobakasu",
          "match": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(?:bool|char|string|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.sobakasu",
          "match": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(?:true|false)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.sobakasu",
          "match": "'[\\p{XID_Start}_\\p{Cn}][\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}]*(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}]|')"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "support.function.sobakasu",
          "match": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])[\\p{XID_Start}_\\p{Cn}][\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}]*\\??(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "punctuation.separator.path.sobakasu",
          "match": "::"
        },
        {
          "name": "punctuation.separator.type.sobakasu",
          "match": ":(?!:)"
        },
        {
          "name": "keyword.operator.sobakasu",
          "match": "<<=|>>=|==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<|>>|->|=>|[+\\-*/%<>=!~&|^?@]"
        }
      ]
    },
    "external-binding": {
      "begin": "=(?!=)",
      "beginCaptures": {
        "0": {
          "name": "keyword.operator.sobakasu"
        }
      },
      "end": "(?=;|\\})",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "begin": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(?:maybe)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])",
          "beginCaptures": {
            "0": {
              "name": "keyword.declaration.contextual.sobakasu"
            }
          },
          "end": "(?=(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(?:extern)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}]))",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        },
        {
          "begin": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(?:extern)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])",
          "beginCaptures": {
            "0": {
              "name": "keyword.declaration.sobakasu"
            }
          },
          "end": "(?=;|\\})",
          "patterns": [
            {
              "name": "keyword.declaration.contextual.sobakasu",
              "match": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(?:maybe)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(?=\\s+out(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}]))"
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "sync-modes": {
      "begin": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(sync)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.sobakasu"
        }
      },
      "end": "\\)|(?=;|\\})",
      "patterns": [
        {
          "name": "storage.modifier.sobakasu",
          "match": "(?<![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])(?:none|linear|smooth)(?![\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}])"
        },
        {
          "include": "#comments"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.sobakasu",
          "match": "[\\p{XID_Start}_\\p{Cn}][\\p{XID_Continue}\\x{200C}\\x{200D}\\x{30FB}\\x{FF65}\\p{Cn}]*"
        }
      ]
    }
  }
}
