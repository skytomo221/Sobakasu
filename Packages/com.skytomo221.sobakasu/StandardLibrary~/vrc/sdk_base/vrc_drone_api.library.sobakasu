public type VRCDroneApi = extern VRC.SDKBase.VRCDroneApi;

implementation VRCDroneApi {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_player(self) -> VRC::SDKBase::VRCPlayerApi
    = extern self.GetPlayer()

  public function get_position(self) -> UnityEngine::Vector3
    = extern self.GetPosition()

  public function get_rotation(self) -> UnityEngine::Quaternion
    = extern self.GetRotation()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function get_velocity(self) -> UnityEngine::Vector3
    = extern self.GetVelocity()

  public function deployed?(self) -> bool
    = extern self.IsDeployed()

  public function set_velocity(self, velocity: UnityEngine::Vector3)
    = extern self.SetVelocity(velocity)

  public function teleport_to(self, position: UnityEngine::Vector3, rotation: UnityEngine::Quaternion)
    = extern self.TeleportTo(position, rotation)

  public function teleport_to(self, position: UnityEngine::Vector3, rotation: UnityEngine::Quaternion, lerp_on_remote: bool)
    = extern self.TeleportTo(position, rotation, lerp_on_remote)

  public function to_string(self) -> string
    = extern self.ToString()

  public function try_get_position(self) -> (bool, UnityEngine::Vector3)
    = extern self.TryGetPosition(out UnityEngine::Vector3 position)

  public function try_get_rotation(self) -> (bool, UnityEngine::Quaternion)
    = extern self.TryGetRotation(out UnityEngine::Quaternion rotation)

  public function try_get_velocity(self) -> (bool, UnityEngine::Vector3)
    = extern self.TryGetVelocity(out UnityEngine::Vector3 velocity)
}
