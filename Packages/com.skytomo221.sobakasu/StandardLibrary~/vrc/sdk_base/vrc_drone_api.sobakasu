pub type VRCDroneApi = extern VRC.SDKBase.VRCDroneApi;

impl VRCDroneApi {
  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_player(self) -> VRC::SDKBase::VRCPlayerApi
    = extern self.GetPlayer()

  pub fn get_position(self) -> UnityEngine::Vector3
    = extern self.GetPosition()

  pub fn get_rotation(self) -> UnityEngine::Quaternion
    = extern self.GetRotation()

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn get_velocity(self) -> UnityEngine::Vector3
    = extern self.GetVelocity()

  pub fn deployed?(self) -> bool
    = extern self.IsDeployed()

  pub fn set_velocity(self, velocity: UnityEngine::Vector3)
    = extern self.SetVelocity(velocity)

  pub fn teleport_to(self, position: UnityEngine::Vector3, rotation: UnityEngine::Quaternion)
    = extern self.TeleportTo(position, rotation)

  pub fn teleport_to(self, position: UnityEngine::Vector3, rotation: UnityEngine::Quaternion, lerp_on_remote: bool)
    = extern self.TeleportTo(position, rotation, lerp_on_remote)

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn try_get_position(self) -> (bool, UnityEngine::Vector3)
    = extern self.TryGetPosition(out UnityEngine::Vector3 position)

  pub fn try_get_rotation(self) -> (bool, UnityEngine::Quaternion)
    = extern self.TryGetRotation(out UnityEngine::Quaternion rotation)

  pub fn try_get_velocity(self) -> (bool, UnityEngine::Vector3)
    = extern self.TryGetVelocity(out UnityEngine::Vector3 velocity)
}
