public function equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.Equals(obj_a, obj_b)

public function valid?(obj: object) -> bool
  = extern VRC.SDKBase.Utilities.IsValid(obj)

public function reference_equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.ReferenceEquals(obj_a, obj_b)

public function shuffle_array(array: [i32])
  = extern VRC.SDKBase.Utilities.ShuffleArray(array)

public function shuffle_array<T>(array: [T])
  = extern VRC.SDKBase.Utilities.ShuffleArray<T>(array)
