  pub fn get_available_languages() -> [string]
    = extern VRC.SDKBase.VRCPlayerApi.GetAvailableLanguages()

  pub fn get_current_language() -> string
    = extern VRC.SDKBase.VRCPlayerApi.GetCurrentLanguage()

  pub fn get_player_by_id(player_id: i32) -> Self
    = extern VRC.SDKBase.VRCPlayerApi.GetPlayerById(player_id)

  pub fn get_player_count() -> i32
    = extern VRC.SDKBase.VRCPlayerApi.GetPlayerCount()

  pub fn get_player_id(player: Self) -> i32
    = extern VRC.SDKBase.VRCPlayerApi.GetPlayerId(player)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
