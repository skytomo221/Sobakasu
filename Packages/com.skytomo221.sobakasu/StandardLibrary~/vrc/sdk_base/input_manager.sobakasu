public function enable_object_highlight(obj: UnityEngine::GameObject, enable: bool)
  = extern VRC.SDKBase.InputManager.EnableObjectHighlight(obj, enable)

public function enable_object_highlight(r: UnityEngine::Renderer, enable: bool)
  = extern VRC.SDKBase.InputManager.EnableObjectHighlight(r, enable)

public function equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.Equals(obj_a, obj_b)

public function get_last_used_input_method() -> VRC::SDKBase::VRCInputMethod
  = extern VRC.SDKBase.InputManager.GetLastUsedInputMethod()

public function using_hand_controller?() -> bool
  = extern VRC.SDKBase.InputManager.IsUsingHandController()

public function reference_equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.ReferenceEquals(obj_a, obj_b)
