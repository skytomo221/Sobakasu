pub fn enable_object_highlight(obj: UnityEngine.GameObject, enable: bool)
  = extern VRC.SDKBase.InputManager.EnableObjectHighlight(obj, enable)

pub fn enable_object_highlight(r: UnityEngine.Renderer, enable: bool)
  = extern VRC.SDKBase.InputManager.EnableObjectHighlight(r, enable)

pub fn get_last_used_input_method() -> VRC.SDKBase.VRCInputMethod
  = extern VRC.SDKBase.InputManager.GetLastUsedInputMethod()

pub fn using_hand_controller?() -> bool
  = extern VRC.SDKBase.InputManager.IsUsingHandController()
