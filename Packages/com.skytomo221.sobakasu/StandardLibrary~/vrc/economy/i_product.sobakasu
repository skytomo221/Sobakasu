pub type IProduct = extern VRC.Economy.IProduct;

impl IProduct {
  pub fn buyer(self) -> VRC::SDKBase::VRCPlayerApi
    = extern self.Buyer

  pub fn description(self) -> string
    = extern self.Description

  pub fn id(self) -> string
    = extern self.ID

  pub fn name(self) -> string
    = extern self.Name
}
