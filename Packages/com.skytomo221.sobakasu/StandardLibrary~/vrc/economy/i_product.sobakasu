public type IProduct = extern VRC.Economy.IProduct;

implementation IProduct {
  public function buyer(self) -> VRC::SDKBase::VRCPlayerApi
    = extern self.Buyer

  public function description(self) -> string
    = extern self.Description

  public function id(self) -> string
    = extern self.ID

  public function name(self) -> string
    = extern self.Name
}
