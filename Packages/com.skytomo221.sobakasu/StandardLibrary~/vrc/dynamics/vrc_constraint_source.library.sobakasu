use maybe::Maybe;

public struct VRCConstraintSource = extern VRC.Dynamics.VRCConstraintSource {
  parent_position_offset: UnityEngine::Vector3 = extern ParentPositionOffset,
  parent_rotation_offset: UnityEngine::Vector3 = extern ParentRotationOffset,
  source_transform: UnityEngine::Transform = extern SourceTransform,
  weight: f32 = extern Weight,
}

implementation VRCConstraintSource {
  public function new(transform: UnityEngine::Transform, weight: f32) -> Self
    = extern new Self(transform, weight)

  public function new(transform: UnityEngine::Transform, weight: f32, parent_position_offset: UnityEngine::Vector3, parent_rotation_offset: UnityEngine::Vector3) -> Self
    = extern new Self(transform, weight, parent_position_offset, parent_rotation_offset)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()
}
