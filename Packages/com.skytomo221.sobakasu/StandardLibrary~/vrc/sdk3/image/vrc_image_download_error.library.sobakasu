use maybe::Maybe;

public enum VRCImageDownloadError = extern VRC.SDK3.Image.VRCImageDownloadError {
  AccessDenied = extern AccessDenied,
  DownloadError = extern DownloadError,
  InvalidImage = extern InvalidImage,
  InvalidURL = extern InvalidURL,
  TooManyRequests = extern TooManyRequests,
  Unknown = extern Unknown,
}
