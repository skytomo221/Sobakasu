pub impl VRCImageDownloadError = extern VRC.SDK3.Image.VRCImageDownloadError {
  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub static fn access_denied -> Self
    = extern Self.AccessDenied

  pub static fn download_error -> Self
    = extern Self.DownloadError

  pub static fn invalid_image -> Self
    = extern Self.InvalidImage

  pub static fn invalid_url -> Self
    = extern Self.InvalidURL

  pub static fn too_many_requests -> Self
    = extern Self.TooManyRequests

  pub static fn unknown -> Self
    = extern Self.Unknown
}
