public type IVRCImageDownload = extern VRC.SDK3.Image.IVRCImageDownload;

implementation IVRCImageDownload {
  public function error_message(self) -> string
    = extern self.ErrorMessage

  public function error(self) -> VRC::SDK3::Image::VRCImageDownloadError
    = extern self.Error

  public function material(self) -> UnityEngine::Material
    = extern self.Material

  public function progress(self) -> f32
    = extern self.Progress

  public function result(self) -> UnityEngine::Texture2D
    = extern self.Result

  public function size_in_memory_bytes(self) -> i32
    = extern self.SizeInMemoryBytes

  public function `state`(self) -> VRC::SDK3::Image::VRCImageDownloadState
    = extern self.State

  public function texture_info(self) -> VRC::SDK3::Image::TextureInfo
    = extern self.TextureInfo

  public function udon_behaviour(self) -> VRC::Udon::Common::Interfaces::IUdonEventReceiver
    = extern self.UdonBehaviour

  public function url(self) -> VRC::SDKBase::VRCUrl
    = extern self.Url
