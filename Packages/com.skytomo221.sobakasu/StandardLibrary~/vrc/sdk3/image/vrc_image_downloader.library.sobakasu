public type VRCImageDownloader = extern VRC.SDK3.Image.VRCImageDownloader;

implementation VRCImageDownloader {
  public function new() -> Self
    = extern new Self()

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function dispose(self)
    = extern self.Dispose()

  public function download_image(self, url: VRC::SDKBase::VRCUrl, material: UnityEngine::Material, udon_behaviour: VRC::Udon::Common::Interfaces::IUdonEventReceiver, texture_info: VRC::SDK3::Image::TextureInfo) -> VRC::SDK3::Image::IVRCImageDownload
    = extern self.DownloadImage(url, material, udon_behaviour, texture_info)

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function to_string(self) -> string
    = extern self.ToString()
}
