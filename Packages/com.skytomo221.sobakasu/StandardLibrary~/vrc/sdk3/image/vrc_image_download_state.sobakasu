pub impl VRCImageDownloadState = extern VRC.SDK3.Image.VRCImageDownloadState {
  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub static fn complete -> Self
    = extern Self.Complete

  pub static fn error -> Self
    = extern Self.Error

  pub static fn pending -> Self
    = extern Self.Pending

  pub static fn unknown -> Self
    = extern Self.Unknown

  pub static fn unloaded -> Self
    = extern Self.Unloaded
}
