pub type VRCImageDownloader = extern VRC.SDK3.Image.VRCImageDownloader;

impl VRCImageDownloader {
  pub fn new() -> Self
    = extern new Self()

  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn dispose(self)
    = extern self.Dispose()

  pub fn download_image(self, url: VRC::SDKBase::VRCUrl, material: UnityEngine::Material, udon_behaviour: VRC::Udon::Common::Interfaces::IUdonEventReceiver, texture_info: VRC::SDK3::Image::TextureInfo) -> VRC::SDK3::Image::IVRCImageDownload
    = extern self.DownloadImage(url, material, udon_behaviour, texture_info)

  pub fn equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn to_string(self) -> string
    = extern self.ToString()
}
