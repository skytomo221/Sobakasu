use maybe::Maybe;

public type IVRCStringDownload = extern VRC.SDK3.StringLoading.IVRCStringDownload;

implementation IVRCStringDownload {
  public function error_code(self) -> i32
    = extern self.ErrorCode

  public function error(self) -> Maybe<string>
    = maybe extern self.Error

  public function result_bytes(self) -> Maybe<[u8]>
    = maybe extern self.ResultBytes

  public function result(self) -> Maybe<string>
    = maybe extern self.Result

  public function udon_behaviour(self) -> Maybe<VRC::Udon::Common::Interfaces::IUdonEventReceiver>
    = maybe extern self.UdonBehaviour

  public function url(self) -> Maybe<VRC::SDKBase::VRCUrl>
    = maybe extern self.Url
}
