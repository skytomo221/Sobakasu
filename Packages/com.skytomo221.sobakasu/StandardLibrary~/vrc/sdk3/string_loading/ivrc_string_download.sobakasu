public type IVRCStringDownload = extern VRC.SDK3.StringLoading.IVRCStringDownload;

implementation IVRCStringDownload {
  public function error_code(self) -> i32
    = extern self.ErrorCode

  public function error(self) -> string
    = extern self.Error

  public function result_bytes(self) -> [u8]
    = extern self.ResultBytes

  public function result(self) -> string
    = extern self.Result

  public function udon_behaviour(self) -> VRC::Udon::Common::Interfaces::IUdonEventReceiver
    = extern self.UdonBehaviour

  public function url(self) -> VRC::SDKBase::VRCUrl
    = extern self.Url
}
