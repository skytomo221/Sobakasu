pub impl VideoError = extern VRC.SDK3.Components.Video.VideoError {
  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub static fn access_denied -> Self
    = extern Self.AccessDenied

  pub static fn invalid_url -> Self
    = extern Self.InvalidURL

  pub static fn player_error -> Self
    = extern Self.PlayerError

  pub static fn rate_limited -> Self
    = extern Self.RateLimited

  pub static fn unknown -> Self
    = extern Self.Unknown
}
