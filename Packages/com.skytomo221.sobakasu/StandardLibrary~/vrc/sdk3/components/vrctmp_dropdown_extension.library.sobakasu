public function add_options(dropdown: TMPro::TMP_Dropdown, options: [string])
  = extern VRC.SDK3.Components.VRCTMPDropdownExtension.AddOptions(dropdown, options)

public function add_options(dropdown: TMPro::TMP_Dropdown, options: [TMPro::TMP_Dropdown::OptionData])
  = extern VRC.SDK3.Components.VRCTMPDropdownExtension.AddOptions(dropdown, options)

public function add_options(dropdown: TMPro::TMP_Dropdown, options: [UnityEngine::Sprite])
  = extern VRC.SDK3.Components.VRCTMPDropdownExtension.AddOptions(dropdown, options)

public function equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.Equals(obj_a, obj_b)

public function reference_equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.ReferenceEquals(obj_a, obj_b)
