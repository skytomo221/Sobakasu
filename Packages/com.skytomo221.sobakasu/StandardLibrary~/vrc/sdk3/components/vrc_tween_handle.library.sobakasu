public struct VRCTweenHandle = extern VRC.SDK3.Components.VRCTweenHandle {
}

implementation VRCTweenHandle {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function ==(self, rhs: Self) -> bool
    = extern self == rhs

  public function !=(self, rhs: Self) -> bool
    = extern self != rhs

  public function change_end_value(self, new_end_value: f32, snap_start_value: bool) -> Self
    = extern self.ChangeEndValue(new_end_value, snap_start_value)

  public function change_end_value(self, new_end_value: UnityEngine::Color, snap_start_value: bool) -> Self
    = extern self.ChangeEndValue(new_end_value, snap_start_value)

  public function change_end_value(self, new_end_value: UnityEngine::Vector2, snap_start_value: bool) -> Self
    = extern self.ChangeEndValue(new_end_value, snap_start_value)

  public function change_end_value(self, new_end_value: UnityEngine::Vector3, snap_start_value: bool) -> Self
    = extern self.ChangeEndValue(new_end_value, snap_start_value)

  public function complete(self)
    = extern self.Complete()

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function equals(self, other: Self) -> bool
    = extern self.Equals(other)

  public function flip(self)
    = extern self.Flip()

  public function from(self) -> Self
    = extern self.From()

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function goto(self, to_: f32, and_play: bool)
    = extern self.Goto(to_, and_play)

  public function kill(self)
    = extern self.Kill()

  public function on_complete(self, callback: VRC::Udon::Common::Interfaces::IUdonEventReceiver, event_name: string) -> Self
    = extern self.OnComplete(callback, event_name)

  public function on_rewind(self, callback: VRC::Udon::Common::Interfaces::IUdonEventReceiver, event_name: string) -> Self
    = extern self.OnRewind(callback, event_name)

  public function pause(self) -> Self
    = extern self.Pause()

  public function play_backwards(self)
    = extern self.PlayBackwards()

  public function play_forwards(self)
    = extern self.PlayForwards()

  public function play(self)
    = extern self.Play()

  public function restart(self)
    = extern self.Restart()

  public function set_delay(self, delay: f32) -> Self
    = extern self.SetDelay(delay)

  public function set_duration(self, duration: f32) -> Self
    = extern self.SetDuration(duration)

  public function set_ease(self, curve: UnityEngine::AnimationCurve) -> Self
    = extern self.SetEase(curve)

  public function set_ease(self, ease_type: VRC::SDK3::Components::VRCTweenEase) -> Self
    = extern self.SetEase(ease_type)

  public function set_loops(self, loops: i32, loop_type: VRC::SDK3::Components::VRCTweenLoopType) -> Self
    = extern self.SetLoops(loops, loop_type)

  public function set_speed_based(self) -> Self
    = extern self.SetSpeedBased()

  public function set_update(self, update_type: VRC::SDK3::Components::VRCTweenUpdateType) -> Self
    = extern self.SetUpdate(update_type)

  public function to_string(self) -> string
    = extern self.ToString()

  public function duration(self) -> f32
    = extern self.Duration

  public function elapsed(self) -> f32
    = extern self.Elapsed

  public function active?(self) -> bool
    = extern self.IsActive

  public function backwards?(self) -> bool
    = extern self.IsBackwards

  public function playing?(self) -> bool
    = extern self.IsPlaying

  public function valid?(self) -> bool
    = extern self.IsValid
}
