  Short = extern Short,
  UShort = extern UShort,
  Int = extern Int,
  UInt = extern UInt,
  Long = extern Long,
  ULong = extern ULong,
  Float = extern Float,
  Double = extern Double,
  String = extern String,
  DataList = extern DataList,
  DataDictionary = extern DataDictionary,
