use maybe::Maybe;

public enum DataError = extern VRC.SDK3.Data.DataError {
  IndexOutOfRange = extern IndexOutOfRange,
  KeyDoesNotExist = extern KeyDoesNotExist,
  None = extern None,
  TypeMismatch = extern TypeMismatch,
  TypeUnsupported = extern TypeUnsupported,
  UnableToParse = extern UnableToParse,
  ValueUnsupported = extern ValueUnsupported,
}
