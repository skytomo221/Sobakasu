public struct UdonInputEventArgs = extern VRC.Udon.Common.UdonInputEventArgs {
  bool_value: bool = extern boolValue,
  event_type: VRC::Udon::Common::UdonInputEventType = extern eventType,
  float_value: f32 = extern floatValue,
  hand_type: VRC::Udon::Common::HandType = extern handType,
}

implementation UdonInputEventArgs {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function get_type(self) -> System::Type
    = extern self.GetType()
}
