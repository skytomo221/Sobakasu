public struct SerializationResult = extern VRC.Udon.Common.SerializationResult {
  byte_count: i32 = extern byteCount,
  success: bool = extern success,
}

implementation SerializationResult {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function get_type(self) -> System::Type
    = extern self.GetType()
}
