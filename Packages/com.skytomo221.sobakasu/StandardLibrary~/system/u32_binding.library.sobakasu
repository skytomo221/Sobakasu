public implementation u32 = extern System.UInt32 {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function parse(s: string) -> u32
    = extern System.UInt32.Parse(s)

  public function parse(s: string, style: System::Globalization::NumberStyles) -> u32
    = extern System.UInt32.Parse(s, style)

  public function parse(s: string, style: System::Globalization::NumberStyles, provider: System::IFormatProvider) -> u32
    = extern System.UInt32.Parse(s, style, provider)

  public function parse(s: string, provider: System::IFormatProvider) -> u32
    = extern System.UInt32.Parse(s, provider)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function try_parse(s: string, style: System::Globalization::NumberStyles, provider: System::IFormatProvider) -> (bool, u32)
    = extern System.UInt32.TryParse(string s, System::Globalization::NumberStyles style, System::IFormatProvider provider, out u32 result)

  public function try_parse(s: string) -> (bool, u32)
    = extern System.UInt32.TryParse(string s, out u32 result)

  public function compare_to(self, value: object) -> i32
    = extern self.CompareTo(value)

  public function compare_to(self, value: u32) -> i32
    = extern self.CompareTo(value)

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function equals(self, obj: u32) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function to_string(self) -> string
    = extern self.ToString()

  public function to_string(self, provider: System::IFormatProvider) -> string
    = extern self.ToString(provider)

  public function to_string(self, format: string) -> string
    = extern self.ToString(format)

  public function to_string(self, format: string, provider: System::IFormatProvider) -> string
    = extern self.ToString(format, provider)

  public function max_value -> u32
    = extern System.UInt32.MaxValue

  public function min_value -> u32
    = extern System.UInt32.MinValue
}
