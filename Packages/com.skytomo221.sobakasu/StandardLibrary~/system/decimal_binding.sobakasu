  pub fn to_u_int32(d: Self) -> u32
    = extern System.Decimal.ToUInt32(d)

  pub fn to_u_int64(d: Self) -> u64
    = extern System.Decimal.ToUInt64(d)

  pub fn truncate(d: Self) -> Self
    = extern System.Decimal.Truncate(d)

  pub fn try_parse(s: string, style: System::Globalization::NumberStyles, provider: System::IFormatProvider) -> (bool, Self)
    = extern System.Decimal.TryParse(string s, System::Globalization::NumberStyles style, System::IFormatProvider provider, out Self result)

  pub fn try_parse(s: string) -> (bool, Self)
    = extern System.Decimal.TryParse(string s, out Self result)

