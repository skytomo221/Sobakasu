    = extern System.Decimal.Remainder(d1, d2)

  pub fn round(d: Self) -> Self
    = extern System.Decimal.Round(d)

  pub fn round(d: Self, decimals: i32) -> Self
    = extern System.Decimal.Round(d, decimals)

  pub fn round(d: Self, decimals: i32, mode: System::MidpointRounding) -> Self
    = extern System.Decimal.Round(d, decimals, mode)

  pub fn round(d: Self, mode: System::MidpointRounding) -> Self
    = extern System.Decimal.Round(d, mode)

  pub fn subtract(d1: Self, d2: Self) -> Self
    = extern System.Decimal.Subtract(d1, d2)

  pub fn to_byte(value: Self) -> u8
    = extern System.Decimal.ToByte(value)

  pub fn to_double(d: Self) -> f64
    = extern System.Decimal.ToDouble(d)

  pub fn to_int16(value: Self) -> i16
    = extern System.Decimal.ToInt16(value)

  pub fn to_int32(d: Self) -> i32
    = extern System.Decimal.ToInt32(d)

  pub fn to_int64(d: Self) -> i64
    = extern System.Decimal.ToInt64(d)

  pub fn to_oa_currency(value: Self) -> i64
    = extern System.Decimal.ToOACurrency(value)

  pub fn to_s_byte(value: Self) -> i8
    = extern System.Decimal.ToSByte(value)

  pub fn to_single(d: Self) -> f32
    = extern System.Decimal.ToSingle(d)

  pub fn to_u_int16(value: Self) -> u16
