pub struct Decimal = extern System.Decimal {
}

impl Decimal {
  pub fn new(value: f64) -> Self
    = extern new Self(value)

  pub fn new(lo: i32, mid: i32, hi: i32, is_negative: bool, scale: u8) -> Self
    = extern new Self(lo, mid, hi, is_negative, scale)

  pub fn new(value: i32) -> Self
    = extern new Self(value)

  pub fn new(bits: [i32]) -> Self
    = extern new Self(bits)

  pub fn new(value: i64) -> Self
    = extern new Self(value)

  pub fn new(value: f32) -> Self
    = extern new Self(value)

  pub fn new(value: u32) -> Self
