    = extern System.Decimal.FromOACurrency(cy)

  pub fn get_bits(d: Self) -> [i32]
    = extern System.Decimal.GetBits(d)

  pub fn multiply(d1: Self, d2: Self) -> Self
    = extern System.Decimal.Multiply(d1, d2)

  pub fn negate(d: Self) -> Self
    = extern System.Decimal.Negate(d)

  pub fn parse(s: string) -> Self
    = extern System.Decimal.Parse(s)

  pub fn parse(s: string, style: System::Globalization::NumberStyles) -> Self
    = extern System.Decimal.Parse(s, style)

  pub fn parse(s: string, style: System::Globalization::NumberStyles, provider: System::IFormatProvider) -> Self
    = extern System.Decimal.Parse(s, style, provider)

  pub fn parse(s: string, provider: System::IFormatProvider) -> Self
    = extern System.Decimal.Parse(s, provider)

