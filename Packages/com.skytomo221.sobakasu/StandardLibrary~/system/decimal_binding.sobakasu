    = extern self % rhs

  pub fn *(self, rhs: Self) -> Self
    = extern self * rhs

  pub fn -(self, rhs: Self) -> Self
    = extern self - rhs

  pub fn @-(self) -> Self
    = extern -self

  pub fn @+(self) -> Self
