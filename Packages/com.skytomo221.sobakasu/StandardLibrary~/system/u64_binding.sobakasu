pub impl u64 = extern System.UInt64 {
  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn parse(s: string) -> u64
    = extern System.UInt64.Parse(s)

  pub fn parse(s: string, style: System::Globalization::NumberStyles) -> u64
    = extern System.UInt64.Parse(s, style)

  pub fn parse(s: string, style: System::Globalization::NumberStyles, provider: System::IFormatProvider) -> u64
    = extern System.UInt64.Parse(s, style, provider)

  pub fn parse(s: string, provider: System::IFormatProvider) -> u64
    = extern System.UInt64.Parse(s, provider)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn try_parse(s: string, style: System::Globalization::NumberStyles, provider: System::IFormatProvider) -> (bool, u64)
    = extern System.UInt64.TryParse(string s, System::Globalization::NumberStyles style, System::IFormatProvider provider, out u64 result)

  pub fn try_parse(s: string) -> (bool, u64)
    = extern System.UInt64.TryParse(string s, out u64 result)

  pub fn compare_to(self, value: object) -> i32
    = extern self.CompareTo(value)

  pub fn compare_to(self, value: u64) -> i32
    = extern self.CompareTo(value)

  pub fn equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  pub fn equals(self, obj: u64) -> bool
    = extern self.Equals(obj)

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn to_string(self, provider: System::IFormatProvider) -> string
    = extern self.ToString(provider)

  pub fn to_string(self, format: string) -> string
    = extern self.ToString(format)

  pub fn to_string(self, format: string, provider: System::IFormatProvider) -> string
    = extern self.ToString(format, provider)

  pub fn max_value -> u64
    = extern System.UInt64.MaxValue

  pub fn min_value -> u64
    = extern System.UInt64.MinValue
}
