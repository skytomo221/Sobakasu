pub impl i64 = extern System.Int64 {
  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn parse(s: string) -> i64
    = extern System.Int64.Parse(s)

  pub static fn parse(s: string, style: System.Globalization.NumberStyles) -> i64
    = extern System.Int64.Parse(s, style)

  pub static fn parse(s: string, style: System.Globalization.NumberStyles, provider: System.IFormatProvider) -> i64
    = extern System.Int64.Parse(s, style, provider)

  pub static fn parse(s: string, provider: System.IFormatProvider) -> i64
    = extern System.Int64.Parse(s, provider)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub static fn try_parse(s: string, style: System.Globalization.NumberStyles, provider: System.IFormatProvider) -> (bool, i64)
    = extern System.Int64.TryParse(string s, System.Globalization.NumberStyles style, System.IFormatProvider provider, out i64 result)

  pub static fn try_parse(s: string) -> (bool, i64)
    = extern System.Int64.TryParse(string s, out i64 result)

  pub fn compare_to(value: i64) -> i32
    = extern self.CompareTo(value)

  pub fn compare_to(value: object) -> i32
    = extern self.CompareTo(value)

  pub fn equals(obj: i64) -> bool
    = extern self.Equals(obj)

  pub fn equals(obj: object) -> bool
    = extern self.Equals(obj)

  pub fn get_hash_code() -> i32
    = extern self.GetHashCode()

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn to_string() -> string
    = extern self.ToString()

  pub fn to_string(provider: System.IFormatProvider) -> string
    = extern self.ToString(provider)

  pub fn to_string(format: string) -> string
    = extern self.ToString(format)

  pub fn to_string(format: string, provider: System.IFormatProvider) -> string
    = extern self.ToString(format, provider)

  pub static fn max_value -> i64
    = extern Self.MaxValue

  pub static fn min_value -> i64
    = extern Self.MinValue
}
