public type Type = extern System.Type;

implementation Type {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function get_type(type_name: string) -> Self
    = extern System.Type.GetType(type_name)

  public function get_type(type_name: string, throw_on_error: bool) -> Self
    = extern System.Type.GetType(type_name, throw_on_error)

  public function get_type(type_name: string, throw_on_error: bool, ignore_case: bool) -> Self
    = extern System.Type.GetType(type_name, throw_on_error, ignore_case)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function ==(self, rhs: Self) -> bool
    = extern self == rhs

  public function !=(self, rhs: Self) -> bool
    = extern self != rhs

  public function equals(self, o: object) -> bool
    = extern self.Equals(o)

  public function equals(self, o: Self) -> bool
    = extern self.Equals(o)

  public function get_array_rank(self) -> i32
    = extern self.GetArrayRank()

  public function get_element_type(self) -> Self
    = extern self.GetElementType()

  public function get_enum_names(self) -> [string]
    = extern self.GetEnumNames()

  public function get_enum_name(self, value: object) -> string
    = extern self.GetEnumName(value)

  public function get_enum_underlying_type(self) -> Self
    = extern self.GetEnumUnderlyingType()

  public function get_enum_values(self) -> System::Array
    = extern self.GetEnumValues()

  public function get_generic_type_definition(self) -> Self
    = extern self.GetGenericTypeDefinition()

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_nested_type(self, name: string) -> Self
    = extern self.GetNestedType(name)

  public function assignable_from?(self, c: Self) -> bool
    = extern self.IsAssignableFrom(c)

  public function enum_defined?(self, value: object) -> bool
    = extern self.IsEnumDefined(value)

  public function equivalent_to?(self, other: Self) -> bool
    = extern self.IsEquivalentTo(other)

  public function instance_of_type?(self, o: object) -> bool
    = extern self.IsInstanceOfType(o)

  public function subclass_of?(self, c: Self) -> bool
    = extern self.IsSubclassOf(c)

  public function make_array_type(self) -> Self
    = extern self.MakeArrayType()

  public function make_array_type(self, rank: i32) -> Self
    = extern self.MakeArrayType(rank)

  public function make_by_ref_type(self) -> Self
    = extern self.MakeByRefType()

  public function to_string(self) -> string
    = extern self.ToString()

  public function base_type(self) -> Self
    = extern self.BaseType

  public function contains_generic_parameters(self) -> bool
    = extern self.ContainsGenericParameters

  public function declaring_type(self) -> Self
    = extern self.DeclaringType

  public function full_name(self) -> string
    = extern self.FullName

  public function guid(self) -> System::Guid
    = extern self.GUID

  public function generic_parameter_position(self) -> i32
    = extern self.GenericParameterPosition

  public function has_element_type(self) -> bool
    = extern self.HasElementType

  public function abstract?(self) -> bool
    = extern self.IsAbstract

  public function ansi_class?(self) -> bool
    = extern self.IsAnsiClass

  public function array?(self) -> bool
    = extern self.IsArray

  public function auto_class?(self) -> bool
    = extern self.IsAutoClass

  public function auto_layout?(self) -> bool
    = extern self.IsAutoLayout

  public function by_ref?(self) -> bool
    = extern self.IsByRef

  public function com_object?(self) -> bool
    = extern self.IsCOMObject

  public function class?(self) -> bool
    = extern self.IsClass

  public function constructed_generic_type?(self) -> bool
    = extern self.IsConstructedGenericType

  public function contextful?(self) -> bool
    = extern self.IsContextful

  public function `enum`?(self) -> bool
    = extern self.IsEnum

  public function explicit_layout?(self) -> bool
    = extern self.IsExplicitLayout

  public function generic_parameter?(self) -> bool
    = extern self.IsGenericParameter

  public function generic_type_definition?(self) -> bool
    = extern self.IsGenericTypeDefinition

  public function generic_type?(self) -> bool
    = extern self.IsGenericType

  public function import?(self) -> bool
    = extern self.IsImport

  public function interface?(self) -> bool
    = extern self.IsInterface

  public function layout_sequential?(self) -> bool
    = extern self.IsLayoutSequential

  public function marshal_by_ref?(self) -> bool
    = extern self.IsMarshalByRef

  public function nested_assembly?(self) -> bool
    = extern self.IsNestedAssembly

  public function nested_fam_and_assem?(self) -> bool
    = extern self.IsNestedFamANDAssem

  public function nested_fam_or_assem?(self) -> bool
    = extern self.IsNestedFamORAssem

  public function nested_family?(self) -> bool
    = extern self.IsNestedFamily

  public function nested_private?(self) -> bool
    = extern self.IsNestedPrivate

  public function nested_public?(self) -> bool
    = extern self.IsNestedPublic

  public function nested?(self) -> bool
    = extern self.IsNested

  public function not_public?(self) -> bool
    = extern self.IsNotPublic

  public function pointer?(self) -> bool
    = extern self.IsPointer

  public function primitive?(self) -> bool
    = extern self.IsPrimitive

  public function public?(self) -> bool
    = extern self.IsPublic

  public function sz_array?(self) -> bool
    = extern self.IsSZArray

  public function sealed?(self) -> bool
    = extern self.IsSealed

  public function security_critical?(self) -> bool
    = extern self.IsSecurityCritical

  public function security_safe_critical?(self) -> bool
    = extern self.IsSecuritySafeCritical

  public function security_transparent?(self) -> bool
    = extern self.IsSecurityTransparent

  public function serializable?(self) -> bool
    = extern self.IsSerializable

  public function special_name?(self) -> bool
    = extern self.IsSpecialName

  public function unicode_class?(self) -> bool
    = extern self.IsUnicodeClass

  public function value_type?(self) -> bool
    = extern self.IsValueType

  public function visible?(self) -> bool
    = extern self.IsVisible

  public function namespace(self) -> string
    = extern self.Namespace

  public function reflected_type(self) -> Self
    = extern self.ReflectedType

  public function underlying_system_type(self) -> Self
    = extern self.UnderlyingSystemType
}
