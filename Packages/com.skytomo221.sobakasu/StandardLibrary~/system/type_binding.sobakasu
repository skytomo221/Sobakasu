pub type Type = extern System.Type;

impl Type {
  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn get_type(type_name: string) -> Self
    = extern System.Type.GetType(type_name)

  pub fn get_type(type_name: string, throw_on_error: bool) -> Self
    = extern System.Type.GetType(type_name, throw_on_error)

  pub fn get_type(type_name: string, throw_on_error: bool, ignore_case: bool) -> Self
    = extern System.Type.GetType(type_name, throw_on_error, ignore_case)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn ==(self, rhs: Self) -> bool
    = extern self == rhs

  pub fn !=(self, rhs: Self) -> bool
    = extern self != rhs

  pub fn equals(self, o: object) -> bool
    = extern self.Equals(o)

  pub fn equals(self, o: Self) -> bool
    = extern self.Equals(o)

  pub fn get_array_rank(self) -> i32
    = extern self.GetArrayRank()

  pub fn get_element_type(self) -> Self
    = extern self.GetElementType()

  pub fn get_enum_names(self) -> [string]
    = extern self.GetEnumNames()

  pub fn get_enum_name(self, value: object) -> string
    = extern self.GetEnumName(value)

  pub fn get_enum_underlying_type(self) -> Self
    = extern self.GetEnumUnderlyingType()

  pub fn get_enum_values(self) -> System::Array
    = extern self.GetEnumValues()

  pub fn get_generic_type_definition(self) -> Self
    = extern self.GetGenericTypeDefinition()

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_nested_type(self, name: string) -> Self
    = extern self.GetNestedType(name)

  pub fn assignable_from?(self, c: Self) -> bool
    = extern self.IsAssignableFrom(c)

  pub fn enum_defined?(self, value: object) -> bool
    = extern self.IsEnumDefined(value)

  pub fn equivalent_to?(self, other: Self) -> bool
    = extern self.IsEquivalentTo(other)

  pub fn instance_of_type?(self, o: object) -> bool
    = extern self.IsInstanceOfType(o)

  pub fn subclass_of?(self, c: Self) -> bool
    = extern self.IsSubclassOf(c)

  pub fn make_array_type(self) -> Self
    = extern self.MakeArrayType()

  pub fn make_array_type(self, rank: i32) -> Self
    = extern self.MakeArrayType(rank)

  pub fn make_by_ref_type(self) -> Self
    = extern self.MakeByRefType()

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn base_type(self) -> Self
    = extern self.BaseType

  pub fn contains_generic_parameters(self) -> bool
    = extern self.ContainsGenericParameters

  pub fn declaring_type(self) -> Self
    = extern self.DeclaringType

  pub fn full_name(self) -> string
    = extern self.FullName

  pub fn guid(self) -> System::Guid
    = extern self.GUID

  pub fn generic_parameter_position(self) -> i32
    = extern self.GenericParameterPosition

  pub fn has_element_type(self) -> bool
    = extern self.HasElementType

  pub fn abstract?(self) -> bool
    = extern self.IsAbstract

  pub fn ansi_class?(self) -> bool
    = extern self.IsAnsiClass

  pub fn array?(self) -> bool
    = extern self.IsArray

  pub fn auto_class?(self) -> bool
    = extern self.IsAutoClass

  pub fn auto_layout?(self) -> bool
    = extern self.IsAutoLayout

  pub fn by_ref?(self) -> bool
    = extern self.IsByRef

  pub fn com_object?(self) -> bool
    = extern self.IsCOMObject

  pub fn class?(self) -> bool
    = extern self.IsClass

  pub fn constructed_generic_type?(self) -> bool
    = extern self.IsConstructedGenericType

  pub fn contextful?(self) -> bool
    = extern self.IsContextful

  pub fn `enum`?(self) -> bool
    = extern self.IsEnum

  pub fn explicit_layout?(self) -> bool
    = extern self.IsExplicitLayout

  pub fn generic_parameter?(self) -> bool
    = extern self.IsGenericParameter

  pub fn generic_type_definition?(self) -> bool
    = extern self.IsGenericTypeDefinition

  pub fn generic_type?(self) -> bool
    = extern self.IsGenericType

  pub fn import?(self) -> bool
    = extern self.IsImport

  pub fn interface?(self) -> bool
    = extern self.IsInterface

  pub fn layout_sequential?(self) -> bool
    = extern self.IsLayoutSequential

  pub fn marshal_by_ref?(self) -> bool
    = extern self.IsMarshalByRef

  pub fn nested_assembly?(self) -> bool
    = extern self.IsNestedAssembly

  pub fn nested_fam_and_assem?(self) -> bool
    = extern self.IsNestedFamANDAssem

  pub fn nested_fam_or_assem?(self) -> bool
    = extern self.IsNestedFamORAssem

  pub fn nested_family?(self) -> bool
    = extern self.IsNestedFamily

  pub fn nested_private?(self) -> bool
    = extern self.IsNestedPrivate

  pub fn nested_public?(self) -> bool
    = extern self.IsNestedPublic

  pub fn nested?(self) -> bool
    = extern self.IsNested

  pub fn not_public?(self) -> bool
    = extern self.IsNotPublic

  pub fn pointer?(self) -> bool
    = extern self.IsPointer

  pub fn primitive?(self) -> bool
    = extern self.IsPrimitive

  pub fn public?(self) -> bool
    = extern self.IsPublic

  pub fn sz_array?(self) -> bool
    = extern self.IsSZArray

  pub fn sealed?(self) -> bool
    = extern self.IsSealed

  pub fn security_critical?(self) -> bool
    = extern self.IsSecurityCritical

  pub fn security_safe_critical?(self) -> bool
    = extern self.IsSecuritySafeCritical

  pub fn security_transparent?(self) -> bool
    = extern self.IsSecurityTransparent

  pub fn serializable?(self) -> bool
    = extern self.IsSerializable

  pub fn special_name?(self) -> bool
    = extern self.IsSpecialName

  pub fn unicode_class?(self) -> bool
    = extern self.IsUnicodeClass

  pub fn value_type?(self) -> bool
    = extern self.IsValueType

  pub fn visible?(self) -> bool
    = extern self.IsVisible

  pub fn namespace(self) -> string
    = extern self.Namespace

  pub fn reflected_type(self) -> Self
    = extern self.ReflectedType

  pub fn underlying_system_type(self) -> Self
    = extern self.UnderlyingSystemType
}
