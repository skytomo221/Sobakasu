pub type Encoding = extern System.Text.Encoding;

impl Encoding {
  pub fn convert(src_encoding: Self, dst_encoding: Self, bytes: [u8]) -> [u8]
    = extern System.Text.Encoding.Convert(src_encoding, dst_encoding, bytes)

  pub fn convert(src_encoding: Self, dst_encoding: Self, bytes: [u8], index: i32, count: i32) -> [u8]
    = extern System.Text.Encoding.Convert(src_encoding, dst_encoding, bytes, index, count)

  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn equals(self, value: object) -> bool
    = extern self.Equals(value)

  pub fn get_byte_count(self, chars: [char]) -> i32
    = extern self.GetByteCount(chars)

  pub fn get_byte_count(self, chars: [char], index: i32, count: i32) -> i32
    = extern self.GetByteCount(chars, index, count)

  pub fn get_byte_count(self, s: string) -> i32
    = extern self.GetByteCount(s)

  pub fn get_byte_count(self, str: string, index: i32, count: i32) -> i32
    = extern self.GetByteCount(str, index, count)

  pub fn get_bytes(self, chars: [char]) -> [u8]
    = extern self.GetBytes(chars)

  pub fn get_bytes(self, chars: [char], index: i32, count: i32) -> [u8]
    = extern self.GetBytes(chars, index, count)

  pub fn get_bytes(self, s: string) -> [u8]
    = extern self.GetBytes(s)

  pub fn get_bytes(self, s: string, index: i32, count: i32) -> [u8]
    = extern self.GetBytes(s, index, count)

  pub fn get_bytes(self, chars: [char], char_index: i32, char_count: i32, bytes: [u8], byte_index: i32) -> i32
    = extern self.GetBytes(chars, char_index, char_count, bytes, byte_index)

  pub fn get_bytes(self, s: string, char_index: i32, char_count: i32, bytes: [u8], byte_index: i32) -> i32
    = extern self.GetBytes(s, char_index, char_count, bytes, byte_index)

  pub fn get_char_count(self, bytes: [u8]) -> i32
    = extern self.GetCharCount(bytes)

  pub fn get_char_count(self, bytes: [u8], index: i32, count: i32) -> i32
    = extern self.GetCharCount(bytes, index, count)

  pub fn get_chars(self, bytes: [u8]) -> [char]
    = extern self.GetChars(bytes)

  pub fn get_chars(self, bytes: [u8], index: i32, count: i32) -> [char]
    = extern self.GetChars(bytes, index, count)

  pub fn get_chars(self, bytes: [u8], byte_index: i32, byte_count: i32, chars: [char], char_index: i32) -> i32
    = extern self.GetChars(bytes, byte_index, byte_count, chars, char_index)

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_max_byte_count(self, char_count: i32) -> i32
    = extern self.GetMaxByteCount(char_count)

  pub fn get_max_char_count(self, byte_count: i32) -> i32
    = extern self.GetMaxCharCount(byte_count)

  pub fn get_preamble(self) -> [u8]
    = extern self.GetPreamble()

  pub fn get_string(self, bytes: [u8]) -> string
    = extern self.GetString(bytes)

  pub fn get_string(self, bytes: [u8], index: i32, count: i32) -> string
    = extern self.GetString(bytes, index, count)

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn always_normalized?(self) -> bool
    = extern self.IsAlwaysNormalized()

  pub fn always_normalized?(self, form: System::Text::NormalizationForm) -> bool
    = extern self.IsAlwaysNormalized(form)

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn ascii -> Self
    = extern System.Text.Encoding.ASCII

  pub fn big_endian_unicode -> Self
    = extern System.Text.Encoding.BigEndianUnicode

  pub fn body_name(self) -> string
    = extern self.BodyName

  pub fn encoding_name(self) -> string
    = extern self.EncodingName

  pub fn header_name(self) -> string
    = extern self.HeaderName

  pub fn read_only?(self) -> bool
    = extern self.IsReadOnly

  pub fn single_byte?(self) -> bool
    = extern self.IsSingleByte

  pub fn utf32 -> Self
    = extern System.Text.Encoding.UTF32

  pub fn utf8 -> Self
    = extern System.Text.Encoding.UTF8

  pub fn unicode -> Self
    = extern System.Text.Encoding.Unicode

  pub fn web_name(self) -> string
    = extern self.WebName
}
