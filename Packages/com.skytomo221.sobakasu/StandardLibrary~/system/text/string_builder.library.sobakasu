    = maybe extern self.AppendFormat(format, arg0, arg1)

  public function append_format(self, format: string, arg0: object, arg1: object, arg2: object) -> Maybe<Self>
    = maybe extern self.AppendFormat(format, arg0, arg1, arg2)

  public function append_line(self) -> Maybe<Self>
