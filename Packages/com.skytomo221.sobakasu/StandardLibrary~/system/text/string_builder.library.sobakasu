use maybe::Maybe;

public type StringBuilder = extern System.Text.StringBuilder;

implementation StringBuilder {
  public function new() -> Self
    = extern new Self()

  public function new(capacity: i32) -> Self
    = extern new Self(capacity)

  public function new(capacity: i32, max_capacity: i32) -> Self
    = extern new Self(capacity, max_capacity)

  public function new(value: string) -> Self
    = extern new Self(value)

