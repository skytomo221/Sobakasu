    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function append_format(self, provider: System::IFormatProvider, format: string, arg0: object) -> Maybe<Self>
    = maybe extern self.AppendFormat(provider, format, arg0)

  public function append_format(self, provider: System::IFormatProvider, format: string, arg0: object, arg1: object) -> Maybe<Self>
    = maybe extern self.AppendFormat(provider, format, arg0, arg1)

