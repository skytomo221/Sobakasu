    = maybe extern self.Append(value)

  public function append(self, value: [char], start_index: i32, char_count: i32) -> Maybe<Self>
    = maybe extern self.Append(value, start_index, char_count)

  public function append(self, value: System::Decimal) -> Maybe<Self>
    = maybe extern self.Append(value)

  public function append(self, value: f64) -> Maybe<Self>
    = maybe extern self.Append(value)

  public function append(self, value: i16) -> Maybe<Self>
    = maybe extern self.Append(value)

  public function append(self, value: i32) -> Maybe<Self>
    = maybe extern self.Append(value)

  public function append(self, value: i64) -> Maybe<Self>
    = maybe extern self.Append(value)

  public function append(self, value: object) -> Maybe<Self>
    = maybe extern self.Append(value)

  public function append(self, value: i8) -> Maybe<Self>
    = maybe extern self.Append(value)

  public function append(self, value: f32) -> Maybe<Self>
    = maybe extern self.Append(value)

  public function append(self, value: string) -> Maybe<Self>
    = maybe extern self.Append(value)

  public function append(self, value: string, start_index: i32, count: i32) -> Maybe<Self>
    = maybe extern self.Append(value, start_index, count)

  public function append(self, value: Self) -> Maybe<Self>
    = maybe extern self.Append(value)

  public function append(self, value: Self, start_index: i32, count: i32) -> Maybe<Self>
    = maybe extern self.Append(value, start_index, count)

  public function append(self, value: u16) -> Maybe<Self>
    = maybe extern self.Append(value)

  public function append(self, value: u32) -> Maybe<Self>
    = maybe extern self.Append(value)

  public function append(self, value: u64) -> Maybe<Self>
    = maybe extern self.Append(value)

  public function clear(self) -> Maybe<Self>
    = maybe extern self.Clear()

  public function copy_to(self, source_index: i32, destination: [char], destination_index: i32, count: i32)
    = extern self.CopyTo(source_index, destination, destination_index, count)

  public function ensure_capacity(self, capacity: i32) -> i32
    = extern self.EnsureCapacity(capacity)

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function equals(self, sb: Self) -> bool
    = extern self.Equals(sb)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> Maybe<System::Type>
    = maybe extern self.GetType()

