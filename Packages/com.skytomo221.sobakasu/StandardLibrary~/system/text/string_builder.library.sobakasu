  public function append_line(self, value: string) -> Maybe<Self>
    = maybe extern self.AppendLine(value)

  public function append(self, value: bool) -> Maybe<Self>
    = maybe extern self.Append(value)

  public function append(self, value: u8) -> Maybe<Self>
    = maybe extern self.Append(value)

  public function append(self, value: char) -> Maybe<Self>
    = maybe extern self.Append(value)

