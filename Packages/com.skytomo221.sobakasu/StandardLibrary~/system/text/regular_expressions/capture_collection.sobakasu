pub type CaptureCollection = extern System.Text.RegularExpressions.CaptureCollection;

impl CaptureCollection {
  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn copy_to(self, array: System::Array, array_index: i32)
    = extern self.CopyTo(array, array_index)

  pub fn copy_to(self, array: [System::Text::RegularExpressions::Capture], array_index: i32)
    = extern self.CopyTo(array, array_index)

  pub fn equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  pub fn get_enumerator(self) -> System::Collections::IEnumerator
    = extern self.GetEnumerator()

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn count(self) -> i32
    = extern self.Count

  pub fn read_only?(self) -> bool
    = extern self.IsReadOnly

  pub fn synchronized?(self) -> bool
    = extern self.IsSynchronized

  pub fn sync_root(self) -> object
    = extern self.SyncRoot
}
