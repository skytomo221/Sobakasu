    = extern System.Text.RegularExpressions.Regex.Split(input, pattern)

  public function split(input: string, pattern: string, options: System::Text::RegularExpressions::RegexOptions) -> [string]
    = extern System.Text.RegularExpressions.Regex.Split(input, pattern, options)

  public function split(input: string, pattern: string, options: System::Text::RegularExpressions::RegexOptions, match_timeout: System::TimeSpan) -> [string]
    = extern System.Text.RegularExpressions.Regex.Split(input, pattern, options, match_timeout)

  public function unescape(str: string) -> string
    = extern System.Text.RegularExpressions.Regex.Unescape(str)

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_group_names(self) -> [string]
    = extern self.GetGroupNames()

  public function get_group_numbers(self) -> [i32]
    = extern self.GetGroupNumbers()

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

