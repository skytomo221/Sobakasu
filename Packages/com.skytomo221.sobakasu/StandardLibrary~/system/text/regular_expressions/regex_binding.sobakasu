  public function matches(input: string, pattern: string, options: System::Text::RegularExpressions::RegexOptions) -> System::Text::RegularExpressions::MatchCollection
    = extern System.Text.RegularExpressions.Regex.Matches(input, pattern, options)

  public function matches(input: string, pattern: string, options: System::Text::RegularExpressions::RegexOptions, match_timeout: System::TimeSpan) -> System::Text::RegularExpressions::MatchCollection
    = extern System.Text.RegularExpressions.Regex.Matches(input, pattern, options, match_timeout)

  public function `match`(input: string, pattern: string) -> System::Text::RegularExpressions::Match
    = extern System.Text.RegularExpressions.Regex.Match(input, pattern)

  public function `match`(input: string, pattern: string, options: System::Text::RegularExpressions::RegexOptions) -> System::Text::RegularExpressions::Match
    = extern System.Text.RegularExpressions.Regex.Match(input, pattern, options)

  public function `match`(input: string, pattern: string, options: System::Text::RegularExpressions::RegexOptions, match_timeout: System::TimeSpan) -> System::Text::RegularExpressions::Match
    = extern System.Text.RegularExpressions.Regex.Match(input, pattern, options, match_timeout)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

