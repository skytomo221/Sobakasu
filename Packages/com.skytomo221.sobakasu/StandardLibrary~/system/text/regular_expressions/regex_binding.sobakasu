    = extern System.Text.RegularExpressions.Regex.Replace(input, pattern, replacement)

  public function replace(input: string, pattern: string, replacement: string, options: System::Text::RegularExpressions::RegexOptions) -> string
    = extern System.Text.RegularExpressions.Regex.Replace(input, pattern, replacement, options)

  public function replace(input: string, pattern: string, replacement: string, options: System::Text::RegularExpressions::RegexOptions, match_timeout: System::TimeSpan) -> string
    = extern System.Text.RegularExpressions.Regex.Replace(input, pattern, replacement, options, match_timeout)

