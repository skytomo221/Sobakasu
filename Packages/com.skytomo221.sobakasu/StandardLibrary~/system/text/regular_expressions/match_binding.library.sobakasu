use maybe::Maybe;

public type Match = extern System.Text.RegularExpressions.Match;

implementation Match {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function synchronized(inner: System::Text::RegularExpressions::Group) -> Maybe<System::Text::RegularExpressions::Group>
    = maybe extern System.Text.RegularExpressions.Group.Synchronized(inner)

  public function synchronized(inner: Self) -> Maybe<Self>
    = maybe extern System.Text.RegularExpressions.Match.Synchronized(inner)

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function next_match(self) -> Maybe<Self>
    = maybe extern self.NextMatch()

  public function result(self, replacement: string) -> Maybe<string>
    = maybe extern self.Result(replacement)

  public function to_string(self) -> Maybe<string>
    = maybe extern self.ToString()

  public function captures(self) -> Maybe<System::Text::RegularExpressions::CaptureCollection>
    = maybe extern self.Captures

  public function empty -> Maybe<Self>
    = maybe extern System.Text.RegularExpressions.Match.Empty

  public function groups(self) -> Maybe<System::Text::RegularExpressions::GroupCollection>
    = maybe extern self.Groups

  public function index(self) -> i32
    = extern self.Index

  public function length(self) -> i32
    = extern self.Length

  public function name(self) -> Maybe<string>
    = maybe extern self.Name

  public function success(self) -> bool
    = extern self.Success

  public function value(self) -> Maybe<string>
    = maybe extern self.Value
}
