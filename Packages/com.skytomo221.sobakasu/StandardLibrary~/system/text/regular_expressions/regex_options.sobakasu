pub impl RegexOptions = extern System.Text.RegularExpressions.RegexOptions {
  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub static fn compiled -> Self
    = extern Self.Compiled

  pub static fn culture_invariant -> Self
    = extern Self.CultureInvariant

  pub static fn ecma_script -> Self
    = extern Self.ECMAScript

  pub static fn explicit_capture -> Self
    = extern Self.ExplicitCapture

  pub static fn ignore_case -> Self
    = extern Self.IgnoreCase

  pub static fn ignore_pattern_whitespace -> Self
    = extern Self.IgnorePatternWhitespace

  pub static fn multiline -> Self
    = extern Self.Multiline

  pub static fn none -> Self
    = extern Self.None

  pub static fn right_to_left -> Self
    = extern Self.RightToLeft

  pub static fn singleline -> Self
    = extern Self.Singleline
}
