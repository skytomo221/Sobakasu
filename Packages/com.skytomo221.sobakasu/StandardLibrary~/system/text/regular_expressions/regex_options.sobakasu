pub enum RegexOptions = extern System.Text.RegularExpressions.RegexOptions {
  None = extern None,
  IgnoreCase = extern IgnoreCase,
  Multiline = extern Multiline,
  ExplicitCapture = extern ExplicitCapture,
  Compiled = extern Compiled,
  Singleline = extern Singleline,
  IgnorePatternWhitespace = extern IgnorePatternWhitespace,
  RightToLeft = extern RightToLeft,
  ECMAScript = extern ECMAScript,
  CultureInvariant = extern CultureInvariant,
}
