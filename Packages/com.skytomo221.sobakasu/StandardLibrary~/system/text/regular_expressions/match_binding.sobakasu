public type Match = extern System.Text.RegularExpressions.Match;

implementation Match {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function synchronized(inner: System::Text::RegularExpressions::Group) -> System::Text::RegularExpressions::Group
    = extern System.Text.RegularExpressions.Group.Synchronized(inner)

  public function synchronized(inner: Self) -> Self
    = extern System.Text.RegularExpressions.Match.Synchronized(inner)

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function next_match(self) -> Self
    = extern self.NextMatch()

  public function result(self, replacement: string) -> string
    = extern self.Result(replacement)

  public function to_string(self) -> string
    = extern self.ToString()

  public function captures(self) -> System::Text::RegularExpressions::CaptureCollection
    = extern self.Captures

  public function empty -> Self
    = extern System.Text.RegularExpressions.Match.Empty

  public function groups(self) -> System::Text::RegularExpressions::GroupCollection
    = extern self.Groups

  public function index(self) -> i32
    = extern self.Index

  public function length(self) -> i32
    = extern self.Length

  public function name(self) -> string
    = extern self.Name

  public function success(self) -> bool
    = extern self.Success

  public function value(self) -> string
    = extern self.Value
}
