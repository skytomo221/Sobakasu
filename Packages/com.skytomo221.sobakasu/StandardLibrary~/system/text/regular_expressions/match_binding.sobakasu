pub type Match = extern System.Text.RegularExpressions.Match;

impl Match {
  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn synchronized(inner: System::Text::RegularExpressions::Group) -> System::Text::RegularExpressions::Group
    = extern System.Text.RegularExpressions.Group.Synchronized(inner)

  pub fn synchronized(inner: Self) -> Self
    = extern System.Text.RegularExpressions.Match.Synchronized(inner)

  pub fn equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn next_match(self) -> Self
    = extern self.NextMatch()

  pub fn result(self, replacement: string) -> string
    = extern self.Result(replacement)

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn captures(self) -> System::Text::RegularExpressions::CaptureCollection
    = extern self.Captures

  pub fn empty -> Self
    = extern System.Text.RegularExpressions.Match.Empty

  pub fn groups(self) -> System::Text::RegularExpressions::GroupCollection
    = extern self.Groups

  pub fn index(self) -> i32
    = extern self.Index

  pub fn length(self) -> i32
    = extern self.Length

  pub fn name(self) -> string
    = extern self.Name

  pub fn success(self) -> bool
    = extern self.Success

  pub fn value(self) -> string
    = extern self.Value
}
