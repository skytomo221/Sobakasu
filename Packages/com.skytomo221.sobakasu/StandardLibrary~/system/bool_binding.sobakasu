public implementation bool = extern System.Boolean {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function parse(value: string) -> bool
    = extern System.Boolean.Parse(value)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function try_parse(value: string) -> (bool, bool)
    = extern System.Boolean.TryParse(string value, out bool result)

  public function compare_to(self, value: bool) -> i32
    = extern self.CompareTo(value)

  public function compare_to(self, obj: object) -> i32
    = extern self.CompareTo(obj)

  public function equals(self, obj: bool) -> bool
    = extern self.Equals(obj)

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function to_string(self) -> string
    = extern self.ToString()

  public function to_string(self, provider: System::IFormatProvider) -> string
    = extern self.ToString(provider)

  public function false_string -> string
    = extern System.Boolean.FalseString

  public function true_string -> string
    = extern System.Boolean.TrueString
}
