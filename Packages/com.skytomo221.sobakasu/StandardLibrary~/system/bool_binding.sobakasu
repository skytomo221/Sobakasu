pub impl bool = extern System.Boolean {
  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn parse(value: string) -> bool
    = extern System.Boolean.Parse(value)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn try_parse(value: string) -> (bool, bool)
    = extern System.Boolean.TryParse(string value, out bool result)

  pub fn compare_to(self, value: bool) -> i32
    = extern self.CompareTo(value)

  pub fn compare_to(self, obj: object) -> i32
    = extern self.CompareTo(obj)

  pub fn equals(self, obj: bool) -> bool
    = extern self.Equals(obj)

  pub fn equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn to_string(self, provider: System::IFormatProvider) -> string
    = extern self.ToString(provider)

  pub fn false_string -> string
    = extern System.Boolean.FalseString

  pub fn true_string -> string
    = extern System.Boolean.TrueString
}
