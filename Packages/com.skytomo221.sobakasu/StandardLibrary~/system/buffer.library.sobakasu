public function block_copy(src: System::Array, src_offset: i32, dst: System::Array, dst_offset: i32, count: i32)
  = extern System.Buffer.BlockCopy(src, src_offset, dst, dst_offset, count)

public function byte_length(array: System::Array) -> i32
  = extern System.Buffer.ByteLength(array)

public function equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.Equals(obj_a, obj_b)

public function get_byte(array: System::Array, index: i32) -> u8
  = extern System.Buffer.GetByte(array, index)

public function reference_equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.ReferenceEquals(obj_a, obj_b)

public function set_byte(array: System::Array, index: i32, value: u8)
  = extern System.Buffer.SetByte(array, index, value)
