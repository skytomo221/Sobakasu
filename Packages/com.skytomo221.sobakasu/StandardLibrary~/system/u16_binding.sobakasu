lang "u16"
pub impl u16 = extern System.UInt16 {
  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn parse(s: string) -> u16
    = extern System.UInt16.Parse(s)

  pub static fn parse(s: string, style: System.Globalization.NumberStyles) -> u16
    = extern System.UInt16.Parse(s, style)

  pub static fn parse(s: string, style: System.Globalization.NumberStyles, provider: System.IFormatProvider) -> u16
    = extern System.UInt16.Parse(s, style, provider)

  pub static fn parse(s: string, provider: System.IFormatProvider) -> u16
    = extern System.UInt16.Parse(s, provider)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub static fn try_parse(s: string, style: System.Globalization.NumberStyles, provider: System.IFormatProvider) -> (bool, u16)
    = extern System.UInt16.TryParse(string s, System.Globalization.NumberStyles style, System.IFormatProvider provider, out u16 result)

  pub static fn try_parse(s: string) -> (bool, u16)
    = extern System.UInt16.TryParse(string s, out u16 result)

  pub fn compare_to(value: object) -> i32
    = extern self.CompareTo(value)

  pub fn compare_to(value: u16) -> i32
    = extern self.CompareTo(value)

  pub fn equals(obj: object) -> bool
    = extern self.Equals(obj)

  pub fn equals(obj: u16) -> bool
    = extern self.Equals(obj)

  pub fn get_hash_code() -> i32
    = extern self.GetHashCode()

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn to_string() -> string
    = extern self.ToString()

  pub fn to_string(provider: System.IFormatProvider) -> string
    = extern self.ToString(provider)

  pub fn to_string(format: string) -> string
    = extern self.ToString(format)

  pub fn to_string(format: string, provider: System.IFormatProvider) -> string
    = extern self.ToString(format, provider)

  pub static fn max_value -> u16
    = extern Self.MaxValue

  pub static fn min_value -> u16
    = extern Self.MinValue
}
