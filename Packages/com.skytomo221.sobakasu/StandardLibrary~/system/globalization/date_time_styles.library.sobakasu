use maybe::Maybe;

public enum DateTimeStyles = extern System.Globalization.DateTimeStyles {
  AdjustToUniversal = extern AdjustToUniversal,
  AllowInnerWhite = extern AllowInnerWhite,
  AllowLeadingWhite = extern AllowLeadingWhite,
  AllowTrailingWhite = extern AllowTrailingWhite,
  AllowWhiteSpaces = extern AllowWhiteSpaces,
  AssumeLocal = extern AssumeLocal,
  AssumeUniversal = extern AssumeUniversal,
  NoCurrentDateDefault = extern NoCurrentDateDefault,
  None = extern None,
  RoundtripKind = extern RoundtripKind,
}
