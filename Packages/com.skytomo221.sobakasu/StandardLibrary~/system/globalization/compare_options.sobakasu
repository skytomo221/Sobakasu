pub enum CompareOptions = extern System.Globalization.CompareOptions {
  None = extern None,
  IgnoreCase = extern IgnoreCase,
  IgnoreNonSpace = extern IgnoreNonSpace,
  IgnoreSymbols = extern IgnoreSymbols,
  IgnoreKanaType = extern IgnoreKanaType,
  IgnoreWidth = extern IgnoreWidth,
  OrdinalIgnoreCase = extern OrdinalIgnoreCase,
  StringSort = extern StringSort,
  Ordinal = extern Ordinal,
}
