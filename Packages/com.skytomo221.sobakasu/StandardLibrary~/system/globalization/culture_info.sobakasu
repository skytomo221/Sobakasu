public type CultureInfo = extern System.Globalization.CultureInfo;

implementation CultureInfo {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function get_culture_info(culture: i32) -> Self
    = extern System.Globalization.CultureInfo.GetCultureInfo(culture)

  public function get_culture_info(name: string) -> Self
    = extern System.Globalization.CultureInfo.GetCultureInfo(name)

  public function get_culture_info(name: string, alt_name: string) -> Self
    = extern System.Globalization.CultureInfo.GetCultureInfo(name, alt_name)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(self, value: object) -> bool
    = extern self.Equals(value)

  public function get_format(self, format_type: System::Type) -> object
    = extern self.GetFormat(format_type)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function to_string(self) -> string
    = extern self.ToString()

  public function current_culture -> Self
    = extern System.Globalization.CultureInfo.CurrentCulture

  public function current_ui_culture -> Self
    = extern System.Globalization.CultureInfo.CurrentUICulture

  public function date_time_format(self) -> System::Globalization::DateTimeFormatInfo
    = extern self.DateTimeFormat

  public function display_name(self) -> string
    = extern self.DisplayName

  public function english_name(self) -> string
    = extern self.EnglishName

  public function invariant_culture -> Self
    = extern System.Globalization.CultureInfo.InvariantCulture

  public function number_format(self) -> System::Globalization::NumberFormatInfo
    = extern self.NumberFormat

  public function three_letter_iso_language_name(self) -> string
    = extern self.ThreeLetterISOLanguageName

  public function two_letter_iso_language_name(self) -> string
    = extern self.TwoLetterISOLanguageName

  public function set_current_ui_culture(value: Self)
    = extern System.Globalization.CultureInfo.CurrentUICulture = value
}
