use maybe::Maybe;

public enum NumberStyles = extern System.Globalization.NumberStyles {
  AllowCurrencySymbol = extern AllowCurrencySymbol,
  AllowDecimalPoint = extern AllowDecimalPoint,
  AllowExponent = extern AllowExponent,
  AllowHexSpecifier = extern AllowHexSpecifier,
  AllowLeadingSign = extern AllowLeadingSign,
  AllowLeadingWhite = extern AllowLeadingWhite,
  AllowParentheses = extern AllowParentheses,
  AllowThousands = extern AllowThousands,
  AllowTrailingSign = extern AllowTrailingSign,
  AllowTrailingWhite = extern AllowTrailingWhite,
  Any = extern Any,
  Currency = extern Currency,
  Float = extern Float,
  HexNumber = extern HexNumber,
  Integer = extern Integer,
  None = extern None,
  Number = extern Number,
}
