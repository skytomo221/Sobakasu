use maybe::Maybe;

public enum UnicodeCategory = extern System.Globalization.UnicodeCategory {
  ClosePunctuation = extern ClosePunctuation,
  ConnectorPunctuation = extern ConnectorPunctuation,
  Control = extern Control,
  CurrencySymbol = extern CurrencySymbol,
  DashPunctuation = extern DashPunctuation,
  DecimalDigitNumber = extern DecimalDigitNumber,
  EnclosingMark = extern EnclosingMark,
  FinalQuotePunctuation = extern FinalQuotePunctuation,
  Format = extern Format,
  InitialQuotePunctuation = extern InitialQuotePunctuation,
  LetterNumber = extern LetterNumber,
  LineSeparator = extern LineSeparator,
  LowercaseLetter = extern LowercaseLetter,
  MathSymbol = extern MathSymbol,
  ModifierLetter = extern ModifierLetter,
  ModifierSymbol = extern ModifierSymbol,
  NonSpacingMark = extern NonSpacingMark,
  OpenPunctuation = extern OpenPunctuation,
  OtherLetter = extern OtherLetter,
  OtherNotAssigned = extern OtherNotAssigned,
  OtherNumber = extern OtherNumber,
  OtherPunctuation = extern OtherPunctuation,
  OtherSymbol = extern OtherSymbol,
  ParagraphSeparator = extern ParagraphSeparator,
  PrivateUse = extern PrivateUse,
  SpaceSeparator = extern SpaceSeparator,
  SpacingCombiningMark = extern SpacingCombiningMark,
  Surrogate = extern Surrogate,
  TitlecaseLetter = extern TitlecaseLetter,
  UppercaseLetter = extern UppercaseLetter,
}
