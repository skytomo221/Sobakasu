public type Random = extern System.Random;

implementation Random {
  public function new() -> Self
    = extern new Self()

  public function new(seed: i32) -> Self
    = extern new Self(seed)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function next_bytes(self, buffer: [u8])
    = extern self.NextBytes(buffer)

  public function next_double(self) -> f64
    = extern self.NextDouble()

  public function next(self) -> i32
    = extern self.Next()

  public function next(self, max_value: i32) -> i32
    = extern self.Next(max_value)

  public function next(self, min_value: i32, max_value: i32) -> i32
    = extern self.Next(min_value, max_value)

  public function to_string(self) -> string
    = extern self.ToString()
}
