public struct Guid = extern System.Guid {
}

implementation Guid {
  public function new(b: [u8]) -> Self
    = extern new Self(b)

  public function new(a: i32, b: i16, c: i16, d: u8, e: u8, f: u8, g: u8, h: u8, i: u8, j: u8, k: u8) -> Self
    = extern new Self(a, b, c, d, e, f, g, h, i, j, k)

  public function new(a: i32, b: i16, c: i16, d: [u8]) -> Self
    = extern new Self(a, b, c, d)

  public function new(g: string) -> Self
    = extern new Self(g)

  public function new(a: u32, b: u16, c: u16, d: u8, e: u8, f: u8, g: u8, h: u8, i: u8, j: u8, k: u8) -> Self
    = extern new Self(a, b, c, d, e, f, g, h, i, j, k)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function new_guid() -> Self
    = extern System.Guid.NewGuid()

  public function parse_exact(input: string, format: string) -> Self
    = extern System.Guid.ParseExact(input, format)

  public function parse(input: string) -> Self
    = extern System.Guid.Parse(input)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function try_parse_exact(input: string, format: string) -> (bool, Self)
    = extern System.Guid.TryParseExact(string input, string format, out Self result)

  public function try_parse(input: string) -> (bool, Self)
    = extern System.Guid.TryParse(string input, out Self result)

  public function ==(self, rhs: Self) -> bool
    = extern self == rhs

  public function !=(self, rhs: Self) -> bool
    = extern self != rhs

  public function compare_to(self, value: Self) -> i32
    = extern self.CompareTo(value)

  public function compare_to(self, value: object) -> i32
    = extern self.CompareTo(value)

  public function equals(self, g: Self) -> bool
    = extern self.Equals(g)

  public function equals(self, o: object) -> bool
    = extern self.Equals(o)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function to_byte_array(self) -> [u8]
    = extern self.ToByteArray()

  public function to_string(self) -> string
    = extern self.ToString()

  public function to_string(self, format: string) -> string
    = extern self.ToString(format)

  public function to_string(self, format: string, provider: System::IFormatProvider) -> string
    = extern self.ToString(format, provider)

  public function empty -> Self
    = extern System.Guid.Empty
}
