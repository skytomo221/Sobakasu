    = extern self.AddMinutes(value)

  public function add_months(self, months: i32) -> Self
    = extern self.AddMonths(months)

  public function add_seconds(self, value: f64) -> Self
    = extern self.AddSeconds(value)

  public function add_ticks(self, value: i64) -> Self
    = extern self.AddTicks(value)

  public function add_years(self, value: i32) -> Self
    = extern self.AddYears(value)

  public function add(self, value: System::TimeSpan) -> Self
    = extern self.Add(value)

  public function compare_to(self, value: Self) -> i32
    = extern self.CompareTo(value)

  public function compare_to(self, value: object) -> i32
    = extern self.CompareTo(value)

  public function equals(self, value: Self) -> bool
    = extern self.Equals(value)

  public function equals(self, value: object) -> bool
    = extern self.Equals(value)

