  public function parse_exact(s: string, formats: [string], provider: System::IFormatProvider, style: System::Globalization::DateTimeStyles) -> Self
    = extern System.DateTime.ParseExact(s, formats, provider, style)

  public function parse(s: string) -> Self
    = extern System.DateTime.Parse(s)

  public function parse(s: string, provider: System::IFormatProvider) -> Self
    = extern System.DateTime.Parse(s, provider)

  public function parse(s: string, provider: System::IFormatProvider, styles: System::Globalization::DateTimeStyles) -> Self
    = extern System.DateTime.Parse(s, provider, styles)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function specify_kind(value: Self, kind: System::DateTimeKind) -> Self
    = extern System.DateTime.SpecifyKind(value, kind)

  public function try_parse_exact(s: string, format: string, provider: System::IFormatProvider, style: System::Globalization::DateTimeStyles) -> (bool, Self)
    = extern System.DateTime.TryParseExact(string s, string format, System::IFormatProvider provider, System::Globalization::DateTimeStyles style, out Self result)

  public function try_parse_exact(s: string, formats: [string], provider: System::IFormatProvider, style: System::Globalization::DateTimeStyles) -> (bool, Self)
    = extern System.DateTime.TryParseExact(string s, [string] formats, System::IFormatProvider provider, System::Globalization::DateTimeStyles style, out Self result)

  public function try_parse(s: string, provider: System::IFormatProvider, styles: System::Globalization::DateTimeStyles) -> (bool, Self)
    = extern System.DateTime.TryParse(string s, System::IFormatProvider provider, System::Globalization::DateTimeStyles styles, out Self result)

  public function try_parse(s: string) -> (bool, Self)
    = extern System.DateTime.TryParse(string s, out Self result)

  public function +(self, rhs: System::TimeSpan) -> Self
    = extern self + rhs

  public function ==(self, rhs: Self) -> bool
    = extern self == rhs

  public function >=(self, rhs: Self) -> bool
    = extern self >= rhs

  public function >(self, rhs: Self) -> bool
    = extern self > rhs

  public function !=(self, rhs: Self) -> bool
    = extern self != rhs

