    = extern self.GetDateTimeFormats()

  public function get_date_time_formats(self, format: char) -> [string]
    = extern self.GetDateTimeFormats(format)

  public function get_date_time_formats(self, format: char, provider: System::IFormatProvider) -> [string]
    = extern self.GetDateTimeFormats(format, provider)

