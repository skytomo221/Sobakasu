  public function subtract(self, value: Self) -> System::TimeSpan
    = extern self.Subtract(value)

  public function to_binary(self) -> i64
    = extern self.ToBinary()

  public function to_file_time_utc(self) -> i64
    = extern self.ToFileTimeUtc()

  public function to_file_time(self) -> i64
    = extern self.ToFileTime()

  public function to_local_time(self) -> Self
    = extern self.ToLocalTime()

  public function to_long_date_string(self) -> string
    = extern self.ToLongDateString()

  public function to_long_time_string(self) -> string
    = extern self.ToLongTimeString()

  public function to_oa_date(self) -> f64
    = extern self.ToOADate()

  public function to_short_date_string(self) -> string
    = extern self.ToShortDateString()

  public function to_short_time_string(self) -> string
    = extern self.ToShortTimeString()

  public function to_string(self) -> string
    = extern self.ToString()

  public function to_string(self, provider: System::IFormatProvider) -> string
    = extern self.ToString(provider)

  public function to_string(self, format: string) -> string
    = extern self.ToString(format)

  public function to_string(self, format: string, provider: System::IFormatProvider) -> string
    = extern self.ToString(format, provider)

  public function to_universal_time(self) -> Self
    = extern self.ToUniversalTime()

  public function date(self) -> Self
    = extern self.Date

  public function day_of_week(self) -> System::DayOfWeek
    = extern self.DayOfWeek

  public function day_of_year(self) -> i32
    = extern self.DayOfYear

  public function day(self) -> i32
    = extern self.Day

  public function hour(self) -> i32
    = extern self.Hour

  public function kind(self) -> System::DateTimeKind
    = extern self.Kind

  public function millisecond(self) -> i32
    = extern self.Millisecond

  public function minute(self) -> i32
    = extern self.Minute

  public function month(self) -> i32
    = extern self.Month

  public function now -> Self
    = extern System.DateTime.Now

  public function second(self) -> i32
    = extern self.Second

  public function ticks(self) -> i64
    = extern self.Ticks

  public function time_of_day(self) -> System::TimeSpan
    = extern self.TimeOfDay

  public function today -> Self
    = extern System.DateTime.Today

  public function utc_now -> Self
    = extern System.DateTime.UtcNow

  public function year(self) -> i32
    = extern self.Year

