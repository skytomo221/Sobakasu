public struct DateTime = extern System.DateTime {
}

implementation DateTime {
  public function new(year: i32, month: i32, day: i32) -> Self
    = extern new Self(year, month, day)

  public function new(year: i32, month: i32, day: i32, hour: i32, minute: i32, second: i32) -> Self
    = extern new Self(year, month, day, hour, minute, second)

  public function new(year: i32, month: i32, day: i32, hour: i32, minute: i32, second: i32, kind: System::DateTimeKind) -> Self
    = extern new Self(year, month, day, hour, minute, second, kind)

  public function new(year: i32, month: i32, day: i32, hour: i32, minute: i32, second: i32, millisecond: i32) -> Self
    = extern new Self(year, month, day, hour, minute, second, millisecond)

  public function new(year: i32, month: i32, day: i32, hour: i32, minute: i32, second: i32, millisecond: i32, kind: System::DateTimeKind) -> Self
    = extern new Self(year, month, day, hour, minute, second, millisecond, kind)

  public function new(ticks: i64) -> Self
    = extern new Self(ticks)

