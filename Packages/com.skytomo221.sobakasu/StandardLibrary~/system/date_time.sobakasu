  public function from_file_time(file_time: i64) -> Self
    = extern System.DateTime.FromFileTime(file_time)

  public function from_oa_date(d: f64) -> Self
    = extern System.DateTime.FromOADate(d)

  public function leap_year?(year: i32) -> bool
    = extern System.DateTime.IsLeapYear(year)

  public function parse_exact(s: string, format: string, provider: System::IFormatProvider) -> Self
    = extern System.DateTime.ParseExact(s, format, provider)

  public function parse_exact(s: string, format: string, provider: System::IFormatProvider, style: System::Globalization::DateTimeStyles) -> Self
