pub fn block_copy(src: System.Array, src_offset: i32, dst: System.Array, dst_offset: i32, count: i32)
  = extern System.Buffer.BlockCopy(src, src_offset, dst, dst_offset, count)

pub fn byte_length(array: System.Array) -> i32
  = extern System.Buffer.ByteLength(array)

pub fn get_byte(array: System.Array, index: i32) -> u8
  = extern System.Buffer.GetByte(array, index)

pub fn set_byte(array: System.Array, index: i32, value: u8)
  = extern System.Buffer.SetByte(array, index, value)
