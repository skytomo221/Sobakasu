pub enum StringComparison = extern System.StringComparison {
  CurrentCulture = extern CurrentCulture,
  CurrentCultureIgnoreCase = extern CurrentCultureIgnoreCase,
  InvariantCulture = extern InvariantCulture,
  InvariantCultureIgnoreCase = extern InvariantCultureIgnoreCase,
  Ordinal = extern Ordinal,
  OrdinalIgnoreCase = extern OrdinalIgnoreCase,
}
