pub impl f64 = extern System.Double {
  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn infinity?(d: f64) -> bool
    = extern System.Double.IsInfinity(d)

  pub fn na_n?(d: f64) -> bool
    = extern System.Double.IsNaN(d)

  pub fn negative_infinity?(d: f64) -> bool
    = extern System.Double.IsNegativeInfinity(d)

  pub fn positive_infinity?(d: f64) -> bool
    = extern System.Double.IsPositiveInfinity(d)

  pub fn parse(s: string) -> f64
    = extern System.Double.Parse(s)

  pub fn parse(s: string, style: System::Globalization::NumberStyles) -> f64
    = extern System.Double.Parse(s, style)

  pub fn parse(s: string, style: System::Globalization::NumberStyles, provider: System::IFormatProvider) -> f64
    = extern System.Double.Parse(s, style, provider)

  pub fn parse(s: string, provider: System::IFormatProvider) -> f64
    = extern System.Double.Parse(s, provider)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn try_parse(s: string, style: System::Globalization::NumberStyles, provider: System::IFormatProvider) -> (bool, f64)
    = extern System.Double.TryParse(string s, System::Globalization::NumberStyles style, System::IFormatProvider provider, out f64 result)

  pub fn try_parse(s: string) -> (bool, f64)
    = extern System.Double.TryParse(string s, out f64 result)

  pub fn compare_to(self, value: f64) -> i32
    = extern self.CompareTo(value)

  pub fn compare_to(self, value: object) -> i32
    = extern self.CompareTo(value)

  pub fn equals(self, obj: f64) -> bool
    = extern self.Equals(obj)

  pub fn equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn to_string(self, provider: System::IFormatProvider) -> string
    = extern self.ToString(provider)

  pub fn to_string(self, format: string) -> string
    = extern self.ToString(format)

  pub fn to_string(self, format: string, provider: System::IFormatProvider) -> string
    = extern self.ToString(format, provider)

  pub fn epsilon -> f64
    = extern System.Double.Epsilon

  pub fn max_value -> f64
    = extern System.Double.MaxValue

  pub fn min_value -> f64
    = extern System.Double.MinValue

  pub fn na_n -> f64
    = extern System.Double.NaN

  pub fn negative_infinity -> f64
    = extern System.Double.NegativeInfinity

  pub fn positive_infinity -> f64
    = extern System.Double.PositiveInfinity
}
