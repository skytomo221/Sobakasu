lang "f64"
pub impl f64 = extern System.Double {
  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn infinity?(d: f64) -> bool
    = extern System.Double.IsInfinity(d)

  pub static fn na_n?(d: f64) -> bool
    = extern System.Double.IsNaN(d)

  pub static fn negative_infinity?(d: f64) -> bool
    = extern System.Double.IsNegativeInfinity(d)

  pub static fn positive_infinity?(d: f64) -> bool
    = extern System.Double.IsPositiveInfinity(d)

  pub static fn parse(s: string) -> f64
    = extern System.Double.Parse(s)

  pub static fn parse(s: string, style: System.Globalization.NumberStyles) -> f64
    = extern System.Double.Parse(s, style)

  pub static fn parse(s: string, style: System.Globalization.NumberStyles, provider: System.IFormatProvider) -> f64
    = extern System.Double.Parse(s, style, provider)

  pub static fn parse(s: string, provider: System.IFormatProvider) -> f64
    = extern System.Double.Parse(s, provider)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub static fn try_parse(s: string, style: System.Globalization.NumberStyles, provider: System.IFormatProvider) -> (bool, f64)
    = extern System.Double.TryParse(string s, System.Globalization.NumberStyles style, System.IFormatProvider provider, out f64 result)

  pub static fn try_parse(s: string) -> (bool, f64)
    = extern System.Double.TryParse(string s, out f64 result)

  pub fn compare_to(value: f64) -> i32
    = extern self.CompareTo(value)

  pub fn compare_to(value: object) -> i32
    = extern self.CompareTo(value)

  pub fn equals(obj: f64) -> bool
    = extern self.Equals(obj)

  pub fn equals(obj: object) -> bool
    = extern self.Equals(obj)

  pub fn get_hash_code() -> i32
    = extern self.GetHashCode()

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn to_string() -> string
    = extern self.ToString()

  pub fn to_string(provider: System.IFormatProvider) -> string
    = extern self.ToString(provider)

  pub fn to_string(format: string) -> string
    = extern self.ToString(format)

  pub fn to_string(format: string, provider: System.IFormatProvider) -> string
    = extern self.ToString(format, provider)

  pub static fn epsilon -> f64
    = extern Self.Epsilon

  pub static fn max_value -> f64
    = extern Self.MaxValue

  pub static fn min_value -> f64
    = extern Self.MinValue

  pub static fn na_n -> f64
    = extern Self.NaN

  pub static fn negative_infinity -> f64
    = extern Self.NegativeInfinity

  pub static fn positive_infinity -> f64
    = extern Self.PositiveInfinity
}
