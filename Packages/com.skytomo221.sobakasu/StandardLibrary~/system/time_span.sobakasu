    = extern System.TimeSpan.ParseExact(input, format, format_provider)

  pub static fn parse_exact(input: string, format: string, format_provider: System.IFormatProvider, styles: System.Globalization.TimeSpanStyles) -> Self
    = extern System.TimeSpan.ParseExact(input, format, format_provider, styles)

  pub static fn parse_exact(input: string, formats: [string], format_provider: System.IFormatProvider) -> Self
    = extern System.TimeSpan.ParseExact(input, formats, format_provider)

  pub static fn parse_exact(input: string, formats: [string], format_provider: System.IFormatProvider, styles: System.Globalization.TimeSpanStyles) -> Self
    = extern System.TimeSpan.ParseExact(input, formats, format_provider, styles)

  pub static fn parse(input: string, format_provider: System.IFormatProvider) -> Self
    = extern System.TimeSpan.Parse(input, format_provider)

  pub static fn parse(s: string) -> Self
    = extern System.TimeSpan.Parse(s)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub static fn try_parse_exact(input: string, format: string, format_provider: System.IFormatProvider, styles: System.Globalization.TimeSpanStyles) -> (bool, Self)
    = extern System.TimeSpan.TryParseExact(string input, string format, System.IFormatProvider format_provider, System.Globalization.TimeSpanStyles styles, out Self result)

  pub static fn try_parse_exact(input: string, format: string, format_provider: System.IFormatProvider) -> (bool, Self)
    = extern System.TimeSpan.TryParseExact(string input, string format, System.IFormatProvider format_provider, out Self result)

  pub static fn try_parse_exact(input: string, formats: [string], format_provider: System.IFormatProvider, styles: System.Globalization.TimeSpanStyles) -> (bool, Self)
    = extern System.TimeSpan.TryParseExact(string input, [string] formats, System.IFormatProvider format_provider, System.Globalization.TimeSpanStyles styles, out Self result)

  pub static fn try_parse_exact(input: string, formats: [string], format_provider: System.IFormatProvider) -> (bool, Self)
    = extern System.TimeSpan.TryParseExact(string input, [string] formats, System.IFormatProvider format_provider, out Self result)

  pub static fn try_parse(input: string, format_provider: System.IFormatProvider) -> (bool, Self)
    = extern System.TimeSpan.TryParse(string input, System.IFormatProvider format_provider, out Self result)

  pub static fn try_parse(s: string) -> (bool, Self)
    = extern System.TimeSpan.TryParse(string s, out Self result)

