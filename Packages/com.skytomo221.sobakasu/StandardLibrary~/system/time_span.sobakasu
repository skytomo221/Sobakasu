    = extern self + rhs

  pub fn ==(rhs: Self) -> bool
    = extern self == rhs

  pub fn >=(rhs: Self) -> bool
    = extern self >= rhs

  pub fn >(rhs: Self) -> bool
    = extern self > rhs

  pub fn !=(rhs: Self) -> bool
    = extern self != rhs

  pub fn <=(rhs: Self) -> bool
    = extern self <= rhs

  pub fn <(rhs: Self) -> bool
    = extern self < rhs

  pub fn -(rhs: Self) -> Self
    = extern self - rhs

  pub fn @- -> Self
    = extern -self

  pub fn @+ -> Self
    = extern +self

  pub fn add(ts: Self) -> Self
    = extern self.Add(ts)

