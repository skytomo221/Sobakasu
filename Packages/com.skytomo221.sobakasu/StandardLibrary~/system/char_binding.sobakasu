pub impl char = extern System.Char {
  pub fn convert_from_utf32(utf32: i32) -> string
    = extern System.Char.ConvertFromUtf32(utf32)

  pub fn convert_to_utf32(high_surrogate: char, low_surrogate: char) -> i32
    = extern System.Char.ConvertToUtf32(high_surrogate, low_surrogate)

  pub fn convert_to_utf32(s: string, index: i32) -> i32
    = extern System.Char.ConvertToUtf32(s, index)

  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn get_numeric_value(c: char) -> f64
    = extern System.Char.GetNumericValue(c)

  pub fn get_numeric_value(s: string, index: i32) -> f64
    = extern System.Char.GetNumericValue(s, index)

  pub fn get_unicode_category(c: char) -> System::Globalization::UnicodeCategory
    = extern System.Char.GetUnicodeCategory(c)

  pub fn get_unicode_category(s: string, index: i32) -> System::Globalization::UnicodeCategory
    = extern System.Char.GetUnicodeCategory(s, index)

  pub fn control?(c: char) -> bool
    = extern System.Char.IsControl(c)

  pub fn control?(s: string, index: i32) -> bool
    = extern System.Char.IsControl(s, index)

  pub fn digit?(c: char) -> bool
    = extern System.Char.IsDigit(c)

  pub fn digit?(s: string, index: i32) -> bool
    = extern System.Char.IsDigit(s, index)

  pub fn high_surrogate?(c: char) -> bool
    = extern System.Char.IsHighSurrogate(c)

  pub fn high_surrogate?(s: string, index: i32) -> bool
    = extern System.Char.IsHighSurrogate(s, index)

  pub fn letter_or_digit?(c: char) -> bool
    = extern System.Char.IsLetterOrDigit(c)

  pub fn letter_or_digit?(s: string, index: i32) -> bool
    = extern System.Char.IsLetterOrDigit(s, index)

  pub fn letter?(c: char) -> bool
    = extern System.Char.IsLetter(c)

  pub fn letter?(s: string, index: i32) -> bool
    = extern System.Char.IsLetter(s, index)

  pub fn low_surrogate?(c: char) -> bool
    = extern System.Char.IsLowSurrogate(c)

  pub fn low_surrogate?(s: string, index: i32) -> bool
    = extern System.Char.IsLowSurrogate(s, index)

  pub fn lower?(c: char) -> bool
    = extern System.Char.IsLower(c)

  pub fn lower?(s: string, index: i32) -> bool
    = extern System.Char.IsLower(s, index)

  pub fn number?(c: char) -> bool
    = extern System.Char.IsNumber(c)

  pub fn number?(s: string, index: i32) -> bool
    = extern System.Char.IsNumber(s, index)

  pub fn punctuation?(c: char) -> bool
    = extern System.Char.IsPunctuation(c)

  pub fn punctuation?(s: string, index: i32) -> bool
    = extern System.Char.IsPunctuation(s, index)

  pub fn separator?(c: char) -> bool
    = extern System.Char.IsSeparator(c)

  pub fn separator?(s: string, index: i32) -> bool
    = extern System.Char.IsSeparator(s, index)

  pub fn surrogate_pair?(high_surrogate: char, low_surrogate: char) -> bool
    = extern System.Char.IsSurrogatePair(high_surrogate, low_surrogate)

  pub fn surrogate_pair?(s: string, index: i32) -> bool
    = extern System.Char.IsSurrogatePair(s, index)

  pub fn surrogate?(c: char) -> bool
    = extern System.Char.IsSurrogate(c)

  pub fn surrogate?(s: string, index: i32) -> bool
    = extern System.Char.IsSurrogate(s, index)

  pub fn symbol?(c: char) -> bool
    = extern System.Char.IsSymbol(c)

  pub fn symbol?(s: string, index: i32) -> bool
    = extern System.Char.IsSymbol(s, index)

  pub fn upper?(c: char) -> bool
    = extern System.Char.IsUpper(c)

  pub fn upper?(s: string, index: i32) -> bool
    = extern System.Char.IsUpper(s, index)

  pub fn white_space?(c: char) -> bool
    = extern System.Char.IsWhiteSpace(c)

  pub fn white_space?(s: string, index: i32) -> bool
    = extern System.Char.IsWhiteSpace(s, index)

  pub fn parse(s: string) -> char
    = extern System.Char.Parse(s)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn to_lower_invariant(c: char) -> char
    = extern System.Char.ToLowerInvariant(c)

  pub fn to_lower(c: char) -> char
    = extern System.Char.ToLower(c)

  pub fn to_lower(c: char, culture: System::Globalization::CultureInfo) -> char
    = extern System.Char.ToLower(c, culture)

  pub fn to_string(c: char) -> string
    = extern System.Char.ToString(c)

  pub fn to_upper_invariant(c: char) -> char
    = extern System.Char.ToUpperInvariant(c)

  pub fn to_upper(c: char) -> char
    = extern System.Char.ToUpper(c)

  pub fn to_upper(c: char, culture: System::Globalization::CultureInfo) -> char
    = extern System.Char.ToUpper(c, culture)

  pub fn try_parse(s: string) -> (bool, char)
    = extern System.Char.TryParse(string s, out char result)

  pub fn compare_to(self, value: char) -> i32
    = extern self.CompareTo(value)

  pub fn compare_to(self, value: object) -> i32
    = extern self.CompareTo(value)

  pub fn equals(self, obj: char) -> bool
    = extern self.Equals(obj)

  pub fn equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn to_string(self, provider: System::IFormatProvider) -> string
    = extern self.ToString(provider)

  pub fn max_value -> char
    = extern System.Char.MaxValue

  pub fn min_value -> char
    = extern System.Char.MinValue
}
