public implementation f32 = extern System.Single {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function infinity?(f: f32) -> bool
    = extern System.Single.IsInfinity(f)

  public function na_n?(f: f32) -> bool
    = extern System.Single.IsNaN(f)

