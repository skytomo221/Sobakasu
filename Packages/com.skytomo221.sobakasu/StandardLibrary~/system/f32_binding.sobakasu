    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function try_parse(s: string, style: System::Globalization::NumberStyles, provider: System::IFormatProvider) -> (bool, f32)
    = extern System.Single.TryParse(string s, System::Globalization::NumberStyles style, System::IFormatProvider provider, out f32 result)

  public function try_parse(s: string) -> (bool, f32)
    = extern System.Single.TryParse(string s, out f32 result)

  public function compare_to(self, value: object) -> i32
    = extern self.CompareTo(value)

  public function compare_to(self, value: f32) -> i32
    = extern self.CompareTo(value)

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function equals(self, obj: f32) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function to_string(self) -> string
    = extern self.ToString()

  public function to_string(self, provider: System::IFormatProvider) -> string
    = extern self.ToString(provider)

  public function to_string(self, format: string) -> string
    = extern self.ToString(format)

  public function to_string(self, format: string, provider: System::IFormatProvider) -> string
    = extern self.ToString(format, provider)

  public function epsilon -> f32
    = extern System.Single.Epsilon

  public function max_value -> f32
    = extern System.Single.MaxValue

  public function min_value -> f32
    = extern System.Single.MinValue

  public function na_n -> f32
    = extern System.Single.NaN

