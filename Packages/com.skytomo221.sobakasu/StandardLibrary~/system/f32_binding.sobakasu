    = extern System.Single.Parse(s, style)

  public function parse(s: string, style: System::Globalization::NumberStyles, provider: System::IFormatProvider) -> f32
    = extern System.Single.Parse(s, style, provider)

  public function parse(s: string, provider: System::IFormatProvider) -> f32
    = extern System.Single.Parse(s, provider)

