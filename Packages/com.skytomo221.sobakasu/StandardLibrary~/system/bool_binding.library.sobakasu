use maybe::Maybe;

implementation bool {
  public function equals(obj_a: object, obj_b: object) -> Self
    = extern System.Object.Equals(obj_a, obj_b)

  public function parse(value: string) -> Self
    = extern System.Boolean.Parse(value)

  public function reference_equals(obj_a: object, obj_b: object) -> Self
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function try_parse(value: string) -> (Self, Self)
    = extern System.Boolean.TryParse(string value, out Self result)

  public function compare_to(mutable self, value: Self) -> i32
    = extern self.CompareTo(value)

  public function compare_to(mutable self, obj: object) -> i32
    = extern self.CompareTo(obj)

  public function equals(mutable self, obj: Self) -> Self
    = extern self.Equals(obj)

  public function equals(mutable self, obj: object) -> Self
    = extern self.Equals(obj)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function to_string(mutable self, provider: System::IFormatProvider) -> Maybe<string>
    = maybe extern self.ToString(provider)

  public function false_string -> Maybe<string>
    = maybe extern System.Boolean.FalseString

  public function true_string -> Maybe<string>
    = maybe extern System.Boolean.TrueString
}
