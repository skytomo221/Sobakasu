public type Stopwatch = extern System.Diagnostics.Stopwatch;

implementation Stopwatch {
  public function new() -> Self
    = extern new Self()

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function get_timestamp() -> i64
    = extern System.Diagnostics.Stopwatch.GetTimestamp()

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function start_new() -> Self
    = extern System.Diagnostics.Stopwatch.StartNew()

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function reset(self)
    = extern self.Reset()

  public function restart(self)
    = extern self.Restart()

  public function start(self)
    = extern self.Start()

  public function stop(self)
    = extern self.Stop()

  public function to_string(self) -> string
    = extern self.ToString()

  public function elapsed_milliseconds(self) -> i64
    = extern self.ElapsedMilliseconds

  public function elapsed_ticks(self) -> i64
    = extern self.ElapsedTicks

  public function elapsed(self) -> System::TimeSpan
    = extern self.Elapsed

  public function running?(self) -> bool
    = extern self.IsRunning

  public function frequency -> i64
    = extern System.Diagnostics.Stopwatch.Frequency

  public function high_resolution? -> bool
    = extern System.Diagnostics.Stopwatch.IsHighResolution
}
