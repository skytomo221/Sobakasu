  pub fn set_page_count(value: i32)
    = extern self.pageCount = value

  pub fn set_space_count(value: i32)
    = extern self.spaceCount = value

  pub fn set_sprite_count(value: i32)
    = extern self.spriteCount = value

  pub fn set_text_component(value: TMPro.TMP_Text)
    = extern self.textComponent = value

  pub fn set_word_count(value: i32)
