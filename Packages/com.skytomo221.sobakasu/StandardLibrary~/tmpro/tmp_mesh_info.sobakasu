pub struct TMP_MeshInfo = extern TMPro.TMP_MeshInfo {
  colors32: [UnityEngine.Color32] = extern colors32,
  material: UnityEngine.Material = extern material,
  mesh: UnityEngine.Mesh = extern mesh,
  normals: [UnityEngine.Vector3] = extern normals,
  tangents: [UnityEngine.Vector4] = extern tangents,
  triangles: [i32] = extern triangles,
  uvs0: [UnityEngine.Vector2] = extern uvs0,
  uvs2: [UnityEngine.Vector2] = extern uvs2,
  vertex_count: i32 = extern vertexCount,
  vertices: [UnityEngine.Vector3] = extern vertices,
}

impl TMP_MeshInfo {
  pub static fn new(mesh: UnityEngine.Mesh, size: i32) -> Self
    = extern new Self(mesh, size)

  pub static fn new(mesh: UnityEngine.Mesh, size: i32, is_volumetric: bool) -> Self
    = extern new Self(mesh, size, is_volumetric)

  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn clear_unused_vertices()
    = extern self.ClearUnusedVertices()

  pub fn clear_unused_vertices(start_index: i32)
    = extern self.ClearUnusedVertices(start_index)

  pub fn clear_unused_vertices(start_index: i32, update_mesh: bool)
    = extern self.ClearUnusedVertices(start_index, update_mesh)

  pub fn clear()
    = extern self.Clear()

  pub fn clear(upload_changes: bool)
    = extern self.Clear(upload_changes)

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn resize_mesh_info(size: i32)
    = extern self.ResizeMeshInfo(size)

  pub fn resize_mesh_info(size: i32, is_volumetric: bool)
    = extern self.ResizeMeshInfo(size, is_volumetric)

  pub fn sort_geometry(order: TMPro.VertexSortingOrder)
    = extern self.SortGeometry(order)

  pub fn swap_vertex_data(src: i32, dst: i32)
    = extern self.SwapVertexData(src, dst)
}
