use maybe::Maybe;

public struct TMP_MeshInfo = extern TMPro.TMP_MeshInfo {
  colors32: [UnityEngine::Color32] = extern colors32,
  material: UnityEngine::Material = extern material,
  mesh: UnityEngine::Mesh = extern mesh,
  normals: [UnityEngine::Vector3] = extern normals,
  tangents: [UnityEngine::Vector4] = extern tangents,
  triangles: [i32] = extern triangles,
  uvs0: [UnityEngine::Vector2] = extern uvs0,
  uvs2: [UnityEngine::Vector2] = extern uvs2,
  vertex_count: i32 = extern vertexCount,
  vertices: [UnityEngine::Vector3] = extern vertices,
}

implementation TMP_MeshInfo {
  public function new(mesh: UnityEngine::Mesh, size: i32) -> Self
    = extern new Self(mesh, size)

  public function new(mesh: UnityEngine::Mesh, size: i32, is_volumetric: bool) -> Self
    = extern new Self(mesh, size, is_volumetric)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function clear_unused_vertices(mutable self)
    = extern self.ClearUnusedVertices()

  public function clear_unused_vertices(mutable self, start_index: i32)
    = extern self.ClearUnusedVertices(start_index)

  public function clear_unused_vertices(mutable self, start_index: i32, update_mesh: bool)
    = extern self.ClearUnusedVertices(start_index, update_mesh)

  public function clear(mutable self)
    = extern self.Clear()

  public function clear(mutable self, upload_changes: bool)
    = extern self.Clear(upload_changes)

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function resize_mesh_info(mutable self, size: i32)
    = extern self.ResizeMeshInfo(size)

  public function resize_mesh_info(mutable self, size: i32, is_volumetric: bool)
    = extern self.ResizeMeshInfo(size, is_volumetric)

  public function sort_geometry(mutable self, sorting_order: System::Collections::Generic::IList<i32>)
    = extern self.SortGeometry(sorting_order)

  public function sort_geometry(mutable self, order: TMPro::VertexSortingOrder)
    = extern self.SortGeometry(order)

  public function swap_vertex_data(mutable self, src: i32, dst: i32)
    = extern self.SwapVertexData(src, dst)

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()
}
