lang "bool"
pub impl bool = extern System.Boolean {
  pub fn &(rhs: Self) -> Self
    = extern self & rhs

  pub fn |(rhs: Self) -> Self
    = extern self | rhs

  pub fn ==(rhs: Self) -> Self
    = extern self == rhs

  pub fn ^(rhs: Self) -> Self
    = extern self ^ rhs

  pub fn !=(rhs: Self) -> Self
    = extern self != rhs

  pub fn @! -> Self
    = extern !self
}

