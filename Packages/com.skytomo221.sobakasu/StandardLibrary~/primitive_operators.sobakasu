lang "f32"
pub impl f32 = extern System.Single {
  pub fn +(self, rhs: Self) -> Self
    = extern self + rhs

  pub fn /(self, rhs: Self) -> Self
    = extern self / rhs

  pub fn ==(self, rhs: Self) -> bool
    = extern self == rhs

  pub fn >=(self, rhs: Self) -> bool
    = extern self >= rhs

  pub fn >(self, rhs: Self) -> bool
    = extern self > rhs

  pub fn !=(self, rhs: Self) -> bool
    = extern self != rhs

  pub fn <=(self, rhs: Self) -> bool
    = extern self <= rhs

  pub fn <(self, rhs: Self) -> bool
    = extern self < rhs

  pub fn %(self, rhs: Self) -> Self
    = extern self % rhs

  pub fn *(self, rhs: Self) -> Self
    = extern self * rhs

  pub fn -(self, rhs: Self) -> Self
    = extern self - rhs

  pub fn @-(self) -> Self
    = extern -self

  pub fn *(self, rhs: UnityEngine::Color) -> UnityEngine::Color
    = extern self * rhs

  pub fn *(self, rhs: UnityEngine::Rendering::SphericalHarmonicsL2) -> UnityEngine::Rendering::SphericalHarmonicsL2
    = extern self * rhs

  pub fn *(self, rhs: UnityEngine::Vector2) -> UnityEngine::Vector2
    = extern self * rhs

  pub fn *(self, rhs: UnityEngine::Vector3) -> UnityEngine::Vector3
    = extern self * rhs

  pub fn *(self, rhs: UnityEngine::Vector4) -> UnityEngine::Vector4
    = extern self * rhs

  pub fn ==(self, rhs: VRC::SDK3::Data::DataToken) -> bool
    = extern self == rhs

  pub fn !=(self, rhs: VRC::SDK3::Data::DataToken) -> bool
    = extern self != rhs
}

