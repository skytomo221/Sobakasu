lang "bool"
pub impl bool = extern System.Boolean {
  pub fn &(self, rhs: Self) -> Self
    = extern self & rhs

  pub fn |(self, rhs: Self) -> Self
    = extern self | rhs

  pub fn ==(self, rhs: Self) -> Self
    = extern self == rhs

  pub fn ^(self, rhs: Self) -> Self
    = extern self ^ rhs

  pub fn !=(self, rhs: Self) -> Self
    = extern self != rhs

  pub fn @!(self) -> Self
    = extern !self
}

