pub fn equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.Equals(obj_a, obj_b)

pub fn reference_equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.ReferenceEquals(obj_a, obj_b)

pub fn try_deserialize_from_json(source: string) -> (bool, VRC.SDK3.Data.DataToken)
  = extern VRC.SDK3.Data.VRCJson.TryDeserializeFromJson(string source, out VRC.SDK3.Data.DataToken result)

pub fn try_serialize_to_json(input: VRC.SDK3.Data.DataToken, json_export_type: VRC.SDK3.Data.JsonExportType) -> (bool, VRC.SDK3.Data.DataToken)
  = extern VRC.SDK3.Data.VRCJson.TrySerializeToJson(VRC.SDK3.Data.DataToken input, VRC.SDK3.Data.JsonExportType json_export_type, out VRC.SDK3.Data.DataToken result)
