public function deoptimize_transform_hierarchy(go: UnityEngine::GameObject)
  = extern UnityEngine.AnimatorUtility.DeoptimizeTransformHierarchy(go)

public function equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.Equals(obj_a, obj_b)

public function optimize_transform_hierarchy(go: UnityEngine::GameObject, exposed_transforms: [string])
  = extern UnityEngine.AnimatorUtility.OptimizeTransformHierarchy(go, exposed_transforms)

public function reference_equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.ReferenceEquals(obj_a, obj_b)
