use maybe::Maybe;

public struct TriggerModule = extern UnityEngine.ParticleSystem+TriggerModule {
}

implementation TriggerModule {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function add_collider(mutable self, collider: UnityEngine::Component)
    = extern self.AddCollider(collider)

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_collider(mutable self, index: i32) -> Maybe<UnityEngine::Component>
    = maybe extern self.GetCollider(index)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function remove_collider(mutable self, index: i32)
    = extern self.RemoveCollider(index)

  public function remove_collider(mutable self, collider: UnityEngine::Component)
    = extern self.RemoveCollider(collider)

  public function set_collider(mutable self, index: i32, collider: UnityEngine::Component)
    = extern self.SetCollider(index, collider)

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function collider_count(mutable self) -> i32
    = extern self.colliderCount

  public function collider_query_mode(mutable self) -> UnityEngine::ParticleSystemColliderQueryMode
    = extern self.colliderQueryMode

  public function enabled(mutable self) -> bool
    = extern self.enabled

  public function enter(mutable self) -> UnityEngine::ParticleSystemOverlapAction
    = extern self.enter

  public function exit(mutable self) -> UnityEngine::ParticleSystemOverlapAction
    = extern self.exit

  public function inside(mutable self) -> UnityEngine::ParticleSystemOverlapAction
    = extern self.inside

  public function outside(mutable self) -> UnityEngine::ParticleSystemOverlapAction
    = extern self.outside

  public function radius_scale(mutable self) -> f32
    = extern self.radiusScale

  public function set_collider_query_mode(mutable self, value: UnityEngine::ParticleSystemColliderQueryMode)
    = extern self.colliderQueryMode = value

  public function set_enabled(mutable self, value: bool)
    = extern self.enabled = value

  public function set_enter(mutable self, value: UnityEngine::ParticleSystemOverlapAction)
    = extern self.enter = value

  public function set_exit(mutable self, value: UnityEngine::ParticleSystemOverlapAction)
    = extern self.exit = value

  public function set_inside(mutable self, value: UnityEngine::ParticleSystemOverlapAction)
    = extern self.inside = value

  public function set_outside(mutable self, value: UnityEngine::ParticleSystemOverlapAction)
    = extern self.outside = value

  public function set_radius_scale(mutable self, value: f32)
    = extern self.radiusScale = value
}
