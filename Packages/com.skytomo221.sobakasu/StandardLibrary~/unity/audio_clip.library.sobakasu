public type AudioClip = extern UnityEngine.AudioClip;

implementation AudioClip {
  public function create(name: string, length_samples: i32, channels: i32, frequency: i32, stream: bool) -> Self
    = extern UnityEngine.AudioClip.Create(name, length_samples, channels, frequency, stream)

  public function destroy_immediate(obj: UnityEngine::Object)
    = extern UnityEngine.Object.DestroyImmediate(obj)

  public function destroy_immediate(obj: UnityEngine::Object, allow_destroying_assets: bool)
    = extern UnityEngine.Object.DestroyImmediate(obj, allow_destroying_assets)

  public function destroy(obj: UnityEngine::Object)
    = extern UnityEngine.Object.Destroy(obj)

  public function destroy(obj: UnityEngine::Object, t: f32)
    = extern UnityEngine.Object.Destroy(obj, t)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(self, other: object) -> bool
    = extern self.Equals(other)

  public function get_data(self, data: [f32], offset_samples: i32) -> bool
    = extern self.GetData(data, offset_samples)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_instance_id(self) -> i32
    = extern self.GetInstanceID()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function load_audio_data(self) -> bool
    = extern self.LoadAudioData()

  public function set_data(self, data: [f32], offset_samples: i32) -> bool
    = extern self.SetData(data, offset_samples)

  public function to_string(self) -> string
    = extern self.ToString()

  public function unload_audio_data(self) -> bool
    = extern self.UnloadAudioData()

  public function ambisonic(self) -> bool
    = extern self.ambisonic

  public function channels(self) -> i32
    = extern self.channels

  public function frequency(self) -> i32
    = extern self.frequency

  public function length(self) -> f32
    = extern self.length

  public function load_in_background(self) -> bool
    = extern self.loadInBackground

  public function load_state(self) -> UnityEngine::AudioDataLoadState
    = extern self.loadState

  public function load_type(self) -> UnityEngine::AudioClipLoadType
    = extern self.loadType

  public function name(self) -> string
    = extern self.name

  public function preload_audio_data(self) -> bool
    = extern self.preloadAudioData

  public function samples(self) -> i32
    = extern self.samples

  public function set_name(self, value: string)
    = extern self.name = value
}
