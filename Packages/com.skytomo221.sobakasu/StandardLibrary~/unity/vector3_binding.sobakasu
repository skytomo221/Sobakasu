public struct Vector3 = extern UnityEngine.Vector3 {
  x: f32 = extern x,
  y: f32 = extern y,
  z: f32 = extern z,
}

implementation Vector3 {
  public function new(x: f32, y: f32) -> Self
    = extern new Self(x, y)

  public function new(x: f32, y: f32, z: f32) -> Self
    = extern new Self(x, y, z)

  public function angle(from: Self, to_: Self) -> f32
    = extern UnityEngine.Vector3.Angle(from, to_)

  public function clamp_magnitude(vector: Self, max_length: f32) -> Self
    = extern UnityEngine.Vector3.ClampMagnitude(vector, max_length)

  public function cross(lhs: Self, rhs: Self) -> Self
    = extern UnityEngine.Vector3.Cross(lhs, rhs)

  public function distance(a: Self, b: Self) -> f32
    = extern UnityEngine.Vector3.Distance(a, b)

  public function dot(lhs: Self, rhs: Self) -> f32
    = extern UnityEngine.Vector3.Dot(lhs, rhs)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function lerp_unclamped(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Vector3.LerpUnclamped(a, b, t)

  public function lerp(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Vector3.Lerp(a, b, t)

  public function magnitude(vector: Self) -> f32
    = extern UnityEngine.Vector3.Magnitude(vector)

  public function max(lhs: Self, rhs: Self) -> Self
    = extern UnityEngine.Vector3.Max(lhs, rhs)

  public function min(lhs: Self, rhs: Self) -> Self
    = extern UnityEngine.Vector3.Min(lhs, rhs)

  public function move_towards(current: Self, target: Self, max_distance_delta: f32) -> Self
    = extern UnityEngine.Vector3.MoveTowards(current, target, max_distance_delta)

  public function normalize(value: Self) -> Self
    = extern UnityEngine.Vector3.Normalize(value)

  public function ortho_normalize(normal: Self, tangent: Self) -> (Self, Self)
    = extern UnityEngine.Vector3.OrthoNormalize(ref Self normal, ref Self tangent)

  public function ortho_normalize(normal: Self, tangent: Self, binormal: Self) -> (Self, Self, Self)
    = extern UnityEngine.Vector3.OrthoNormalize(ref Self normal, ref Self tangent, ref Self binormal)

  public function project_on_plane(vector: Self, plane_normal: Self) -> Self
    = extern UnityEngine.Vector3.ProjectOnPlane(vector, plane_normal)

  public function project(vector: Self, on_normal: Self) -> Self
    = extern UnityEngine.Vector3.Project(vector, on_normal)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function reflect(in_direction: Self, in_normal: Self) -> Self
    = extern UnityEngine.Vector3.Reflect(in_direction, in_normal)

  public function rotate_towards(current: Self, target: Self, max_radians_delta: f32, max_magnitude_delta: f32) -> Self
    = extern UnityEngine.Vector3.RotateTowards(current, target, max_radians_delta, max_magnitude_delta)

  public function scale(a: Self, b: Self) -> Self
    = extern UnityEngine.Vector3.Scale(a, b)

  public function signed_angle(from: Self, to_: Self, axis: Self) -> f32
    = extern UnityEngine.Vector3.SignedAngle(from, to_, axis)

  public function slerp_unclamped(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Vector3.SlerpUnclamped(a, b, t)

  public function slerp(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Vector3.Slerp(a, b, t)

  public function smooth_damp(current: Self, target: Self, current_velocity: Self, smooth_time: f32) -> (Self, Self)
    = extern UnityEngine.Vector3.SmoothDamp(Self current, Self target, ref Self current_velocity, f32 smooth_time)

  public function smooth_damp(current: Self, target: Self, current_velocity: Self, smooth_time: f32, max_speed: f32) -> (Self, Self)
    = extern UnityEngine.Vector3.SmoothDamp(Self current, Self target, ref Self current_velocity, f32 smooth_time, f32 max_speed)

  public function smooth_damp(current: Self, target: Self, current_velocity: Self, smooth_time: f32, max_speed: f32, delta_time: f32) -> (Self, Self)
    = extern UnityEngine.Vector3.SmoothDamp(Self current, Self target, ref Self current_velocity, f32 smooth_time, f32 max_speed, f32 delta_time)

  public function sqr_magnitude(vector: Self) -> f32
    = extern UnityEngine.Vector3.SqrMagnitude(vector)

  public function +(self, rhs: Self) -> Self
    = extern self + rhs

  public function /(self, rhs: f32) -> Self
    = extern self / rhs

  public function ==(self, rhs: Self) -> bool
    = extern self == rhs

  public function !=(self, rhs: Self) -> bool
    = extern self != rhs

  public function *(self, rhs: f32) -> Self
    = extern self * rhs

  public function -(self, rhs: Self) -> Self
    = extern self - rhs

  public function @-(self) -> Self
    = extern -self

  public function equals(self, other: object) -> bool
    = extern self.Equals(other)

  public function equals(self, other: Self) -> bool
    = extern self.Equals(other)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function normalize(self)
    = extern self.Normalize()

  public function scale(self, scale: Self)
    = extern self.Scale(scale)

  public function set(self, new_x: f32, new_y: f32, new_z: f32)
    = extern self.Set(new_x, new_y, new_z)

  public function to_string(self) -> string
    = extern self.ToString()

  public function to_string(self, format: string) -> string
    = extern self.ToString(format)

  public function to_string(self, format: string, format_provider: System::IFormatProvider) -> string
    = extern self.ToString(format, format_provider)

  public function back -> Self
    = extern UnityEngine.Vector3.back

  public function down -> Self
    = extern UnityEngine.Vector3.down

  public function forward -> Self
    = extern UnityEngine.Vector3.forward

  public function left -> Self
    = extern UnityEngine.Vector3.left

  public function magnitude(self) -> f32
    = extern self.magnitude

  public function negative_infinity -> Self
    = extern UnityEngine.Vector3.negativeInfinity

  public function normalized(self) -> Self
    = extern self.normalized

  public function one -> Self
    = extern UnityEngine.Vector3.one

  public function positive_infinity -> Self
    = extern UnityEngine.Vector3.positiveInfinity

  public function right -> Self
    = extern UnityEngine.Vector3.right

  public function sqr_magnitude(self) -> f32
    = extern self.sqrMagnitude

  public function up -> Self
    = extern UnityEngine.Vector3.up

  public function zero -> Self
    = extern UnityEngine.Vector3.zero

  public function k_epsilon_normal_sqrt -> f32
    = extern UnityEngine.Vector3.kEpsilonNormalSqrt

  public function k_epsilon -> f32
    = extern UnityEngine.Vector3.kEpsilon
}
