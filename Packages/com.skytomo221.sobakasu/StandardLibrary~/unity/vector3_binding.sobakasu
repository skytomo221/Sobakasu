pub impl Vector3 = extern UnityEngine.Vector3 {
  pub static fn new(x: f32, y: f32) -> Self
    = extern new Self(x, y)

  pub static fn new(x: f32, y: f32, z: f32) -> Self
    = extern new Self(x, y, z)

  pub static fn angle(from: Self, to_: Self) -> f32
    = extern UnityEngine.Vector3.Angle(from, to_)

  pub static fn clamp_magnitude(vector: Self, max_length: f32) -> Self
    = extern UnityEngine.Vector3.ClampMagnitude(vector, max_length)

  pub static fn cross(lhs: Self, rhs: Self) -> Self
    = extern UnityEngine.Vector3.Cross(lhs, rhs)

  pub static fn distance(a: Self, b: Self) -> f32
    = extern UnityEngine.Vector3.Distance(a, b)

  pub static fn dot(lhs: Self, rhs: Self) -> f32
    = extern UnityEngine.Vector3.Dot(lhs, rhs)

  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn lerp_unclamped(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Vector3.LerpUnclamped(a, b, t)

  pub static fn lerp(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Vector3.Lerp(a, b, t)

  pub static fn magnitude(vector: Self) -> f32
    = extern UnityEngine.Vector3.Magnitude(vector)

  pub static fn max(lhs: Self, rhs: Self) -> Self
    = extern UnityEngine.Vector3.Max(lhs, rhs)

  pub static fn min(lhs: Self, rhs: Self) -> Self
    = extern UnityEngine.Vector3.Min(lhs, rhs)

  pub static fn move_towards(current: Self, target: Self, max_distance_delta: f32) -> Self
    = extern UnityEngine.Vector3.MoveTowards(current, target, max_distance_delta)

  pub static fn normalize(value: Self) -> Self
    = extern UnityEngine.Vector3.Normalize(value)

  pub static fn ortho_normalize(normal: Self, tangent: Self) -> (Self, Self)
    = extern UnityEngine.Vector3.OrthoNormalize(ref Self normal, ref Self tangent)

  pub static fn ortho_normalize(normal: Self, tangent: Self, binormal: Self) -> (Self, Self, Self)
    = extern UnityEngine.Vector3.OrthoNormalize(ref Self normal, ref Self tangent, ref Self binormal)

  pub static fn project_on_plane(vector: Self, plane_normal: Self) -> Self
    = extern UnityEngine.Vector3.ProjectOnPlane(vector, plane_normal)

  pub static fn project(vector: Self, on_normal: Self) -> Self
    = extern UnityEngine.Vector3.Project(vector, on_normal)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub static fn reflect(in_direction: Self, in_normal: Self) -> Self
    = extern UnityEngine.Vector3.Reflect(in_direction, in_normal)

  pub static fn rotate_towards(current: Self, target: Self, max_radians_delta: f32, max_magnitude_delta: f32) -> Self
    = extern UnityEngine.Vector3.RotateTowards(current, target, max_radians_delta, max_magnitude_delta)

  pub static fn scale(a: Self, b: Self) -> Self
    = extern UnityEngine.Vector3.Scale(a, b)

  pub static fn signed_angle(from: Self, to_: Self, axis: Self) -> f32
    = extern UnityEngine.Vector3.SignedAngle(from, to_, axis)

  pub static fn slerp_unclamped(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Vector3.SlerpUnclamped(a, b, t)

  pub static fn slerp(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Vector3.Slerp(a, b, t)

  pub static fn smooth_damp(current: Self, target: Self, current_velocity: Self, smooth_time: f32) -> (Self, Self)
    = extern UnityEngine.Vector3.SmoothDamp(Self current, Self target, ref Self current_velocity, f32 smooth_time)

  pub static fn smooth_damp(current: Self, target: Self, current_velocity: Self, smooth_time: f32, max_speed: f32) -> (Self, Self)
    = extern UnityEngine.Vector3.SmoothDamp(Self current, Self target, ref Self current_velocity, f32 smooth_time, f32 max_speed)

  pub static fn smooth_damp(current: Self, target: Self, current_velocity: Self, smooth_time: f32, max_speed: f32, delta_time: f32) -> (Self, Self)
    = extern UnityEngine.Vector3.SmoothDamp(Self current, Self target, ref Self current_velocity, f32 smooth_time, f32 max_speed, f32 delta_time)

  pub static fn sqr_magnitude(vector: Self) -> f32
    = extern UnityEngine.Vector3.SqrMagnitude(vector)

  pub fn equals(other: object) -> bool
    = extern self.Equals(other)

  pub fn equals(other: Self) -> bool
    = extern self.Equals(other)

  pub fn get_hash_code() -> i32
    = extern self.GetHashCode()

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn normalize()
    = extern self.Normalize()

  pub fn scale(scale: Self)
    = extern self.Scale(scale)

  pub fn set(new_x: f32, new_y: f32, new_z: f32)
    = extern self.Set(new_x, new_y, new_z)

  pub fn to_string() -> string
    = extern self.ToString()

  pub fn to_string(format: string) -> string
    = extern self.ToString(format)

  pub fn to_string(format: string, format_provider: System.IFormatProvider) -> string
    = extern self.ToString(format, format_provider)

  pub static fn back -> Self
    = extern Self.back

  pub static fn down -> Self
    = extern Self.down

  pub static fn forward -> Self
    = extern Self.forward

  pub static fn left -> Self
    = extern Self.left

  pub fn magnitude -> f32
    = extern self.magnitude

  pub static fn negative_infinity -> Self
    = extern Self.negativeInfinity

  pub fn normalized -> Self
    = extern self.normalized

  pub static fn one -> Self
    = extern Self.one

  pub static fn positive_infinity -> Self
    = extern Self.positiveInfinity

  pub static fn right -> Self
    = extern Self.right

  pub fn sqr_magnitude -> f32
    = extern self.sqrMagnitude

  pub static fn up -> Self
    = extern Self.up

  pub static fn zero -> Self
    = extern Self.zero

  pub static fn k_epsilon_normal_sqrt -> f32
    = extern Self.kEpsilonNormalSqrt

  pub static fn k_epsilon -> f32
    = extern Self.kEpsilon

  pub fn x -> f32
    = extern self.x

  pub fn y -> f32
    = extern self.y

  pub fn z -> f32
    = extern self.z

  pub fn set_x(value: f32)
    = extern self.x = value

  pub fn set_y(value: f32)
    = extern self.y = value

  pub fn set_z(value: f32)
    = extern self.z = value
}
