pub fn equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.Equals(obj_a, obj_b)

pub fn find_root_sort_override_canvas(start: UnityEngine.Transform) -> UnityEngine.Transform
  = extern UnityEngine.UI.MaskUtilities.FindRootSortOverrideCanvas(start)

pub fn get_rect_mask_for_clippable(clippable: UnityEngine.UI.IClippable) -> UnityEngine.UI.RectMask2D
  = extern UnityEngine.UI.MaskUtilities.GetRectMaskForClippable(clippable)

pub fn get_rect_masks_for_clip(clipper: UnityEngine.UI.RectMask2D, masks: System.Collections.Generic.List<UnityEngine.UI.RectMask2D>)
  = extern UnityEngine.UI.MaskUtilities.GetRectMasksForClip(clipper, masks)

pub fn get_stencil_depth(transform: UnityEngine.Transform, stop_after: UnityEngine.Transform) -> i32
  = extern UnityEngine.UI.MaskUtilities.GetStencilDepth(transform, stop_after)

pub fn descendant_or_self?(father: UnityEngine.Transform, child: UnityEngine.Transform) -> bool
  = extern UnityEngine.UI.MaskUtilities.IsDescendantOrSelf(father, child)

pub fn notify2_d_mask_state_changed(mask: UnityEngine.Component)
  = extern UnityEngine.UI.MaskUtilities.Notify2DMaskStateChanged(mask)

pub fn notify_stencil_state_changed(mask: UnityEngine.Component)
  = extern UnityEngine.UI.MaskUtilities.NotifyStencilStateChanged(mask)

pub fn reference_equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.ReferenceEquals(obj_a, obj_b)
