public function equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.Equals(obj_a, obj_b)

public function get_flexible_height(rect: UnityEngine::RectTransform) -> f32
  = extern UnityEngine.UI.LayoutUtility.GetFlexibleHeight(rect)

public function get_flexible_size(rect: UnityEngine::RectTransform, axis: i32) -> f32
  = extern UnityEngine.UI.LayoutUtility.GetFlexibleSize(rect, axis)

public function get_flexible_width(rect: UnityEngine::RectTransform) -> f32
  = extern UnityEngine.UI.LayoutUtility.GetFlexibleWidth(rect)

public function get_min_height(rect: UnityEngine::RectTransform) -> f32
  = extern UnityEngine.UI.LayoutUtility.GetMinHeight(rect)

public function get_min_size(rect: UnityEngine::RectTransform, axis: i32) -> f32
  = extern UnityEngine.UI.LayoutUtility.GetMinSize(rect, axis)

public function get_min_width(rect: UnityEngine::RectTransform) -> f32
  = extern UnityEngine.UI.LayoutUtility.GetMinWidth(rect)

public function get_preferred_height(rect: UnityEngine::RectTransform) -> f32
  = extern UnityEngine.UI.LayoutUtility.GetPreferredHeight(rect)

public function get_preferred_size(rect: UnityEngine::RectTransform, axis: i32) -> f32
  = extern UnityEngine.UI.LayoutUtility.GetPreferredSize(rect, axis)

public function get_preferred_width(rect: UnityEngine::RectTransform) -> f32
  = extern UnityEngine.UI.LayoutUtility.GetPreferredWidth(rect)

public function reference_equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.ReferenceEquals(obj_a, obj_b)
