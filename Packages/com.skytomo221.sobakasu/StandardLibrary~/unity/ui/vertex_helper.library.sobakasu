public type VertexHelper = extern UnityEngine.UI.VertexHelper;

implementation VertexHelper {
  public function new() -> Self
    = extern new Self()

  public function new(m: UnityEngine::Mesh) -> Self
    = extern new Self(m)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function add_triangle(self, idx0: i32, idx1: i32, idx2: i32)
    = extern self.AddTriangle(idx0, idx1, idx2)

  public function add_ui_vertex_stream(self, verts: System::Collections::Generic::List<UnityEngine::UIVertex>, indices: System::Collections::Generic::List<i32>)
    = extern self.AddUIVertexStream(verts, indices)

  public function add_ui_vertex_triangle_stream(self, verts: System::Collections::Generic::List<UnityEngine::UIVertex>)
    = extern self.AddUIVertexTriangleStream(verts)

  public function add_vert(self, v: UnityEngine::UIVertex)
    = extern self.AddVert(v)

  public function add_vert(self, position: UnityEngine::Vector3, color: UnityEngine::Color32, uv0: UnityEngine::Vector4)
    = extern self.AddVert(position, color, uv0)

  public function add_vert(self, position: UnityEngine::Vector3, color: UnityEngine::Color32, uv0: UnityEngine::Vector4, uv1: UnityEngine::Vector4, normal: UnityEngine::Vector3, tangent: UnityEngine::Vector4)
    = extern self.AddVert(position, color, uv0, uv1, normal, tangent)

  public function add_vert(self, position: UnityEngine::Vector3, color: UnityEngine::Color32, uv0: UnityEngine::Vector4, uv1: UnityEngine::Vector4, uv2: UnityEngine::Vector4, uv3: UnityEngine::Vector4, normal: UnityEngine::Vector3, tangent: UnityEngine::Vector4)
    = extern self.AddVert(position, color, uv0, uv1, uv2, uv3, normal, tangent)

  public function clear(self)
    = extern self.Clear()

  public function dispose(self)
    = extern self.Dispose()

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function fill_mesh(self, mesh: UnityEngine::Mesh)
    = extern self.FillMesh(mesh)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function get_ui_vertex_stream(self, stream: System::Collections::Generic::List<UnityEngine::UIVertex>)
    = extern self.GetUIVertexStream(stream)

  public function populate_ui_vertex(self, vertex: UnityEngine::UIVertex, i: i32) -> UnityEngine::UIVertex
    = extern self.PopulateUIVertex(ref UnityEngine::UIVertex vertex, i32 i)

  public function set_ui_vertex(self, vertex: UnityEngine::UIVertex, i: i32)
    = extern self.SetUIVertex(vertex, i)

  public function to_string(self) -> string
    = extern self.ToString()

  public function current_index_count(self) -> i32
    = extern self.currentIndexCount

  public function current_vert_count(self) -> i32
    = extern self.currentVertCount
}
