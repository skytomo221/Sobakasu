public struct Navigation = extern UnityEngine.UI.Navigation {
}

implementation Navigation {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(self, other: Self) -> bool
    = extern self.Equals(other)

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function default_navigation -> Self
    = extern UnityEngine.UI.Navigation.defaultNavigation

  public function mode(self) -> UnityEngine::UI::Navigation::Mode
    = extern self.mode

  public function select_on_down(self) -> UnityEngine::UI::Selectable
    = extern self.selectOnDown

  public function select_on_left(self) -> UnityEngine::UI::Selectable
    = extern self.selectOnLeft

  public function select_on_right(self) -> UnityEngine::UI::Selectable
    = extern self.selectOnRight

  public function select_on_up(self) -> UnityEngine::UI::Selectable
    = extern self.selectOnUp

  public function wrap_around(self) -> bool
    = extern self.wrapAround

  public function set_mode(self, value: UnityEngine::UI::Navigation::Mode)
    = extern self.mode = value

  public function set_select_on_down(self, value: UnityEngine::UI::Selectable)
    = extern self.selectOnDown = value

  public function set_select_on_left(self, value: UnityEngine::UI::Selectable)
    = extern self.selectOnLeft = value

  public function set_select_on_right(self, value: UnityEngine::UI::Selectable)
    = extern self.selectOnRight = value

  public function set_select_on_up(self, value: UnityEngine::UI::Selectable)
    = extern self.selectOnUp = value

  public function set_wrap_around(self, value: bool)
    = extern self.wrapAround = value
}
