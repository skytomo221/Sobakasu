public type LayoutRebuilder = extern UnityEngine.UI.LayoutRebuilder;

implementation LayoutRebuilder {
  public function new() -> Self
    = extern new Self()

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function force_rebuild_layout_immediate(layout_root: UnityEngine::RectTransform)
    = extern UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(layout_root)

  public function mark_layout_for_rebuild(rect: UnityEngine::RectTransform)
    = extern UnityEngine.UI.LayoutRebuilder.MarkLayoutForRebuild(rect)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

