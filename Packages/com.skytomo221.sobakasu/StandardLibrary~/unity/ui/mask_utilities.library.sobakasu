public function equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.Equals(obj_a, obj_b)

public function find_root_sort_override_canvas(start: UnityEngine::Transform) -> UnityEngine::Transform
  = extern UnityEngine.UI.MaskUtilities.FindRootSortOverrideCanvas(start)

public function get_rect_mask_for_clippable(clippable: UnityEngine::UI::IClippable) -> UnityEngine::UI::RectMask2D
  = extern UnityEngine.UI.MaskUtilities.GetRectMaskForClippable(clippable)

public function get_rect_masks_for_clip(clipper: UnityEngine::UI::RectMask2D, masks: System::Collections::Generic::List<UnityEngine::UI::RectMask2D>)
  = extern UnityEngine.UI.MaskUtilities.GetRectMasksForClip(clipper, masks)

public function get_stencil_depth(transform: UnityEngine::Transform, stop_after: UnityEngine::Transform) -> i32
  = extern UnityEngine.UI.MaskUtilities.GetStencilDepth(transform, stop_after)

public function descendant_or_self?(father: UnityEngine::Transform, child: UnityEngine::Transform) -> bool
  = extern UnityEngine.UI.MaskUtilities.IsDescendantOrSelf(father, child)

public function notify2_d_mask_state_changed(mask: UnityEngine::Component)
  = extern UnityEngine.UI.MaskUtilities.Notify2DMaskStateChanged(mask)

public function notify_stencil_state_changed(mask: UnityEngine::Component)
  = extern UnityEngine.UI.MaskUtilities.NotifyStencilStateChanged(mask)

public function reference_equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.ReferenceEquals(obj_a, obj_b)
