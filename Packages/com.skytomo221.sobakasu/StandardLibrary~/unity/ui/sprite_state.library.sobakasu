use maybe::Maybe;

public struct SpriteState = extern UnityEngine.UI.SpriteState {
}

implementation SpriteState {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function equals(mutable self, other: Self) -> bool
    = extern self.Equals(other)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function disabled_sprite(mutable self) -> Maybe<UnityEngine::Sprite>
    = maybe extern self.disabledSprite

  public function highlighted_sprite(mutable self) -> Maybe<UnityEngine::Sprite>
    = maybe extern self.highlightedSprite

  public function pressed_sprite(mutable self) -> Maybe<UnityEngine::Sprite>
    = maybe extern self.pressedSprite

  public function selected_sprite(mutable self) -> Maybe<UnityEngine::Sprite>
    = maybe extern self.selectedSprite

  public function set_disabled_sprite(mutable self, value: UnityEngine::Sprite)
    = extern self.disabledSprite = value

  public function set_highlighted_sprite(mutable self, value: UnityEngine::Sprite)
    = extern self.highlightedSprite = value

  public function set_pressed_sprite(mutable self, value: UnityEngine::Sprite)
    = extern self.pressedSprite = value

  public function set_selected_sprite(mutable self, value: UnityEngine::Sprite)
    = extern self.selectedSprite = value
}
