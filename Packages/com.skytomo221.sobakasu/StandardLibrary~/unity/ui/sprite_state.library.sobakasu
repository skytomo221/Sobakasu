public struct SpriteState = extern UnityEngine.UI.SpriteState {
}

implementation SpriteState {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(self, other: Self) -> bool
    = extern self.Equals(other)

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function disabled_sprite(self) -> UnityEngine::Sprite
    = extern self.disabledSprite

  public function highlighted_sprite(self) -> UnityEngine::Sprite
    = extern self.highlightedSprite

  public function pressed_sprite(self) -> UnityEngine::Sprite
    = extern self.pressedSprite

  public function selected_sprite(self) -> UnityEngine::Sprite
    = extern self.selectedSprite

  public function set_disabled_sprite(self, value: UnityEngine::Sprite)
    = extern self.disabledSprite = value

  public function set_highlighted_sprite(self, value: UnityEngine::Sprite)
    = extern self.highlightedSprite = value

  public function set_pressed_sprite(self, value: UnityEngine::Sprite)
    = extern self.pressedSprite = value

  public function set_selected_sprite(self, value: UnityEngine::Sprite)
    = extern self.selectedSprite = value
}
