pub type LayoutRebuilder = extern UnityEngine.UI.LayoutRebuilder;

impl LayoutRebuilder {
  pub fn new() -> Self
    = extern new Self()

  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn force_rebuild_layout_immediate(layout_root: UnityEngine::RectTransform)
    = extern UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(layout_root)

  pub fn mark_layout_for_rebuild(rect: UnityEngine::RectTransform)
    = extern UnityEngine.UI.LayoutRebuilder.MarkLayoutForRebuild(rect)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn graphic_update_complete(self)
    = extern self.GraphicUpdateComplete()

  pub fn destroyed?(self) -> bool
    = extern self.IsDestroyed()

  pub fn layout_complete(self)
    = extern self.LayoutComplete()

  pub fn rebuild(self, executing: UnityEngine::UI::CanvasUpdate)
    = extern self.Rebuild(executing)

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn transform(self) -> UnityEngine::Transform
    = extern self.transform
}
