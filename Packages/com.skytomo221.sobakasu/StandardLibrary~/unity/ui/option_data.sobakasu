public type OptionData = extern UnityEngine.UI.Dropdown.OptionData;

implementation OptionData {
  public function new() -> Self
    = extern new Self()

  public function new(text: string) -> Self
    = extern new Self(text)

  public function new(text: string, image: UnityEngine::Sprite) -> Self
    = extern new Self(text, image)

  public function new(image: UnityEngine::Sprite) -> Self
    = extern new Self(image)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function to_string(self) -> string
    = extern self.ToString()

  public function image(self) -> UnityEngine::Sprite
    = extern self.image

  public function text(self) -> string
    = extern self.text

  public function set_image(self, value: UnityEngine::Sprite)
    = extern self.image = value

  public function set_text(self, value: string)
    = extern self.text = value
}
