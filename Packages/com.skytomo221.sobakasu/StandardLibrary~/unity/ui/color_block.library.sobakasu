use maybe::Maybe;

public struct ColorBlock = extern UnityEngine.UI.ColorBlock {
}

implementation ColorBlock {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function ==(self, rhs: Self) -> bool
    = extern self == rhs

  public function !=(self, rhs: Self) -> bool
    = extern self != rhs

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function equals(mutable self, other: Self) -> bool
    = extern self.Equals(other)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function color_multiplier(mutable self) -> f32
    = extern self.colorMultiplier

  public function disabled_color(mutable self) -> UnityEngine::Color
    = extern self.disabledColor

  public function fade_duration(mutable self) -> f32
    = extern self.fadeDuration

  public function highlighted_color(mutable self) -> UnityEngine::Color
    = extern self.highlightedColor

  public function normal_color(mutable self) -> UnityEngine::Color
    = extern self.normalColor

  public function pressed_color(mutable self) -> UnityEngine::Color
    = extern self.pressedColor

  public function selected_color(mutable self) -> UnityEngine::Color
    = extern self.selectedColor

  public function set_color_multiplier(mutable self, value: f32)
    = extern self.colorMultiplier = value

  public function set_disabled_color(mutable self, value: UnityEngine::Color)
    = extern self.disabledColor = value

  public function set_fade_duration(mutable self, value: f32)
    = extern self.fadeDuration = value

  public function set_highlighted_color(mutable self, value: UnityEngine::Color)
    = extern self.highlightedColor = value

  public function set_normal_color(mutable self, value: UnityEngine::Color)
    = extern self.normalColor = value

  public function set_pressed_color(mutable self, value: UnityEngine::Color)
    = extern self.pressedColor = value

  public function set_selected_color(mutable self, value: UnityEngine::Color)
    = extern self.selectedColor = value
}
