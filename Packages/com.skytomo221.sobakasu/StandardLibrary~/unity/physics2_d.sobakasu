  pub static fn default_raycast_layers -> i32
    = extern Self.DefaultRaycastLayers

  pub static fn ignore_raycast_layer -> i32
    = extern Self.IgnoreRaycastLayer

  pub static fn max_polygon_shape_vertices -> i32
    = extern Self.MaxPolygonShapeVertices
}
