use maybe::Maybe;

public enum RenderTextureCreationFlags = extern UnityEngine.RenderTextureCreationFlags {
  AllowVerticalFlip = extern AllowVerticalFlip,
  AutoGenerateMips = extern AutoGenerateMips,
  BindMS = extern BindMS,
  CreatedFromScript = extern CreatedFromScript,
  DynamicallyScalable = extern DynamicallyScalable,
  EnableRandomWrite = extern EnableRandomWrite,
  EyeTexture = extern EyeTexture,
  MipMap = extern MipMap,
  NoResolvedColorSurface = extern NoResolvedColorSurface,
  SRGB = extern SRGB,
}
