use maybe::Maybe;

public struct RaycastHit = extern UnityEngine.RaycastHit {
}

implementation RaycastHit {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function articulation_body(self) -> Maybe<UnityEngine::ArticulationBody>
    = maybe extern self.articulationBody

  public function barycentric_coordinate(self) -> UnityEngine::Vector3
    = extern self.barycentricCoordinate

  public function collider_instance_id(self) -> i32
    = extern self.colliderInstanceID

  public function collider(self) -> Maybe<UnityEngine::Collider>
    = maybe extern self.collider

  public function distance(self) -> f32
    = extern self.distance

  public function lightmap_coord(self) -> UnityEngine::Vector2
    = extern self.lightmapCoord

  public function normal(self) -> UnityEngine::Vector3
    = extern self.normal

  public function point(self) -> UnityEngine::Vector3
    = extern self.point

  public function rigidbody(self) -> Maybe<UnityEngine::Rigidbody>
    = maybe extern self.rigidbody

  public function texture_coord2(self) -> UnityEngine::Vector2
    = extern self.textureCoord2

  public function texture_coord(self) -> UnityEngine::Vector2
    = extern self.textureCoord

  public function transform(self) -> Maybe<UnityEngine::Transform>
    = maybe extern self.transform

  public function triangle_index(self) -> i32
    = extern self.triangleIndex

  public function set_barycentric_coordinate(mutable self, value: UnityEngine::Vector3)
    = extern self.barycentricCoordinate = value

  public function set_distance(mutable self, value: f32)
    = extern self.distance = value

  public function set_normal(mutable self, value: UnityEngine::Vector3)
    = extern self.normal = value

  public function set_point(mutable self, value: UnityEngine::Vector3)
    = extern self.point = value
}
