pub struct SoftJointLimitSpring = extern UnityEngine.SoftJointLimitSpring {
}

impl SoftJointLimitSpring {
  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn damper(self) -> f32
    = extern self.damper

  pub fn spring(self) -> f32
    = extern self.spring

  pub fn set_damper(self, value: f32)
    = extern self.damper = value

  pub fn set_spring(self, value: f32)
    = extern self.spring = value
}
