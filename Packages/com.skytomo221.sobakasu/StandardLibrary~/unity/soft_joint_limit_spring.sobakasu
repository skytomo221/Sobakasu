public struct SoftJointLimitSpring = extern UnityEngine.SoftJointLimitSpring {
}

implementation SoftJointLimitSpring {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function damper(self) -> f32
    = extern self.damper

  public function spring(self) -> f32
    = extern self.spring

  public function set_damper(self, value: f32)
    = extern self.damper = value

  public function set_spring(self, value: f32)
    = extern self.spring = value
}
