use maybe::Maybe;

public struct Particle = extern UnityEngine.ParticleSystem+Particle {
}

implementation Particle {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_current_color(mutable self, system: UnityEngine::ParticleSystem) -> UnityEngine::Color32
    = extern self.GetCurrentColor(system)

  public function get_current_size3_d(mutable self, system: UnityEngine::ParticleSystem) -> UnityEngine::Vector3
    = extern self.GetCurrentSize3D(system)

  public function get_current_size(mutable self, system: UnityEngine::ParticleSystem) -> f32
    = extern self.GetCurrentSize(system)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_mesh_index(mutable self, system: UnityEngine::ParticleSystem) -> i32
    = extern self.GetMeshIndex(system)

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function set_mesh_index(mutable self, index: i32)
    = extern self.SetMeshIndex(index)

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function angular_velocity3_d(mutable self) -> UnityEngine::Vector3
    = extern self.angularVelocity3D

  public function angular_velocity(mutable self) -> f32
    = extern self.angularVelocity

  public function animated_velocity(mutable self) -> UnityEngine::Vector3
    = extern self.animatedVelocity

  public function axis_of_rotation(mutable self) -> UnityEngine::Vector3
    = extern self.axisOfRotation

  public function position(mutable self) -> UnityEngine::Vector3
    = extern self.position

  public function random_seed(mutable self) -> u32
    = extern self.randomSeed

  public function remaining_lifetime(mutable self) -> f32
    = extern self.remainingLifetime

  public function rotation3_d(mutable self) -> UnityEngine::Vector3
    = extern self.rotation3D

  public function rotation(mutable self) -> f32
    = extern self.rotation

  public function start_color(mutable self) -> UnityEngine::Color32
    = extern self.startColor

  public function start_lifetime(mutable self) -> f32
    = extern self.startLifetime

  public function start_size3_d(mutable self) -> UnityEngine::Vector3
    = extern self.startSize3D

  public function start_size(mutable self) -> f32
    = extern self.startSize

  public function total_velocity(mutable self) -> UnityEngine::Vector3
    = extern self.totalVelocity

  public function velocity(mutable self) -> UnityEngine::Vector3
    = extern self.velocity

  public function set_angular_velocity3_d(mutable self, value: UnityEngine::Vector3)
    = extern self.angularVelocity3D = value

  public function set_angular_velocity(mutable self, value: f32)
    = extern self.angularVelocity = value

  public function set_axis_of_rotation(mutable self, value: UnityEngine::Vector3)
    = extern self.axisOfRotation = value

  public function set_position(mutable self, value: UnityEngine::Vector3)
    = extern self.position = value

  public function set_random_seed(mutable self, value: u32)
    = extern self.randomSeed = value

  public function set_remaining_lifetime(mutable self, value: f32)
    = extern self.remainingLifetime = value

  public function set_rotation3_d(mutable self, value: UnityEngine::Vector3)
    = extern self.rotation3D = value

  public function set_rotation(mutable self, value: f32)
    = extern self.rotation = value

  public function set_start_color(mutable self, value: UnityEngine::Color32)
    = extern self.startColor = value

  public function set_start_lifetime(mutable self, value: f32)
    = extern self.startLifetime = value

  public function set_start_size3_d(mutable self, value: UnityEngine::Vector3)
    = extern self.startSize3D = value

  public function set_start_size(mutable self, value: f32)
    = extern self.startSize = value

  public function set_velocity(mutable self, value: UnityEngine::Vector3)
    = extern self.velocity = value
}
