pub impl Color32 = extern UnityEngine.Color32 {
  pub static fn new(r: u8, g: u8, b: u8, a: u8) -> Self
    = extern new Self(r, g, b, a)

  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn lerp_unclamped(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Color32.LerpUnclamped(a, b, t)

  pub static fn lerp(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Color32.Lerp(a, b, t)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub static fn op_implicit(c: Self) -> UnityEngine.Color
    = extern UnityEngine.Color32.op_Implicit(c)

  pub static fn op_implicit(c: UnityEngine.Color) -> Self
    = extern UnityEngine.Color32.op_Implicit(c)

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn to_string() -> string
    = extern self.ToString()

  pub fn to_string(format: string) -> string
    = extern self.ToString(format)

  pub fn to_string(format: string, format_provider: System.IFormatProvider) -> string
    = extern self.ToString(format, format_provider)

  pub fn a -> u8
    = extern self.a

  pub fn b -> u8
    = extern self.b

  pub fn g -> u8
    = extern self.g

  pub fn r -> u8
    = extern self.r

  pub fn set_a(value: u8)
    = extern self.a = value

  pub fn set_b(value: u8)
    = extern self.b = value

  pub fn set_g(value: u8)
    = extern self.g = value

  pub fn set_r(value: u8)
    = extern self.r = value
}
