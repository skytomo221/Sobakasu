pub impl Bounds = extern UnityEngine.Bounds {
  pub static fn new(center: UnityEngine.Vector3, size: UnityEngine.Vector3) -> Self
    = extern new Self(center, size)

  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub static fn op_equality(lhs: Self, rhs: Self) -> bool
    = extern UnityEngine.Bounds.op_Equality(lhs, rhs)

  pub static fn op_inequality(lhs: Self, rhs: Self) -> bool
    = extern UnityEngine.Bounds.op_Inequality(lhs, rhs)

  pub fn closest_point(point: UnityEngine.Vector3) -> UnityEngine.Vector3
    = extern self.ClosestPoint(point)

  pub fn contains(point: UnityEngine.Vector3) -> bool
    = extern self.Contains(point)

  pub fn encapsulate(bounds: Self)
    = extern self.Encapsulate(bounds)

  pub fn encapsulate(point: UnityEngine.Vector3)
    = extern self.Encapsulate(point)

  pub fn equals(other: object) -> bool
    = extern self.Equals(other)

  pub fn equals(other: Self) -> bool
    = extern self.Equals(other)

  pub fn expand(amount: f32)
    = extern self.Expand(amount)

  pub fn expand(amount: UnityEngine.Vector3)
    = extern self.Expand(amount)

  pub fn get_hash_code() -> i32
    = extern self.GetHashCode()

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn intersects(bounds: Self) -> bool
    = extern self.Intersects(bounds)

  pub fn set_min_max(min: UnityEngine.Vector3, max: UnityEngine.Vector3)
    = extern self.SetMinMax(min, max)

  pub fn sqr_distance(point: UnityEngine.Vector3) -> f32
    = extern self.SqrDistance(point)

  pub fn to_string() -> string
    = extern self.ToString()

  pub fn to_string(format: string) -> string
    = extern self.ToString(format)

  pub fn to_string(format: string, format_provider: System.IFormatProvider) -> string
    = extern self.ToString(format, format_provider)

  pub fn center -> UnityEngine.Vector3
    = extern self.center

  pub fn extents -> UnityEngine.Vector3
    = extern self.extents

  pub fn max -> UnityEngine.Vector3
    = extern self.max

  pub fn min -> UnityEngine.Vector3
    = extern self.min

  pub fn size -> UnityEngine.Vector3
    = extern self.size

  pub fn set_center(value: UnityEngine.Vector3)
    = extern self.center = value

  pub fn set_extents(value: UnityEngine.Vector3)
    = extern self.extents = value

  pub fn set_max(value: UnityEngine.Vector3)
    = extern self.max = value

  pub fn set_min(value: UnityEngine.Vector3)
    = extern self.min = value

  pub fn set_size(value: UnityEngine.Vector3)
    = extern self.size = value
}
