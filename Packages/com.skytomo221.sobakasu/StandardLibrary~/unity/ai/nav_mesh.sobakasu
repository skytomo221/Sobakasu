  = extern UnityEngine.AI.NavMesh.GetSettingsByID(agent_type_id)

pub fn get_settings_by_index(index: i32) -> UnityEngine.AI.NavMeshBuildSettings
  = extern UnityEngine.AI.NavMesh.GetSettingsByIndex(index)

pub fn get_settings_count() -> i32
  = extern UnityEngine.AI.NavMesh.GetSettingsCount()

pub fn get_settings_name_from_id(agent_type_id: i32) -> string
  = extern UnityEngine.AI.NavMesh.GetSettingsNameFromID(agent_type_id)

pub fn raycast(source_position: UnityEngine.Vector3, target_position: UnityEngine.Vector3, area_mask: i32) -> (bool, UnityEngine.AI.NavMeshHit)
