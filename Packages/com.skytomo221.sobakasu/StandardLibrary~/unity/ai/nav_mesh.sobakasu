pub fn add_link(link: UnityEngine.AI.NavMeshLinkData) -> UnityEngine.AI.NavMeshLinkInstance
  = extern UnityEngine.AI.NavMesh.AddLink(link)

pub fn add_link(link: UnityEngine.AI.NavMeshLinkData, position: UnityEngine.Vector3, rotation: UnityEngine.Quaternion) -> UnityEngine.AI.NavMeshLinkInstance
  = extern UnityEngine.AI.NavMesh.AddLink(link, position, rotation)

pub fn add_nav_mesh_data(nav_mesh_data: UnityEngine.AI.NavMeshData) -> UnityEngine.AI.NavMeshDataInstance
  = extern UnityEngine.AI.NavMesh.AddNavMeshData(nav_mesh_data)

pub fn add_nav_mesh_data(nav_mesh_data: UnityEngine.AI.NavMeshData, position: UnityEngine.Vector3, rotation: UnityEngine.Quaternion) -> UnityEngine.AI.NavMeshDataInstance
  = extern UnityEngine.AI.NavMesh.AddNavMeshData(nav_mesh_data, position, rotation)

pub fn calculate_path(source_position: UnityEngine.Vector3, target_position: UnityEngine.Vector3, area_mask: i32, path: UnityEngine.AI.NavMeshPath) -> bool
  = extern UnityEngine.AI.NavMesh.CalculatePath(source_position, target_position, area_mask, path)

pub fn calculate_path(source_position: UnityEngine.Vector3, target_position: UnityEngine.Vector3, filter: UnityEngine.AI.NavMeshQueryFilter, path: UnityEngine.AI.NavMeshPath) -> bool
  = extern UnityEngine.AI.NavMesh.CalculatePath(source_position, target_position, filter, path)

pub fn calculate_triangulation() -> UnityEngine.AI.NavMeshTriangulation
  = extern UnityEngine.AI.NavMesh.CalculateTriangulation()

pub fn create_settings() -> UnityEngine.AI.NavMeshBuildSettings
  = extern UnityEngine.AI.NavMesh.CreateSettings()

pub fn equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.Equals(obj_a, obj_b)

pub fn find_closest_edge(source_position: UnityEngine.Vector3, area_mask: i32) -> (bool, UnityEngine.AI.NavMeshHit)
  = extern UnityEngine.AI.NavMesh.FindClosestEdge(UnityEngine.Vector3 source_position, out UnityEngine.AI.NavMeshHit hit, i32 area_mask)

pub fn find_closest_edge(source_position: UnityEngine.Vector3, filter: UnityEngine.AI.NavMeshQueryFilter) -> (bool, UnityEngine.AI.NavMeshHit)
  = extern UnityEngine.AI.NavMesh.FindClosestEdge(UnityEngine.Vector3 source_position, out UnityEngine.AI.NavMeshHit hit, UnityEngine.AI.NavMeshQueryFilter filter)

