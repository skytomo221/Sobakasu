  = extern UnityEngine.AI.NavMesh.Raycast(UnityEngine.Vector3 source_position, UnityEngine.Vector3 target_position, out UnityEngine.AI.NavMeshHit hit, UnityEngine.AI.NavMeshQueryFilter filter)

