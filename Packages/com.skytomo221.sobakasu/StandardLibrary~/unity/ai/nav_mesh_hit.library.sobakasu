use maybe::Maybe;

public struct NavMeshHit = extern UnityEngine.AI.NavMeshHit {
}

implementation NavMeshHit {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function distance(mutable self) -> f32
    = extern self.distance

  public function hit(mutable self) -> bool
    = extern self.hit

  public function mask(mutable self) -> i32
    = extern self.mask

  public function normal(mutable self) -> UnityEngine::Vector3
    = extern self.normal

  public function position(mutable self) -> UnityEngine::Vector3
    = extern self.position

  public function set_distance(mutable self, value: f32)
    = extern self.distance = value

  public function set_hit(mutable self, value: bool)
    = extern self.hit = value

  public function set_mask(mutable self, value: i32)
    = extern self.mask = value

  public function set_normal(mutable self, value: UnityEngine::Vector3)
    = extern self.normal = value

  public function set_position(mutable self, value: UnityEngine::Vector3)
    = extern self.position = value
}
