use maybe::Maybe;

public struct OffMeshLinkData = extern UnityEngine.AI.OffMeshLinkData {
}

implementation OffMeshLinkData {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function activated(mutable self) -> bool
    = extern self.activated

  public function end_pos(mutable self) -> UnityEngine::Vector3
    = extern self.endPos

  public function link_type(mutable self) -> UnityEngine::AI::OffMeshLinkType
    = extern self.linkType

  public function off_mesh_link(mutable self) -> Maybe<UnityEngine::AI::OffMeshLink>
    = maybe extern self.offMeshLink

  public function start_pos(mutable self) -> UnityEngine::Vector3
    = extern self.startPos

  public function valid(mutable self) -> bool
    = extern self.valid
}
