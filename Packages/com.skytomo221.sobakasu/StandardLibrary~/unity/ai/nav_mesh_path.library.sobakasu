use maybe::Maybe;

public type NavMeshPath = extern UnityEngine.AI.NavMeshPath;

implementation NavMeshPath {
  public function new() -> Self
    = extern new Self()

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function clear_corners(self)
    = extern self.ClearCorners()

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_corners_non_alloc(self, results: [UnityEngine::Vector3]) -> i32
    = extern self.GetCornersNonAlloc(results)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function to_string(self) -> Maybe<string>
    = maybe extern self.ToString()

  public function corners(self) -> Maybe<[UnityEngine::Vector3]>
    = maybe extern self.corners

  public function status(self) -> UnityEngine::AI::NavMeshPathStatus
    = extern self.status
}
