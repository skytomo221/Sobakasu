use maybe::Maybe;

public enum CollisionFlags = extern UnityEngine.CollisionFlags {
  Above = extern Above,
  Below = extern Below,
  CollidedAbove = extern CollidedAbove,
  CollidedBelow = extern CollidedBelow,
  CollidedSides = extern CollidedSides,
  None = extern None,
  Sides = extern Sides,
}
