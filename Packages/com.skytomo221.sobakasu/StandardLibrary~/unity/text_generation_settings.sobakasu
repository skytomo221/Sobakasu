pub struct TextGenerationSettings = extern UnityEngine.TextGenerationSettings {
  align_by_geometry: bool = extern alignByGeometry,
  color: UnityEngine.Color = extern color,
  font_size: i32 = extern fontSize,
  font_style: UnityEngine.FontStyle = extern fontStyle,
  font: UnityEngine.Font = extern font,
  generate_out_of_bounds: bool = extern generateOutOfBounds,
  generation_extents: UnityEngine.Vector2 = extern generationExtents,
  horizontal_overflow: UnityEngine.HorizontalWrapMode = extern horizontalOverflow,
  line_spacing: f32 = extern lineSpacing,
  pivot: UnityEngine.Vector2 = extern pivot,
  resize_text_for_best_fit: bool = extern resizeTextForBestFit,
  resize_text_max_size: i32 = extern resizeTextMaxSize,
  resize_text_min_size: i32 = extern resizeTextMinSize,
  rich_text: bool = extern richText,
  scale_factor: f32 = extern scaleFactor,
  text_anchor: UnityEngine.TextAnchor = extern textAnchor,
  update_bounds: bool = extern updateBounds,
  vertical_overflow: UnityEngine.VerticalWrapMode = extern verticalOverflow,
}

impl TextGenerationSettings {
  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn equals(other: Self) -> bool
    = extern self.Equals(other)

  pub fn get_type() -> System.Type
    = extern self.GetType()
}
