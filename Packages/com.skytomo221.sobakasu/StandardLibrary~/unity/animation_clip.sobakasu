pub impl AnimationClip = extern UnityEngine.AnimationClip {
  pub static fn destroy_immediate(obj: UnityEngine.Object)
    = extern UnityEngine.Object.DestroyImmediate(obj)

  pub static fn destroy_immediate(obj: UnityEngine.Object, allow_destroying_assets: bool)
    = extern UnityEngine.Object.DestroyImmediate(obj, allow_destroying_assets)

  pub static fn destroy(obj: UnityEngine.Object)
    = extern UnityEngine.Object.Destroy(obj)

  pub static fn destroy(obj: UnityEngine.Object, t: f32)
    = extern UnityEngine.Object.Destroy(obj, t)

  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn clear_curves()
    = extern self.ClearCurves()

  pub fn ensure_quaternion_continuity()
    = extern self.EnsureQuaternionContinuity()

  pub fn equals(other: object) -> bool
    = extern self.Equals(other)

  pub fn get_hash_code() -> i32
    = extern self.GetHashCode()

  pub fn get_instance_id() -> i32
    = extern self.GetInstanceID()

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn sample_animation(go: UnityEngine.GameObject, time: f32)
    = extern self.SampleAnimation(go, time)

  pub fn set_curve(relative_path: string, type: System.Type, property_name: string, curve: UnityEngine.AnimationCurve)
    = extern self.SetCurve(relative_path, type, property_name, curve)

  pub fn to_string() -> string
    = extern self.ToString()

  pub fn apparent_speed -> f32
    = extern self.apparentSpeed

  pub fn average_angular_speed -> f32
    = extern self.averageAngularSpeed

  pub fn average_duration -> f32
    = extern self.averageDuration

  pub fn average_speed -> UnityEngine.Vector3
    = extern self.averageSpeed

  pub fn empty -> bool
    = extern self.empty

  pub fn frame_rate -> f32
    = extern self.frameRate

  pub fn has_generic_root_transform -> bool
    = extern self.hasGenericRootTransform

  pub fn has_motion_curves -> bool
    = extern self.hasMotionCurves

  pub fn has_motion_float_curves -> bool
    = extern self.hasMotionFloatCurves

  pub fn has_root_curves -> bool
    = extern self.hasRootCurves

  pub fn human_motion -> bool
    = extern self.humanMotion

  pub fn human_motion? -> bool
    = extern self.isHumanMotion

  pub fn looping? -> bool
    = extern self.isLooping

  pub fn length -> f32
    = extern self.length

  pub fn local_bounds -> UnityEngine.Bounds
    = extern self.localBounds

  pub fn name -> string
    = extern self.name

  pub fn wrap_mode -> UnityEngine.WrapMode
    = extern self.wrapMode

  pub fn set_frame_rate(value: f32)
    = extern self.frameRate = value

  pub fn set_local_bounds(value: UnityEngine.Bounds)
    = extern self.localBounds = value

  pub fn set_name(value: string)
    = extern self.name = value

  pub fn set_wrap_mode(value: UnityEngine.WrapMode)
    = extern self.wrapMode = value
}
