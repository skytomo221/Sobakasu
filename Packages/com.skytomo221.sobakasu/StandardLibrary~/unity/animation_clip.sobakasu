public type AnimationClip = extern UnityEngine.AnimationClip;

implementation AnimationClip {
  public function destroy_immediate(obj: UnityEngine::Object)
    = extern UnityEngine.Object.DestroyImmediate(obj)

  public function destroy_immediate(obj: UnityEngine::Object, allow_destroying_assets: bool)
    = extern UnityEngine.Object.DestroyImmediate(obj, allow_destroying_assets)

  public function destroy(obj: UnityEngine::Object)
    = extern UnityEngine.Object.Destroy(obj)

  public function destroy(obj: UnityEngine::Object, t: f32)
    = extern UnityEngine.Object.Destroy(obj, t)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function clear_curves(self)
    = extern self.ClearCurves()

  public function ensure_quaternion_continuity(self)
    = extern self.EnsureQuaternionContinuity()

  public function equals(self, other: object) -> bool
    = extern self.Equals(other)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_instance_id(self) -> i32
    = extern self.GetInstanceID()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function sample_animation(self, go: UnityEngine::GameObject, time: f32)
    = extern self.SampleAnimation(go, time)

  public function set_curve(self, relative_path: string, type_: System::Type, property_name: string, curve: UnityEngine::AnimationCurve)
    = extern self.SetCurve(relative_path, type_, property_name, curve)

  public function to_string(self) -> string
    = extern self.ToString()

  public function apparent_speed(self) -> f32
    = extern self.apparentSpeed

  public function average_angular_speed(self) -> f32
    = extern self.averageAngularSpeed

  public function average_duration(self) -> f32
    = extern self.averageDuration

  public function average_speed(self) -> UnityEngine::Vector3
    = extern self.averageSpeed

  public function empty(self) -> bool
    = extern self.empty

  public function frame_rate(self) -> f32
    = extern self.frameRate

  public function has_generic_root_transform(self) -> bool
    = extern self.hasGenericRootTransform

  public function has_motion_curves(self) -> bool
    = extern self.hasMotionCurves

  public function has_motion_float_curves(self) -> bool
    = extern self.hasMotionFloatCurves

  public function has_root_curves(self) -> bool
    = extern self.hasRootCurves

  public function human_motion(self) -> bool
    = extern self.humanMotion

  public function human_motion?(self) -> bool
    = extern self.isHumanMotion

  public function looping?(self) -> bool
    = extern self.isLooping

  public function length(self) -> f32
    = extern self.length

  public function local_bounds(self) -> UnityEngine::Bounds
    = extern self.localBounds

  public function name(self) -> string
    = extern self.name

  public function wrap_mode(self) -> UnityEngine::WrapMode
    = extern self.wrapMode

  public function set_frame_rate(self, value: f32)
    = extern self.frameRate = value

  public function set_local_bounds(self, value: UnityEngine::Bounds)
    = extern self.localBounds = value

  public function set_name(self, value: string)
    = extern self.name = value

  public function set_wrap_mode(self, value: UnityEngine::WrapMode)
    = extern self.wrapMode = value
}
