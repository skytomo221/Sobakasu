public type Gradient = extern UnityEngine.Gradient;

implementation Gradient {
  public function new() -> Self
    = extern new Self()

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(self, o: object) -> bool
    = extern self.Equals(o)

  public function equals(self, other: Self) -> bool
    = extern self.Equals(other)

  public function evaluate(self, time: f32) -> UnityEngine::Color
    = extern self.Evaluate(time)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function set_keys(self, color_keys: [UnityEngine::GradientColorKey], alpha_keys: [UnityEngine::GradientAlphaKey])
    = extern self.SetKeys(color_keys, alpha_keys)

  public function to_string(self) -> string
    = extern self.ToString()

  public function alpha_keys(self) -> [UnityEngine::GradientAlphaKey]
    = extern self.alphaKeys

  public function color_keys(self) -> [UnityEngine::GradientColorKey]
    = extern self.colorKeys

  public function color_space(self) -> UnityEngine::ColorSpace
    = extern self.colorSpace

  public function mode(self) -> UnityEngine::GradientMode
    = extern self.mode

  public function set_alpha_keys(self, value: [UnityEngine::GradientAlphaKey])
    = extern self.alphaKeys = value

  public function set_color_keys(self, value: [UnityEngine::GradientColorKey])
    = extern self.colorKeys = value

  public function set_color_space(self, value: UnityEngine::ColorSpace)
    = extern self.colorSpace = value

  public function set_mode(self, value: UnityEngine::GradientMode)
    = extern self.mode = value
}
