pub fn draw_wire_sphere(center: UnityEngine.Vector3, radius: f32)
  = extern UnityEngine.Gizmos.DrawWireSphere(center, radius)

pub fn equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.Equals(obj_a, obj_b)

pub fn reference_equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.ReferenceEquals(obj_a, obj_b)

pub fn color -> UnityEngine.Color
  = extern UnityEngine.Gizmos.color

pub fn matrix -> UnityEngine.Matrix4x4
  = extern UnityEngine.Gizmos.matrix

pub fn probe_size -> f32
  = extern UnityEngine.Gizmos.probeSize

pub fn set_color(value: UnityEngine.Color)
  = extern UnityEngine.Gizmos.color = value

pub fn set_matrix(value: UnityEngine.Matrix4x4)
  = extern UnityEngine.Gizmos.matrix = value
