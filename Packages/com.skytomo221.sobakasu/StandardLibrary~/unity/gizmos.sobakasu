  = extern UnityEngine.Gizmos.DrawWireMesh(mesh, position)

pub fn draw_wire_mesh(mesh: UnityEngine.Mesh, position: UnityEngine.Vector3, rotation: UnityEngine.Quaternion)
  = extern UnityEngine.Gizmos.DrawWireMesh(mesh, position, rotation)

pub fn draw_wire_mesh(mesh: UnityEngine.Mesh, position: UnityEngine.Vector3, rotation: UnityEngine.Quaternion, scale: UnityEngine.Vector3)
