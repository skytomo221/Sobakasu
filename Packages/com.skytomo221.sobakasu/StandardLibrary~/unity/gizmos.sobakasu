  = extern UnityEngine.Gizmos.DrawGUITexture(screen_rect, texture)

pub fn draw_gui_texture(screen_rect: UnityEngine.Rect, texture: UnityEngine.Texture, left_border: i32, right_border: i32, top_border: i32, bottom_border: i32)
  = extern UnityEngine.Gizmos.DrawGUITexture(screen_rect, texture, left_border, right_border, top_border, bottom_border)

pub fn draw_gui_texture(screen_rect: UnityEngine.Rect, texture: UnityEngine.Texture, left_border: i32, right_border: i32, top_border: i32, bottom_border: i32, mat: UnityEngine.Material)
  = extern UnityEngine.Gizmos.DrawGUITexture(screen_rect, texture, left_border, right_border, top_border, bottom_border, mat)

pub fn draw_gui_texture(screen_rect: UnityEngine.Rect, texture: UnityEngine.Texture, mat: UnityEngine.Material)
  = extern UnityEngine.Gizmos.DrawGUITexture(screen_rect, texture, mat)

pub fn draw_icon(center: UnityEngine.Vector3, name: string)
  = extern UnityEngine.Gizmos.DrawIcon(center, name)

pub fn draw_icon(center: UnityEngine.Vector3, name: string, allow_scaling: bool)
  = extern UnityEngine.Gizmos.DrawIcon(center, name, allow_scaling)

pub fn draw_icon(center: UnityEngine.Vector3, name: string, allow_scaling: bool, tint: UnityEngine.Color)
  = extern UnityEngine.Gizmos.DrawIcon(center, name, allow_scaling, tint)

pub fn draw_line(from: UnityEngine.Vector3, to_: UnityEngine.Vector3)
  = extern UnityEngine.Gizmos.DrawLine(from, to_)

pub fn draw_ray(r: UnityEngine.Ray)
  = extern UnityEngine.Gizmos.DrawRay(r)

pub fn draw_ray(from: UnityEngine.Vector3, direction: UnityEngine.Vector3)
  = extern UnityEngine.Gizmos.DrawRay(from, direction)

pub fn draw_sphere(center: UnityEngine.Vector3, radius: f32)
  = extern UnityEngine.Gizmos.DrawSphere(center, radius)

pub fn draw_wire_cube(center: UnityEngine.Vector3, size: UnityEngine.Vector3)
  = extern UnityEngine.Gizmos.DrawWireCube(center, size)

pub fn draw_wire_mesh(mesh: UnityEngine.Mesh)
  = extern UnityEngine.Gizmos.DrawWireMesh(mesh)

pub fn draw_wire_mesh(mesh: UnityEngine.Mesh, submesh_index: i32)
  = extern UnityEngine.Gizmos.DrawWireMesh(mesh, submesh_index)

