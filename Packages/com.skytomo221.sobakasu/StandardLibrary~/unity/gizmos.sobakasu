pub fn draw_cube(center: UnityEngine.Vector3, size: UnityEngine.Vector3)
  = extern UnityEngine.Gizmos.DrawCube(center, size)

pub fn draw_frustum(center: UnityEngine.Vector3, fov: f32, max_range: f32, min_range: f32, aspect: f32)
  = extern UnityEngine.Gizmos.DrawFrustum(center, fov, max_range, min_range, aspect)

