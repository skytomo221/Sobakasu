use maybe::Maybe;

public struct CombineInstance = extern UnityEngine.CombineInstance {
}

implementation CombineInstance {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function lightmap_scale_offset(mutable self) -> UnityEngine::Vector4
    = extern self.lightmapScaleOffset

  public function mesh(mutable self) -> Maybe<UnityEngine::Mesh>
    = maybe extern self.mesh

  public function realtime_lightmap_scale_offset(mutable self) -> UnityEngine::Vector4
    = extern self.realtimeLightmapScaleOffset

  public function sub_mesh_index(mutable self) -> i32
    = extern self.subMeshIndex

  public function transform(mutable self) -> UnityEngine::Matrix4x4
    = extern self.transform

  public function set_lightmap_scale_offset(mutable self, value: UnityEngine::Vector4)
    = extern self.lightmapScaleOffset = value

  public function set_mesh(mutable self, value: UnityEngine::Mesh)
    = extern self.mesh = value

  public function set_realtime_lightmap_scale_offset(mutable self, value: UnityEngine::Vector4)
    = extern self.realtimeLightmapScaleOffset = value

  public function set_sub_mesh_index(mutable self, value: i32)
    = extern self.subMeshIndex = value

  public function set_transform(mutable self, value: UnityEngine::Matrix4x4)
    = extern self.transform = value
}
