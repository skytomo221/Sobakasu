public struct JointMotor = extern UnityEngine.JointMotor {
}

implementation JointMotor {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function force(self) -> f32
    = extern self.force

  public function free_spin(self) -> bool
    = extern self.freeSpin

  public function target_velocity(self) -> f32
    = extern self.targetVelocity

  public function set_force(self, value: f32)
    = extern self.force = value

  public function set_free_spin(self, value: bool)
    = extern self.freeSpin = value

  public function set_target_velocity(self, value: f32)
    = extern self.targetVelocity = value
}
