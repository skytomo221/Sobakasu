public struct CustomDataModule = extern UnityEngine.ParticleSystem.CustomDataModule {
}

implementation CustomDataModule {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function get_color(self, stream: UnityEngine::ParticleSystemCustomData) -> UnityEngine::ParticleSystem::MinMaxGradient
    = extern self.GetColor(stream)

  public function get_mode(self, stream: UnityEngine::ParticleSystemCustomData) -> UnityEngine::ParticleSystemCustomDataMode
    = extern self.GetMode(stream)

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function get_vector_component_count(self, stream: UnityEngine::ParticleSystemCustomData) -> i32
    = extern self.GetVectorComponentCount(stream)

  public function get_vector(self, stream: UnityEngine::ParticleSystemCustomData, component: i32) -> UnityEngine::ParticleSystem::MinMaxCurve
    = extern self.GetVector(stream, component)

  public function set_color(self, stream: UnityEngine::ParticleSystemCustomData, gradient: UnityEngine::ParticleSystem::MinMaxGradient)
    = extern self.SetColor(stream, gradient)

  public function set_mode(self, stream: UnityEngine::ParticleSystemCustomData, mode: UnityEngine::ParticleSystemCustomDataMode)
    = extern self.SetMode(stream, mode)

  public function set_vector_component_count(self, stream: UnityEngine::ParticleSystemCustomData, count: i32)
    = extern self.SetVectorComponentCount(stream, count)

  public function set_vector(self, stream: UnityEngine::ParticleSystemCustomData, component: i32, curve: UnityEngine::ParticleSystem::MinMaxCurve)
    = extern self.SetVector(stream, component, curve)

  public function enabled(self) -> bool
    = extern self.enabled

  public function set_enabled(self, value: bool)
    = extern self.enabled = value
}
