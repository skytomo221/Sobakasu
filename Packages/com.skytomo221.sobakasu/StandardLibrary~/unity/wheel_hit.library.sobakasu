use maybe::Maybe;

public struct WheelHit = extern UnityEngine.WheelHit {
}

implementation WheelHit {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function collider(mutable self) -> Maybe<UnityEngine::Collider>
    = maybe extern self.collider

  public function force(mutable self) -> f32
    = extern self.force

  public function forward_dir(mutable self) -> UnityEngine::Vector3
    = extern self.forwardDir

  public function forward_slip(mutable self) -> f32
    = extern self.forwardSlip

  public function normal(mutable self) -> UnityEngine::Vector3
    = extern self.normal

  public function point(mutable self) -> UnityEngine::Vector3
    = extern self.point

  public function sideways_dir(mutable self) -> UnityEngine::Vector3
    = extern self.sidewaysDir

  public function sideways_slip(mutable self) -> f32
    = extern self.sidewaysSlip

  public function set_collider(mutable self, value: UnityEngine::Collider)
    = extern self.collider = value

  public function set_force(mutable self, value: f32)
    = extern self.force = value

  public function set_forward_dir(mutable self, value: UnityEngine::Vector3)
    = extern self.forwardDir = value

  public function set_forward_slip(mutable self, value: f32)
    = extern self.forwardSlip = value

  public function set_normal(mutable self, value: UnityEngine::Vector3)
    = extern self.normal = value

  public function set_point(mutable self, value: UnityEngine::Vector3)
    = extern self.point = value

  public function set_sideways_dir(mutable self, value: UnityEngine::Vector3)
    = extern self.sidewaysDir = value

  public function set_sideways_slip(mutable self, value: f32)
    = extern self.sidewaysSlip = value
}
