pub impl AudioClip = extern UnityEngine.AudioClip {
  pub static fn create(name: string, length_samples: i32, channels: i32, frequency: i32, stream: bool) -> Self
    = extern UnityEngine.AudioClip.Create(name, length_samples, channels, frequency, stream)

  pub static fn destroy_immediate(obj: UnityEngine.Object)
    = extern UnityEngine.Object.DestroyImmediate(obj)

  pub static fn destroy_immediate(obj: UnityEngine.Object, allow_destroying_assets: bool)
    = extern UnityEngine.Object.DestroyImmediate(obj, allow_destroying_assets)

  pub static fn destroy(obj: UnityEngine.Object)
    = extern UnityEngine.Object.Destroy(obj)

  pub static fn destroy(obj: UnityEngine.Object, t: f32)
    = extern UnityEngine.Object.Destroy(obj, t)

  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn equals(other: object) -> bool
    = extern self.Equals(other)

  pub fn get_data(data: [f32], offset_samples: i32) -> bool
    = extern self.GetData(data, offset_samples)

  pub fn get_hash_code() -> i32
    = extern self.GetHashCode()

  pub fn get_instance_id() -> i32
    = extern self.GetInstanceID()

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn load_audio_data() -> bool
    = extern self.LoadAudioData()

  pub fn set_data(data: [f32], offset_samples: i32) -> bool
    = extern self.SetData(data, offset_samples)

  pub fn to_string() -> string
    = extern self.ToString()

  pub fn unload_audio_data() -> bool
    = extern self.UnloadAudioData()

  pub fn ambisonic -> bool
    = extern self.ambisonic

  pub fn channels -> i32
    = extern self.channels

  pub fn frequency -> i32
    = extern self.frequency

  pub fn length -> f32
    = extern self.length

  pub fn load_in_background -> bool
    = extern self.loadInBackground

  pub fn load_state -> UnityEngine.AudioDataLoadState
    = extern self.loadState

  pub fn load_type -> UnityEngine.AudioClipLoadType
    = extern self.loadType

  pub fn name -> string
    = extern self.name

  pub fn preload_audio_data -> bool
    = extern self.preloadAudioData

  pub fn samples -> i32
    = extern self.samples

  pub fn set_name(value: string)
    = extern self.name = value
}
