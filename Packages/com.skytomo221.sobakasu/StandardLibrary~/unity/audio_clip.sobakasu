pub type AudioClip = extern UnityEngine.AudioClip;

impl AudioClip {
  pub fn create(name: string, length_samples: i32, channels: i32, frequency: i32, stream: bool) -> Self
    = extern UnityEngine.AudioClip.Create(name, length_samples, channels, frequency, stream)

  pub fn destroy_immediate(obj: UnityEngine::Object)
    = extern UnityEngine.Object.DestroyImmediate(obj)

  pub fn destroy_immediate(obj: UnityEngine::Object, allow_destroying_assets: bool)
    = extern UnityEngine.Object.DestroyImmediate(obj, allow_destroying_assets)

  pub fn destroy(obj: UnityEngine::Object)
    = extern UnityEngine.Object.Destroy(obj)

  pub fn destroy(obj: UnityEngine::Object, t: f32)
    = extern UnityEngine.Object.Destroy(obj, t)

  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn equals(self, other: object) -> bool
    = extern self.Equals(other)

  pub fn get_data(self, data: [f32], offset_samples: i32) -> bool
    = extern self.GetData(data, offset_samples)

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_instance_id(self) -> i32
    = extern self.GetInstanceID()

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn load_audio_data(self) -> bool
    = extern self.LoadAudioData()

  pub fn set_data(self, data: [f32], offset_samples: i32) -> bool
    = extern self.SetData(data, offset_samples)

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn unload_audio_data(self) -> bool
    = extern self.UnloadAudioData()

  pub fn ambisonic(self) -> bool
    = extern self.ambisonic

  pub fn channels(self) -> i32
    = extern self.channels

  pub fn frequency(self) -> i32
    = extern self.frequency

  pub fn length(self) -> f32
    = extern self.length

  pub fn load_in_background(self) -> bool
    = extern self.loadInBackground

  pub fn load_state(self) -> UnityEngine::AudioDataLoadState
    = extern self.loadState

  pub fn load_type(self) -> UnityEngine::AudioClipLoadType
    = extern self.loadType

  pub fn name(self) -> string
    = extern self.name

  pub fn preload_audio_data(self) -> bool
    = extern self.preloadAudioData

  pub fn samples(self) -> i32
    = extern self.samples

  pub fn set_name(self, value: string)
    = extern self.name = value
}
