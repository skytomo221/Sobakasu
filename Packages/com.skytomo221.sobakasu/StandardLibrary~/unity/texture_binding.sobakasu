pub type Texture = extern UnityEngine.Texture;

impl Texture {
  pub fn destroy_immediate(obj: UnityEngine::Object)
    = extern UnityEngine.Object.DestroyImmediate(obj)

  pub fn destroy_immediate(obj: UnityEngine::Object, allow_destroying_assets: bool)
    = extern UnityEngine.Object.DestroyImmediate(obj, allow_destroying_assets)

  pub fn destroy(obj: UnityEngine::Object)
    = extern UnityEngine.Object.Destroy(obj)

  pub fn destroy(obj: UnityEngine::Object, t: f32)
    = extern UnityEngine.Object.Destroy(obj, t)

  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn equals(self, other: object) -> bool
    = extern self.Equals(other)

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_instance_id(self) -> i32
    = extern self.GetInstanceID()

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn increment_update_count(self)
    = extern self.IncrementUpdateCount()

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn aniso_level(self) -> i32
    = extern self.anisoLevel

  pub fn dimension(self) -> UnityEngine::Rendering::TextureDimension
    = extern self.dimension

  pub fn filter_mode(self) -> UnityEngine::FilterMode
    = extern self.filterMode

  pub fn height(self) -> i32
    = extern self.height

  pub fn data_srgb?(self) -> bool
    = extern self.isDataSRGB

  pub fn readable?(self) -> bool
    = extern self.isReadable

  pub fn mip_map_bias(self) -> f32
    = extern self.mipMapBias

  pub fn mipmap_count(self) -> i32
    = extern self.mipmapCount

  pub fn name(self) -> string
    = extern self.name

  pub fn texel_size(self) -> UnityEngine::Vector2
    = extern self.texelSize

  pub fn update_count(self) -> u32
    = extern self.updateCount

  pub fn width(self) -> i32
    = extern self.width

  pub fn wrap_mode_u(self) -> UnityEngine::TextureWrapMode
    = extern self.wrapModeU

  pub fn wrap_mode_v(self) -> UnityEngine::TextureWrapMode
    = extern self.wrapModeV

  pub fn wrap_mode_w(self) -> UnityEngine::TextureWrapMode
    = extern self.wrapModeW

  pub fn wrap_mode(self) -> UnityEngine::TextureWrapMode
    = extern self.wrapMode

  pub fn set_aniso_level(self, value: i32)
    = extern self.anisoLevel = value

  pub fn set_dimension(self, value: UnityEngine::Rendering::TextureDimension)
    = extern self.dimension = value

  pub fn set_filter_mode(self, value: UnityEngine::FilterMode)
    = extern self.filterMode = value

  pub fn set_height(self, value: i32)
    = extern self.height = value

  pub fn set_mip_map_bias(self, value: f32)
    = extern self.mipMapBias = value

  pub fn set_name(self, value: string)
    = extern self.name = value

  pub fn set_width(self, value: i32)
    = extern self.width = value

  pub fn set_wrap_mode_u(self, value: UnityEngine::TextureWrapMode)
    = extern self.wrapModeU = value

  pub fn set_wrap_mode_v(self, value: UnityEngine::TextureWrapMode)
    = extern self.wrapModeV = value

  pub fn set_wrap_mode_w(self, value: UnityEngine::TextureWrapMode)
    = extern self.wrapModeW = value

  pub fn set_wrap_mode(self, value: UnityEngine::TextureWrapMode)
    = extern self.wrapMode = value

  pub fn generate_all_mips -> i32
    = extern UnityEngine.Texture.GenerateAllMips
}
