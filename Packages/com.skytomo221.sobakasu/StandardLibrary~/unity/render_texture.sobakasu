pub type RenderTexture = extern UnityEngine.RenderTexture;

impl RenderTexture {
  pub fn new(width: i32, height: i32, depth: i32) -> Self
    = extern new Self(width, height, depth)

  pub fn new(width: i32, height: i32, depth: i32, format: UnityEngine::RenderTextureFormat) -> Self
    = extern new Self(width, height, depth, format)

  pub fn new(width: i32, height: i32, depth: i32, format: UnityEngine::RenderTextureFormat, mip_count: i32) -> Self
    = extern new Self(width, height, depth, format, mip_count)

  pub fn new(width: i32, height: i32, depth: i32, format: UnityEngine::RenderTextureFormat, read_write: UnityEngine::RenderTextureReadWrite) -> Self
    = extern new Self(width, height, depth, format, read_write)

  pub fn new(texture_to_copy: Self) -> Self
    = extern new Self(texture_to_copy)

  pub fn new(desc: UnityEngine::RenderTextureDescriptor) -> Self
    = extern new Self(desc)

  pub fn destroy_immediate(obj: UnityEngine::Object)
    = extern UnityEngine.Object.DestroyImmediate(obj)

  pub fn destroy_immediate(obj: UnityEngine::Object, allow_destroying_assets: bool)
    = extern UnityEngine.Object.DestroyImmediate(obj, allow_destroying_assets)

  pub fn destroy(obj: UnityEngine::Object)
    = extern UnityEngine.Object.Destroy(obj)

  pub fn destroy(obj: UnityEngine::Object, t: f32)
    = extern UnityEngine.Object.Destroy(obj, t)

  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn supports_stencil(rt: Self) -> bool
    = extern UnityEngine.RenderTexture.SupportsStencil(rt)

  pub fn convert_to_equirect(self, equirect: Self, eye: UnityEngine::Camera::MonoOrStereoscopicEye)
    = extern self.ConvertToEquirect(equirect, eye)

  pub fn create(self) -> bool
    = extern self.Create()

  pub fn discard_contents(self)
    = extern self.DiscardContents()

  pub fn discard_contents(self, discard_color: bool, discard_depth: bool)
    = extern self.DiscardContents(discard_color, discard_depth)

  pub fn equals(self, other: object) -> bool
    = extern self.Equals(other)

  pub fn generate_mips(self)
    = extern self.GenerateMips()

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_instance_id(self) -> i32
    = extern self.GetInstanceID()

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn increment_update_count(self)
    = extern self.IncrementUpdateCount()

  pub fn created?(self) -> bool
    = extern self.IsCreated()

  pub fn release(self)
    = extern self.Release()

  pub fn resolve_anti_aliased_surface(self)
    = extern self.ResolveAntiAliasedSurface()

  pub fn resolve_anti_aliased_surface(self, target: Self)
    = extern self.ResolveAntiAliasedSurface(target)

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn aniso_level(self) -> i32
    = extern self.anisoLevel

  pub fn anti_aliasing(self) -> i32
    = extern self.antiAliasing

  pub fn auto_generate_mips(self) -> bool
    = extern self.autoGenerateMips

  pub fn bind_texture_ms(self) -> bool
    = extern self.bindTextureMS

  pub fn color_buffer(self) -> UnityEngine::RenderBuffer
    = extern self.colorBuffer

  pub fn depth_buffer(self) -> UnityEngine::RenderBuffer
    = extern self.depthBuffer

  pub fn depth(self) -> i32
    = extern self.depth

  pub fn descriptor(self) -> UnityEngine::RenderTextureDescriptor
    = extern self.descriptor

  pub fn dimension(self) -> UnityEngine::Rendering::TextureDimension
    = extern self.dimension

  pub fn enable_random_write(self) -> bool
    = extern self.enableRandomWrite

  pub fn filter_mode(self) -> UnityEngine::FilterMode
    = extern self.filterMode

  pub fn format(self) -> UnityEngine::RenderTextureFormat
    = extern self.format

  pub fn height(self) -> i32
    = extern self.height

  pub fn data_srgb?(self) -> bool
    = extern self.isDataSRGB

  pub fn power_of_two?(self) -> bool
    = extern self.isPowerOfTwo

  pub fn readable?(self) -> bool
    = extern self.isReadable

  pub fn mip_map_bias(self) -> f32
    = extern self.mipMapBias

  pub fn mipmap_count(self) -> i32
    = extern self.mipmapCount

  pub fn name(self) -> string
    = extern self.name

  pub fn s_rgb(self) -> bool
    = extern self.sRGB

  pub fn texel_size(self) -> UnityEngine::Vector2
    = extern self.texelSize

  pub fn update_count(self) -> u32
    = extern self.updateCount

  pub fn use_dynamic_scale(self) -> bool
    = extern self.useDynamicScale

  pub fn use_mip_map(self) -> bool
    = extern self.useMipMap

  pub fn volume_depth(self) -> i32
    = extern self.volumeDepth

  pub fn vr_usage(self) -> UnityEngine::VRTextureUsage
    = extern self.vrUsage

  pub fn width(self) -> i32
    = extern self.width

  pub fn wrap_mode_u(self) -> UnityEngine::TextureWrapMode
    = extern self.wrapModeU

  pub fn wrap_mode_v(self) -> UnityEngine::TextureWrapMode
    = extern self.wrapModeV

  pub fn wrap_mode_w(self) -> UnityEngine::TextureWrapMode
    = extern self.wrapModeW

  pub fn wrap_mode(self) -> UnityEngine::TextureWrapMode
    = extern self.wrapMode

  pub fn set_aniso_level(self, value: i32)
    = extern self.anisoLevel = value

  pub fn set_anti_aliasing(self, value: i32)
    = extern self.antiAliasing = value

  pub fn set_auto_generate_mips(self, value: bool)
    = extern self.autoGenerateMips = value

  pub fn set_bind_texture_ms(self, value: bool)
    = extern self.bindTextureMS = value

  pub fn set_depth(self, value: i32)
    = extern self.depth = value

  pub fn set_descriptor(self, value: UnityEngine::RenderTextureDescriptor)
    = extern self.descriptor = value

  pub fn set_dimension(self, value: UnityEngine::Rendering::TextureDimension)
    = extern self.dimension = value

  pub fn set_enable_random_write(self, value: bool)
    = extern self.enableRandomWrite = value

  pub fn set_filter_mode(self, value: UnityEngine::FilterMode)
    = extern self.filterMode = value

  pub fn set_format(self, value: UnityEngine::RenderTextureFormat)
    = extern self.format = value

  pub fn set_height(self, value: i32)
    = extern self.height = value

  pub fn set_power_of_two(self, value: bool)
    = extern self.isPowerOfTwo = value

  pub fn set_mip_map_bias(self, value: f32)
    = extern self.mipMapBias = value

  pub fn set_name(self, value: string)
    = extern self.name = value

  pub fn set_use_dynamic_scale(self, value: bool)
    = extern self.useDynamicScale = value

  pub fn set_use_mip_map(self, value: bool)
    = extern self.useMipMap = value

  pub fn set_volume_depth(self, value: i32)
    = extern self.volumeDepth = value

  pub fn set_vr_usage(self, value: UnityEngine::VRTextureUsage)
    = extern self.vrUsage = value

  pub fn set_width(self, value: i32)
    = extern self.width = value

  pub fn set_wrap_mode_u(self, value: UnityEngine::TextureWrapMode)
    = extern self.wrapModeU = value

  pub fn set_wrap_mode_v(self, value: UnityEngine::TextureWrapMode)
    = extern self.wrapModeV = value

  pub fn set_wrap_mode_w(self, value: UnityEngine::TextureWrapMode)
    = extern self.wrapModeW = value

  pub fn set_wrap_mode(self, value: UnityEngine::TextureWrapMode)
    = extern self.wrapMode = value

  pub fn generate_all_mips -> i32
    = extern UnityEngine.Texture.GenerateAllMips
}
