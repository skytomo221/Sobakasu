use maybe::Maybe;

public struct ContactPoint2D = extern UnityEngine.ContactPoint2D {
}

implementation ContactPoint2D {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function collider(mutable self) -> Maybe<UnityEngine::Collider2D>
    = maybe extern self.collider

  public function enabled(mutable self) -> bool
    = extern self.enabled

  public function normal_impulse(mutable self) -> f32
    = extern self.normalImpulse

  public function normal(mutable self) -> UnityEngine::Vector2
    = extern self.normal

  public function other_collider(mutable self) -> Maybe<UnityEngine::Collider2D>
    = maybe extern self.otherCollider

  public function other_rigidbody(mutable self) -> Maybe<UnityEngine::Rigidbody2D>
    = maybe extern self.otherRigidbody

  public function point(mutable self) -> UnityEngine::Vector2
    = extern self.point

  public function relative_velocity(mutable self) -> UnityEngine::Vector2
    = extern self.relativeVelocity

  public function rigidbody(mutable self) -> Maybe<UnityEngine::Rigidbody2D>
    = maybe extern self.rigidbody

  public function separation(mutable self) -> f32
    = extern self.separation

  public function tangent_impulse(mutable self) -> f32
    = extern self.tangentImpulse
}
