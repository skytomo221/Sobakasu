use maybe::Maybe;

public struct JointMotor = extern UnityEngine.JointMotor {
}

implementation JointMotor {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function force(mutable self) -> f32
    = extern self.force

  public function free_spin(mutable self) -> bool
    = extern self.freeSpin

  public function target_velocity(mutable self) -> f32
    = extern self.targetVelocity

  public function set_force(mutable self, value: f32)
    = extern self.force = value

  public function set_free_spin(mutable self, value: bool)
    = extern self.freeSpin = value

  public function set_target_velocity(mutable self, value: f32)
    = extern self.targetVelocity = value
}
