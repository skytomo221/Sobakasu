pub type Texture3D = extern UnityEngine.Texture3D;

impl Texture3D {
  pub fn new(width: i32, height: i32, depth: i32, texture_format: UnityEngine::TextureFormat, mip_chain: bool) -> Self
    = extern new Self(width, height, depth, texture_format, mip_chain)

  pub fn new(width: i32, height: i32, depth: i32, texture_format: UnityEngine::TextureFormat, mip_chain: bool, create_uninitialized: bool) -> Self
    = extern new Self(width, height, depth, texture_format, mip_chain, create_uninitialized)

  pub fn new(width: i32, height: i32, depth: i32, texture_format: UnityEngine::TextureFormat, mip_count: i32) -> Self
    = extern new Self(width, height, depth, texture_format, mip_count)

  pub fn destroy_immediate(obj: UnityEngine::Object)
    = extern UnityEngine.Object.DestroyImmediate(obj)

  pub fn destroy_immediate(obj: UnityEngine::Object, allow_destroying_assets: bool)
    = extern UnityEngine.Object.DestroyImmediate(obj, allow_destroying_assets)

  pub fn destroy(obj: UnityEngine::Object)
    = extern UnityEngine.Object.Destroy(obj)

  pub fn destroy(obj: UnityEngine::Object, t: f32)
    = extern UnityEngine.Object.Destroy(obj, t)

  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn apply(self)
    = extern self.Apply()

  pub fn apply(self, update_mipmaps: bool)
    = extern self.Apply(update_mipmaps)

  pub fn apply(self, update_mipmaps: bool, make_no_longer_readable: bool)
    = extern self.Apply(update_mipmaps, make_no_longer_readable)

  pub fn equals(self, other: object) -> bool
    = extern self.Equals(other)

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_instance_id(self) -> i32
    = extern self.GetInstanceID()

  pub fn get_pixel_bilinear(self, u: f32, v: f32, w: f32) -> UnityEngine::Color
    = extern self.GetPixelBilinear(u, v, w)

  pub fn get_pixel_bilinear(self, u: f32, v: f32, w: f32, mip_level: i32) -> UnityEngine::Color
    = extern self.GetPixelBilinear(u, v, w, mip_level)

  pub fn get_pixels32(self) -> [UnityEngine::Color32]
    = extern self.GetPixels32()

  pub fn get_pixels32(self, miplevel: i32) -> [UnityEngine::Color32]
    = extern self.GetPixels32(miplevel)

  pub fn get_pixels(self) -> [UnityEngine::Color]
    = extern self.GetPixels()

  pub fn get_pixels(self, miplevel: i32) -> [UnityEngine::Color]
    = extern self.GetPixels(miplevel)

  pub fn get_pixel(self, x: i32, y: i32, z: i32) -> UnityEngine::Color
    = extern self.GetPixel(x, y, z)

  pub fn get_pixel(self, x: i32, y: i32, z: i32, mip_level: i32) -> UnityEngine::Color
    = extern self.GetPixel(x, y, z, mip_level)

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn increment_update_count(self)
    = extern self.IncrementUpdateCount()

  pub fn set_pixel_data<T>(self, data: [T], mip_level: i32, source_data_start_index: i32)
    = extern self.SetPixelData<T>(data, mip_level, source_data_start_index)

  pub fn set_pixels32(self, colors: [UnityEngine::Color32])
    = extern self.SetPixels32(colors)

  pub fn set_pixels32(self, colors: [UnityEngine::Color32], miplevel: i32)
    = extern self.SetPixels32(colors, miplevel)

  pub fn set_pixels(self, colors: [UnityEngine::Color])
    = extern self.SetPixels(colors)

  pub fn set_pixels(self, colors: [UnityEngine::Color], miplevel: i32)
    = extern self.SetPixels(colors, miplevel)

  pub fn set_pixel(self, x: i32, y: i32, z: i32, color: UnityEngine::Color)
    = extern self.SetPixel(x, y, z, color)

  pub fn set_pixel(self, x: i32, y: i32, z: i32, color: UnityEngine::Color, mip_level: i32)
    = extern self.SetPixel(x, y, z, color, mip_level)

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn aniso_level(self) -> i32
    = extern self.anisoLevel

  pub fn depth(self) -> i32
    = extern self.depth

  pub fn dimension(self) -> UnityEngine::Rendering::TextureDimension
    = extern self.dimension

  pub fn filter_mode(self) -> UnityEngine::FilterMode
    = extern self.filterMode

  pub fn format(self) -> UnityEngine::TextureFormat
    = extern self.format

  pub fn height(self) -> i32
    = extern self.height

  pub fn data_srgb?(self) -> bool
