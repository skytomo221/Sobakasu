pub impl Color = extern UnityEngine.Color {
  pub static fn new(r: f32, g: f32, b: f32) -> Self
    = extern new Self(r, g, b)

  pub static fn new(r: f32, g: f32, b: f32, a: f32) -> Self
    = extern new Self(r, g, b, a)

  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn hsv_to_rgb(h: f32, s: f32, v: f32) -> Self
    = extern UnityEngine.Color.HSVToRGB(h, s, v)

  pub static fn hsv_to_rgb(h: f32, s: f32, v: f32, hdr: bool) -> Self
    = extern UnityEngine.Color.HSVToRGB(h, s, v, hdr)

  pub static fn lerp_unclamped(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Color.LerpUnclamped(a, b, t)

  pub static fn lerp(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Color.Lerp(a, b, t)

  pub static fn rgb_to_hsv(rgb_color: Self) -> (f32, f32, f32)
    = extern UnityEngine.Color.RGBToHSV(Self rgb_color, out f32 h, out f32 s, out f32 v)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn equals(other: object) -> bool
    = extern self.Equals(other)

  pub fn equals(other: Self) -> bool
    = extern self.Equals(other)

  pub fn get_hash_code() -> i32
    = extern self.GetHashCode()

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn to_string() -> string
    = extern self.ToString()

  pub fn to_string(format: string) -> string
    = extern self.ToString(format)

  pub fn to_string(format: string, format_provider: System.IFormatProvider) -> string
    = extern self.ToString(format, format_provider)

  pub static fn black -> Self
    = extern Self.black

  pub static fn blue -> Self
    = extern Self.blue

  pub static fn clear -> Self
    = extern Self.clear

  pub static fn cyan -> Self
    = extern Self.cyan

  pub fn gamma -> Self
    = extern self.gamma

  pub fn grayscale -> f32
    = extern self.grayscale

  pub static fn gray -> Self
    = extern Self.gray

  pub static fn green -> Self
    = extern Self.green

  pub static fn grey -> Self
    = extern Self.grey

  pub fn linear -> Self
    = extern self.linear

  pub static fn magenta -> Self
    = extern Self.magenta

  pub fn max_color_component -> f32
    = extern self.maxColorComponent

  pub static fn red -> Self
    = extern Self.red

  pub static fn white -> Self
    = extern Self.white

  pub static fn yellow -> Self
    = extern Self.yellow

  pub fn a -> f32
    = extern self.a

  pub fn b -> f32
    = extern self.b

  pub fn g -> f32
    = extern self.g

  pub fn r -> f32
    = extern self.r

  pub fn set_a(value: f32)
    = extern self.a = value

  pub fn set_b(value: f32)
    = extern self.b = value

  pub fn set_g(value: f32)
    = extern self.g = value

  pub fn set_r(value: f32)
    = extern self.r = value
}
