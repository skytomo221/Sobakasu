public function equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.Equals(obj_a, obj_b)

public function get_axis_raw(axis_name: string) -> f32
  = extern UnityEngine.Input.GetAxisRaw(axis_name)

public function get_axis(axis_name: string) -> f32
  = extern UnityEngine.Input.GetAxis(axis_name)

public function get_button_down(button_name: string) -> bool
  = extern UnityEngine.Input.GetButtonDown(button_name)

public function get_button_up(button_name: string) -> bool
  = extern UnityEngine.Input.GetButtonUp(button_name)

public function get_button(button_name: string) -> bool
  = extern UnityEngine.Input.GetButton(button_name)

public function get_joystick_names() -> [string]
  = extern UnityEngine.Input.GetJoystickNames()

public function get_key_down(name: string) -> bool
  = extern UnityEngine.Input.GetKeyDown(name)

public function get_key_down(key: UnityEngine::KeyCode) -> bool
  = extern UnityEngine.Input.GetKeyDown(key)

public function get_key_up(name: string) -> bool
  = extern UnityEngine.Input.GetKeyUp(name)

public function get_key_up(key: UnityEngine::KeyCode) -> bool
  = extern UnityEngine.Input.GetKeyUp(key)

public function get_key(name: string) -> bool
  = extern UnityEngine.Input.GetKey(name)

public function get_key(key: UnityEngine::KeyCode) -> bool
  = extern UnityEngine.Input.GetKey(key)

public function get_mouse_button_down(button: i32) -> bool
  = extern UnityEngine.Input.GetMouseButtonDown(button)

public function get_mouse_button_up(button: i32) -> bool
  = extern UnityEngine.Input.GetMouseButtonUp(button)

public function get_mouse_button(button: i32) -> bool
  = extern UnityEngine.Input.GetMouseButton(button)

public function reference_equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.ReferenceEquals(obj_a, obj_b)

public function any_key_down -> bool
  = extern UnityEngine.Input.anyKeyDown

public function any_key -> bool
  = extern UnityEngine.Input.anyKey

public function ime_is_selected -> bool
  = extern UnityEngine.Input.imeIsSelected

public function input_string -> string
  = extern UnityEngine.Input.inputString
