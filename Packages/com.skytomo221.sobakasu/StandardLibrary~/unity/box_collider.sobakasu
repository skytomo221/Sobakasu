  pub fn set_material(value: UnityEngine.PhysicMaterial)
    = extern self.material = value

  pub fn set_name(value: string)
    = extern self.name = value

  pub fn set_provides_contacts(value: bool)
    = extern self.providesContacts = value

  pub fn set_shared_material(value: UnityEngine.PhysicMaterial)
