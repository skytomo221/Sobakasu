    = extern self.GetComponentInParent(t, include_inactive)

  pub fn get_components_in_children(t: System.Type) -> [UnityEngine.Component]
    = extern self.GetComponentsInChildren(t)

  pub fn get_components_in_children(t: System.Type, include_inactive: bool) -> [UnityEngine.Component]
    = extern self.GetComponentsInChildren(t, include_inactive)

  pub fn get_components_in_parent(t: System.Type) -> [UnityEngine.Component]
    = extern self.GetComponentsInParent(t)

  pub fn get_components_in_parent(t: System.Type, include_inactive: bool) -> [UnityEngine.Component]
    = extern self.GetComponentsInParent(t, include_inactive)

  pub fn get_components(type: System.Type) -> [UnityEngine.Component]
    = extern self.GetComponents(type)

  pub fn get_component(type: string) -> UnityEngine.Component
    = extern self.GetComponent(type)

  pub fn get_component(type: System.Type) -> UnityEngine.Component
    = extern self.GetComponent(type)

  pub fn get_hash_code() -> i32
    = extern self.GetHashCode()

  pub fn get_instance_id() -> i32
    = extern self.GetInstanceID()

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn raycast(ray: UnityEngine.Ray, max_distance: f32) -> (bool, UnityEngine.RaycastHit)
    = extern self.Raycast(UnityEngine.Ray ray, out UnityEngine.RaycastHit hit_info, f32 max_distance)

  pub fn to_string() -> string
    = extern self.ToString()

  pub fn attached_articulation_body -> UnityEngine.ArticulationBody
    = extern self.attachedArticulationBody

  pub fn attached_rigidbody -> UnityEngine.Rigidbody
    = extern self.attachedRigidbody

  pub fn bounds -> UnityEngine.Bounds
    = extern self.bounds

  pub fn center -> UnityEngine.Vector3
    = extern self.center

  pub fn contact_offset -> f32
    = extern self.contactOffset

  pub fn enabled -> bool
    = extern self.enabled

  pub fn exclude_layers -> UnityEngine.LayerMask
    = extern self.excludeLayers

  pub fn game_object -> UnityEngine.GameObject
    = extern self.gameObject

  pub fn has_modifiable_contacts -> bool
    = extern self.hasModifiableContacts

  pub fn include_layers -> UnityEngine.LayerMask
    = extern self.includeLayers

  pub fn trigger? -> bool
    = extern self.isTrigger

  pub fn layer_override_priority -> i32
    = extern self.layerOverridePriority

  pub fn material -> UnityEngine.PhysicMaterial
    = extern self.material

  pub fn name -> string
    = extern self.name

  pub fn provides_contacts -> bool
    = extern self.providesContacts

  pub fn shared_material -> UnityEngine.PhysicMaterial
    = extern self.sharedMaterial

  pub fn size -> UnityEngine.Vector3
    = extern self.size

  pub fn transform -> UnityEngine.Transform
    = extern self.transform

  pub fn set_center(value: UnityEngine.Vector3)
    = extern self.center = value

  pub fn set_contact_offset(value: f32)
    = extern self.contactOffset = value

  pub fn set_enabled(value: bool)
    = extern self.enabled = value

  pub fn set_exclude_layers(value: UnityEngine.LayerMask)
