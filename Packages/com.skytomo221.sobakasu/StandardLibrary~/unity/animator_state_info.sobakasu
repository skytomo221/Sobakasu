pub struct AnimatorStateInfo = extern UnityEngine.AnimatorStateInfo {
}

impl AnimatorStateInfo {
  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn name?(self, name: string) -> bool
    = extern self.IsName(name)

  pub fn tag?(self, tag: string) -> bool
    = extern self.IsTag(tag)

  pub fn full_path_hash(self) -> i32
    = extern self.fullPathHash

  pub fn length(self) -> f32
    = extern self.length

  pub fn `loop`(self) -> bool
    = extern self.`loop`

  pub fn normalized_time(self) -> f32
    = extern self.normalizedTime

  pub fn short_name_hash(self) -> i32
    = extern self.shortNameHash

  pub fn speed_multiplier(self) -> f32
    = extern self.speedMultiplier

  pub fn speed(self) -> f32
    = extern self.speed

  pub fn tag_hash(self) -> i32
    = extern self.tagHash
}
