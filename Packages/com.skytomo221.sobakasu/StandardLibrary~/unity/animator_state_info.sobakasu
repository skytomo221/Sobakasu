public struct AnimatorStateInfo = extern UnityEngine.AnimatorStateInfo {
}

implementation AnimatorStateInfo {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function name?(self, name: string) -> bool
    = extern self.IsName(name)

  public function tag?(self, tag: string) -> bool
    = extern self.IsTag(tag)

  public function full_path_hash(self) -> i32
    = extern self.fullPathHash

  public function length(self) -> f32
    = extern self.length

  public function `loop`(self) -> bool
    = extern self.`loop`

  public function normalized_time(self) -> f32
    = extern self.normalizedTime

  public function short_name_hash(self) -> i32
    = extern self.shortNameHash

  public function speed_multiplier(self) -> f32
    = extern self.speedMultiplier

  public function speed(self) -> f32
    = extern self.speed

  public function tag_hash(self) -> i32
    = extern self.tagHash
}
