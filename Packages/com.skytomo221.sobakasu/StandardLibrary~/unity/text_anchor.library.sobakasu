  LowerLeft = extern LowerLeft,
  LowerRight = extern LowerRight,
  MiddleCenter = extern MiddleCenter,
  MiddleLeft = extern MiddleLeft,
  MiddleRight = extern MiddleRight,
  UpperCenter = extern UpperCenter,
  UpperLeft = extern UpperLeft,
  UpperRight = extern UpperRight,
}
