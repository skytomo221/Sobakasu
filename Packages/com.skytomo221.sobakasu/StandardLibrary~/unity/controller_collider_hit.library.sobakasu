use maybe::Maybe;

public type ControllerColliderHit = extern UnityEngine.ControllerColliderHit;

implementation ControllerColliderHit {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function to_string(self) -> Maybe<string>
    = maybe extern self.ToString()

  public function collider(self) -> Maybe<UnityEngine::Collider>
    = maybe extern self.collider

  public function controller(self) -> Maybe<UnityEngine::CharacterController>
    = maybe extern self.controller

  public function game_object(self) -> Maybe<UnityEngine::GameObject>
    = maybe extern self.gameObject

  public function move_direction(self) -> UnityEngine::Vector3
    = extern self.moveDirection

  public function move_length(self) -> f32
    = extern self.moveLength

  public function normal(self) -> UnityEngine::Vector3
    = extern self.normal

  public function point(self) -> UnityEngine::Vector3
    = extern self.point

  public function rigidbody(self) -> Maybe<UnityEngine::Rigidbody>
    = maybe extern self.rigidbody

  public function transform(self) -> Maybe<UnityEngine::Transform>
    = maybe extern self.transform
}
