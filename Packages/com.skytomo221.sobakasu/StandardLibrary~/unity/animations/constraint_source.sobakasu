public struct ConstraintSource = extern UnityEngine.Animations.ConstraintSource {
}

implementation ConstraintSource {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function source_transform(self) -> UnityEngine::Transform
    = extern self.sourceTransform

  public function weight(self) -> f32
    = extern self.weight

  public function set_source_transform(self, value: UnityEngine::Transform)
    = extern self.sourceTransform = value

  public function set_weight(self, value: f32)
    = extern self.weight = value
}
