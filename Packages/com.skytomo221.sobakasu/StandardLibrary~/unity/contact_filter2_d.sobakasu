public struct ContactFilter2D = extern UnityEngine.ContactFilter2D {
  layer_mask: UnityEngine::LayerMask = extern layerMask,
  max_depth: f32 = extern maxDepth,
  max_normal_angle: f32 = extern maxNormalAngle,
  min_depth: f32 = extern minDepth,
  min_normal_angle: f32 = extern minNormalAngle,
  use_depth: bool = extern useDepth,
  use_layer_mask: bool = extern useLayerMask,
  use_normal_angle: bool = extern useNormalAngle,
  use_outside_depth: bool = extern useOutsideDepth,
  use_outside_normal_angle: bool = extern useOutsideNormalAngle,
  use_triggers: bool = extern useTriggers,
}

implementation ContactFilter2D {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function clear_depth(self)
    = extern self.ClearDepth()

  public function clear_layer_mask(self)
    = extern self.ClearLayerMask()

  public function clear_normal_angle(self)
    = extern self.ClearNormalAngle()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function filtering_depth?(self, obj: UnityEngine::GameObject) -> bool
    = extern self.IsFilteringDepth(obj)

  public function filtering_layer_mask?(self, obj: UnityEngine::GameObject) -> bool
    = extern self.IsFilteringLayerMask(obj)

  public function filtering_normal_angle?(self, angle: f32) -> bool
    = extern self.IsFilteringNormalAngle(angle)

  public function filtering_normal_angle?(self, normal: UnityEngine::Vector2) -> bool
    = extern self.IsFilteringNormalAngle(normal)

  public function filtering_trigger?(self, collider: UnityEngine::Collider2D) -> bool
    = extern self.IsFilteringTrigger(collider)

  public function no_filter(self) -> Self
    = extern self.NoFilter()

  public function set_depth(self, min_depth: f32, max_depth: f32)
    = extern self.SetDepth(min_depth, max_depth)

  public function set_layer_mask_method(self, layer_mask: UnityEngine::LayerMask)
    = extern self.SetLayerMask(layer_mask)

  public function set_normal_angle(self, min_normal_angle: f32, max_normal_angle: f32)
    = extern self.SetNormalAngle(min_normal_angle, max_normal_angle)

  public function filtering?(self) -> bool
    = extern self.isFiltering

  public function normal_angle_upper_limit -> f32
    = extern UnityEngine.ContactFilter2D.NormalAngleUpperLimit
}
