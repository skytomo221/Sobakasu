public struct ContactPoint = extern UnityEngine.ContactPoint {
}

implementation ContactPoint {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function impulse(self) -> UnityEngine::Vector3
    = extern self.impulse

  public function normal(self) -> UnityEngine::Vector3
    = extern self.normal

  public function other_collider(self) -> UnityEngine::Collider
    = extern self.otherCollider

  public function point(self) -> UnityEngine::Vector3
    = extern self.point

  public function separation(self) -> f32
    = extern self.separation

  public function this_collider(self) -> UnityEngine::Collider
    = extern self.thisCollider
}
