pub struct RaycastHit = extern UnityEngine.RaycastHit {
}

impl RaycastHit {
  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn articulation_body -> UnityEngine.ArticulationBody
    = extern self.articulationBody

  pub fn barycentric_coordinate -> UnityEngine.Vector3
    = extern self.barycentricCoordinate

  pub fn collider_instance_id -> i32
    = extern self.colliderInstanceID

  pub fn collider -> UnityEngine.Collider
    = extern self.collider

  pub fn distance -> f32
    = extern self.distance

  pub fn lightmap_coord -> UnityEngine.Vector2
    = extern self.lightmapCoord

  pub fn normal -> UnityEngine.Vector3
    = extern self.normal

  pub fn point -> UnityEngine.Vector3
    = extern self.point

  pub fn rigidbody -> UnityEngine.Rigidbody
    = extern self.rigidbody

  pub fn texture_coord2 -> UnityEngine.Vector2
    = extern self.textureCoord2

  pub fn texture_coord -> UnityEngine.Vector2
    = extern self.textureCoord

  pub fn transform -> UnityEngine.Transform
    = extern self.transform

  pub fn triangle_index -> i32
    = extern self.triangleIndex

  pub fn set_barycentric_coordinate(value: UnityEngine.Vector3)
    = extern self.barycentricCoordinate = value

  pub fn set_distance(value: f32)
    = extern self.distance = value

  pub fn set_normal(value: UnityEngine.Vector3)
    = extern self.normal = value

  pub fn set_point(value: UnityEngine.Vector3)
    = extern self.point = value
}
