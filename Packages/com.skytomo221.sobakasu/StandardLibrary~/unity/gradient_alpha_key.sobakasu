pub impl GradientAlphaKey = extern UnityEngine.GradientAlphaKey {
  pub static fn new(alpha: f32, time: f32) -> Self
    = extern new Self(alpha, time)

  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn alpha -> f32
    = extern self.alpha

  pub fn time -> f32
    = extern self.time

  pub fn set_alpha(value: f32)
    = extern self.alpha = value

  pub fn set_time(value: f32)
    = extern self.time = value
}
