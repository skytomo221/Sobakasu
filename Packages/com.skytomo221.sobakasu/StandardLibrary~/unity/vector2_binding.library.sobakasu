public struct Vector2 = extern UnityEngine.Vector2 {
  x: f32 = extern x,
  y: f32 = extern y,
}

implementation Vector2 {
  public function new(x: f32, y: f32) -> Self
    = extern new Self(x, y)

  public function angle(from: Self, to_: Self) -> f32
    = extern UnityEngine.Vector2.Angle(from, to_)

  public function clamp_magnitude(vector: Self, max_length: f32) -> Self
    = extern UnityEngine.Vector2.ClampMagnitude(vector, max_length)

  public function distance(a: Self, b: Self) -> f32
    = extern UnityEngine.Vector2.Distance(a, b)

  public function dot(lhs: Self, rhs: Self) -> f32
    = extern UnityEngine.Vector2.Dot(lhs, rhs)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function lerp_unclamped(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Vector2.LerpUnclamped(a, b, t)

  public function lerp(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Vector2.Lerp(a, b, t)

  public function max(lhs: Self, rhs: Self) -> Self
    = extern UnityEngine.Vector2.Max(lhs, rhs)

  public function min(lhs: Self, rhs: Self) -> Self
    = extern UnityEngine.Vector2.Min(lhs, rhs)

  public function move_towards(current: Self, target: Self, max_distance_delta: f32) -> Self
    = extern UnityEngine.Vector2.MoveTowards(current, target, max_distance_delta)

  public function perpendicular(in_direction: Self) -> Self
    = extern UnityEngine.Vector2.Perpendicular(in_direction)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function reflect(in_direction: Self, in_normal: Self) -> Self
    = extern UnityEngine.Vector2.Reflect(in_direction, in_normal)

  public function scale(a: Self, b: Self) -> Self
    = extern UnityEngine.Vector2.Scale(a, b)

  public function signed_angle(from: Self, to_: Self) -> f32
    = extern UnityEngine.Vector2.SignedAngle(from, to_)

  public function smooth_damp(current: Self, target: Self, current_velocity: Self, smooth_time: f32) -> (Self, Self)
    = extern UnityEngine.Vector2.SmoothDamp(Self current, Self target, ref Self current_velocity, f32 smooth_time)

  public function smooth_damp(current: Self, target: Self, current_velocity: Self, smooth_time: f32, max_speed: f32) -> (Self, Self)
    = extern UnityEngine.Vector2.SmoothDamp(Self current, Self target, ref Self current_velocity, f32 smooth_time, f32 max_speed)

  public function smooth_damp(current: Self, target: Self, current_velocity: Self, smooth_time: f32, max_speed: f32, delta_time: f32) -> (Self, Self)
    = extern UnityEngine.Vector2.SmoothDamp(Self current, Self target, ref Self current_velocity, f32 smooth_time, f32 max_speed, f32 delta_time)

  public function sqr_magnitude(a: Self) -> f32
    = extern UnityEngine.Vector2.SqrMagnitude(a)

  public function +(self, rhs: Self) -> Self
    = extern self + rhs

  public function /(self, rhs: f32) -> Self
    = extern self / rhs

  public function /(self, rhs: Self) -> Self
    = extern self / rhs

  public function ==(self, rhs: Self) -> bool
    = extern self == rhs

  public function !=(self, rhs: Self) -> bool
    = extern self != rhs

  public function *(self, rhs: f32) -> Self
    = extern self * rhs

  public function *(self, rhs: Self) -> Self
    = extern self * rhs

  public function -(self, rhs: Self) -> Self
    = extern self - rhs

  public function @-(self) -> Self
    = extern -self

  public function equals(self, other: object) -> bool
    = extern self.Equals(other)

  public function equals(self, other: Self) -> bool
    = extern self.Equals(other)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function normalize(self)
    = extern self.Normalize()

  public function scale(self, scale: Self)
    = extern self.Scale(scale)

  public function set(self, new_x: f32, new_y: f32)
    = extern self.Set(new_x, new_y)

  public function calculate_sqr_magnitude(self) -> f32
    = extern self.SqrMagnitude()

  public function to_string(self) -> string
    = extern self.ToString()

  public function to_string(self, format: string) -> string
    = extern self.ToString(format)

  public function to_string(self, format: string, format_provider: System::IFormatProvider) -> string
    = extern self.ToString(format, format_provider)

  public function down -> Self
    = extern UnityEngine.Vector2.down

  public function left -> Self
    = extern UnityEngine.Vector2.left

  public function magnitude(self) -> f32
    = extern self.magnitude

  public function negative_infinity -> Self
    = extern UnityEngine.Vector2.negativeInfinity

  public function normalized(self) -> Self
    = extern self.normalized

  public function one -> Self
    = extern UnityEngine.Vector2.one

  public function positive_infinity -> Self
    = extern UnityEngine.Vector2.positiveInfinity

  public function right -> Self
    = extern UnityEngine.Vector2.right

  public function sqr_magnitude(self) -> f32
    = extern self.sqrMagnitude

  public function up -> Self
    = extern UnityEngine.Vector2.up

  public function zero -> Self
    = extern UnityEngine.Vector2.zero

  public function k_epsilon_normal_sqrt -> f32
    = extern UnityEngine.Vector2.kEpsilonNormalSqrt

  public function k_epsilon -> f32
    = extern UnityEngine.Vector2.kEpsilon
}
