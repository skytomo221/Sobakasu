public struct HumanBone = extern UnityEngine.HumanBone {
  limit: UnityEngine::HumanLimit = extern limit,
}

implementation HumanBone {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function bone_name(self) -> string
    = extern self.boneName

  public function human_name(self) -> string
    = extern self.humanName

  public function set_bone_name(self, value: string)
    = extern self.boneName = value

  public function set_human_name(self, value: string)
    = extern self.humanName = value
}
