use maybe::Maybe;

public struct Ray = extern UnityEngine.Ray {
}

implementation Ray {
  public function new(origin: UnityEngine::Vector3, direction: UnityEngine::Vector3) -> Self
    = extern new Self(origin, direction)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_point(mutable self, distance: f32) -> UnityEngine::Vector3
    = extern self.GetPoint(distance)

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function to_string(mutable self, format: string) -> Maybe<string>
    = maybe extern self.ToString(format)

  public function to_string(mutable self, format: string, format_provider: System::IFormatProvider) -> Maybe<string>
    = maybe extern self.ToString(format, format_provider)

  public function direction(mutable self) -> UnityEngine::Vector3
    = extern self.direction

  public function origin(mutable self) -> UnityEngine::Vector3
    = extern self.origin

  public function set_direction(mutable self, value: UnityEngine::Vector3)
    = extern self.direction = value

  public function set_origin(mutable self, value: UnityEngine::Vector3)
    = extern self.origin = value
}
