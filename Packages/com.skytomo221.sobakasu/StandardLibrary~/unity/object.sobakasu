pub impl Object = extern UnityEngine.Object {
  pub static fn destroy_immediate(obj: Self)
    = extern UnityEngine.Object.DestroyImmediate(obj)

  pub static fn destroy_immediate(obj: Self, allow_destroying_assets: bool)
    = extern UnityEngine.Object.DestroyImmediate(obj, allow_destroying_assets)

  pub static fn destroy(obj: Self)
    = extern UnityEngine.Object.Destroy(obj)

  pub static fn destroy(obj: Self, t: f32)
    = extern UnityEngine.Object.Destroy(obj, t)

  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub static fn op_equality(x: Self, y: Self) -> bool
    = extern UnityEngine.Object.op_Equality(x, y)

  pub static fn op_implicit(exists: Self) -> bool
    = extern UnityEngine.Object.op_Implicit(exists)

  pub static fn op_inequality(x: Self, y: Self) -> bool
    = extern UnityEngine.Object.op_Inequality(x, y)

  pub fn equals(other: object) -> bool
    = extern self.Equals(other)

  pub fn get_hash_code() -> i32
    = extern self.GetHashCode()

  pub fn get_instance_id() -> i32
    = extern self.GetInstanceID()

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn to_string() -> string
    = extern self.ToString()

  pub fn name -> string
    = extern self.name

  pub fn set_name(value: string)
    = extern self.name = value
}
