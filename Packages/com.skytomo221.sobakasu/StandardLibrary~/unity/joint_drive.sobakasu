pub impl JointDrive = extern UnityEngine.JointDrive {
  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn maximum_force -> f32
    = extern self.maximumForce

  pub fn position_damper -> f32
    = extern self.positionDamper

  pub fn position_spring -> f32
    = extern self.positionSpring

  pub fn use_acceleration -> bool
    = extern self.useAcceleration

  pub fn set_maximum_force(value: f32)
    = extern self.maximumForce = value

  pub fn set_position_damper(value: f32)
    = extern self.positionDamper = value

  pub fn set_position_spring(value: f32)
    = extern self.positionSpring = value

  pub fn set_use_acceleration(value: bool)
    = extern self.useAcceleration = value
}
