    = extern self.cycleCount = value

  pub fn set_max_count(self, value: i16)
    = extern self.maxCount = value

  pub fn set_min_count(self, value: i16)
    = extern self.minCount = value

  pub fn set_probability(self, value: f32)
    = extern self.probability = value

  pub fn set_repeat_interval(self, value: f32)
    = extern self.repeatInterval = value

  pub fn set_time(self, value: f32)
