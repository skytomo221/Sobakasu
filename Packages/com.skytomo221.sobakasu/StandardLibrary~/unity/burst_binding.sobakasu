pub struct Burst = extern UnityEngine.ParticleSystem.Burst {
}

impl Burst {
  pub fn new(time: f32, count: i16) -> Self
    = extern new Self(time, count)

  pub fn new(time: f32, min_count: i16, max_count: i16) -> Self
    = extern new Self(time, min_count, max_count)

  pub fn new(time: f32, min_count: i16, max_count: i16, cycle_count: i32, repeat_interval: f32) -> Self
    = extern new Self(time, min_count, max_count, cycle_count, repeat_interval)

  pub fn new(time: f32, count: UnityEngine::ParticleSystem::MinMaxCurve) -> Self
    = extern new Self(time, count)

  pub fn new(time: f32, count: UnityEngine::ParticleSystem::MinMaxCurve, cycle_count: i32, repeat_interval: f32) -> Self
    = extern new Self(time, count, cycle_count, repeat_interval)

  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn count(self) -> UnityEngine::ParticleSystem::MinMaxCurve
    = extern self.count

  pub fn cycle_count(self) -> i32
    = extern self.cycleCount

  pub fn max_count(self) -> i16
    = extern self.maxCount

  pub fn min_count(self) -> i16
    = extern self.minCount

  pub fn probability(self) -> f32
    = extern self.probability

  pub fn repeat_interval(self) -> f32
    = extern self.repeatInterval

