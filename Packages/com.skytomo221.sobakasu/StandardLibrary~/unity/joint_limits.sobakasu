pub struct JointLimits = extern UnityEngine.JointLimits {
}

impl JointLimits {
  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn bounce_min_velocity(self) -> f32
    = extern self.bounceMinVelocity

  pub fn bounciness(self) -> f32
    = extern self.bounciness

  pub fn contact_distance(self) -> f32
    = extern self.contactDistance

  pub fn max(self) -> f32
    = extern self.max

  pub fn min(self) -> f32
    = extern self.min

  pub fn set_bounce_min_velocity(self, value: f32)
    = extern self.bounceMinVelocity = value

  pub fn set_bounciness(self, value: f32)
    = extern self.bounciness = value

  pub fn set_contact_distance(self, value: f32)
    = extern self.contactDistance = value

  pub fn set_max(self, value: f32)
    = extern self.max = value

  pub fn set_min(self, value: f32)
    = extern self.min = value
}
