public type Collision2D = extern UnityEngine.Collision2D;

implementation Collision2D {
  public function new() -> Self
    = extern new Self()

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_contacts(self, contacts: System::Collections::Generic::List<UnityEngine::ContactPoint2D>) -> i32
    = extern self.GetContacts(contacts)

  public function get_contacts(self, contacts: [UnityEngine::ContactPoint2D]) -> i32
    = extern self.GetContacts(contacts)

  public function get_contact(self, index: i32) -> UnityEngine::ContactPoint2D
    = extern self.GetContact(index)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function to_string(self) -> string
    = extern self.ToString()

  public function collider(self) -> UnityEngine::Collider2D
    = extern self.collider

  public function contact_count(self) -> i32
    = extern self.contactCount

  public function contacts(self) -> [UnityEngine::ContactPoint2D]
    = extern self.contacts

  public function enabled(self) -> bool
    = extern self.enabled

  public function game_object(self) -> UnityEngine::GameObject
    = extern self.gameObject

  public function other_collider(self) -> UnityEngine::Collider2D
    = extern self.otherCollider

  public function other_rigidbody(self) -> UnityEngine::Rigidbody2D
    = extern self.otherRigidbody

  public function relative_velocity(self) -> UnityEngine::Vector2
    = extern self.relativeVelocity

  public function rigidbody(self) -> UnityEngine::Rigidbody2D
    = extern self.rigidbody

  public function transform(self) -> UnityEngine::Transform
    = extern self.transform
}
