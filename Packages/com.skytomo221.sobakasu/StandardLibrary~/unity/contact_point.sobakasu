pub struct ContactPoint = extern UnityEngine.ContactPoint {
}

impl ContactPoint {
  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn impulse(self) -> UnityEngine::Vector3
    = extern self.impulse

  pub fn normal(self) -> UnityEngine::Vector3
    = extern self.normal

  pub fn other_collider(self) -> UnityEngine::Collider
    = extern self.otherCollider

  pub fn point(self) -> UnityEngine::Vector3
    = extern self.point

  pub fn separation(self) -> f32
    = extern self.separation

  pub fn this_collider(self) -> UnityEngine::Collider
    = extern self.thisCollider
}
