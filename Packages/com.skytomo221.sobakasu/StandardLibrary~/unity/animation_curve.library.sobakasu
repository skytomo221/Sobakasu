public type AnimationCurve = extern UnityEngine.AnimationCurve;

implementation AnimationCurve {
  public function new() -> Self
    = extern new Self()

  public function constant(time_start: f32, time_end: f32, value: f32) -> Self
    = extern UnityEngine.AnimationCurve.Constant(time_start, time_end, value)

  public function ease_in_out(time_start: f32, value_start: f32, time_end: f32, value_end: f32) -> Self
    = extern UnityEngine.AnimationCurve.EaseInOut(time_start, value_start, time_end, value_end)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function linear(time_start: f32, value_start: f32, time_end: f32, value_end: f32) -> Self
    = extern UnityEngine.AnimationCurve.Linear(time_start, value_start, time_end, value_end)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function add_key(self, time: f32, value: f32) -> i32
    = extern self.AddKey(time, value)

  public function add_key(self, key: UnityEngine::Keyframe) -> i32
    = extern self.AddKey(key)

  public function clear_keys(self)
    = extern self.ClearKeys()

  public function copy_from(self, other: Self)
    = extern self.CopyFrom(other)

  public function equals(self, o: object) -> bool
    = extern self.Equals(o)

  public function equals(self, other: Self) -> bool
    = extern self.Equals(other)

  public function evaluate(self, time: f32) -> f32
    = extern self.Evaluate(time)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function move_key(self, index: i32, key: UnityEngine::Keyframe) -> i32
    = extern self.MoveKey(index, key)

  public function remove_key(self, index: i32)
    = extern self.RemoveKey(index)

  public function smooth_tangents(self, index: i32, weight: f32)
    = extern self.SmoothTangents(index, weight)

  public function to_string(self) -> string
    = extern self.ToString()

  public function length(self) -> i32
    = extern self.length

  public function post_wrap_mode(self) -> UnityEngine::WrapMode
    = extern self.postWrapMode

  public function pre_wrap_mode(self) -> UnityEngine::WrapMode
    = extern self.preWrapMode

  public function set_post_wrap_mode(self, value: UnityEngine::WrapMode)
    = extern self.postWrapMode = value

  public function set_pre_wrap_mode(self, value: UnityEngine::WrapMode)
    = extern self.preWrapMode = value
}
