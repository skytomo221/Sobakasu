  public function time(mutable self) -> f32
    = extern self.time

  public function set_count(mutable self, value: UnityEngine::ParticleSystem::MinMaxCurve)
    = extern self.count = value

  public function set_cycle_count(mutable self, value: i32)
    = extern self.cycleCount = value

  public function set_max_count(mutable self, value: i16)
    = extern self.maxCount = value

  public function set_min_count(mutable self, value: i16)
