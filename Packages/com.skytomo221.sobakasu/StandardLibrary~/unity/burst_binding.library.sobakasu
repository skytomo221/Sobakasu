    = extern new Self(time, count)

  public function new(time: f32, min_count: i16, max_count: i16) -> Self
    = extern new Self(time, min_count, max_count)

  public function new(time: f32, min_count: i16, max_count: i16, cycle_count: i32, repeat_interval: f32) -> Self
