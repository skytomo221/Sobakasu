public type Sprite = extern UnityEngine.Sprite;

implementation Sprite {
  public function create(texture: UnityEngine::Texture2D, rect: UnityEngine::Rect, pivot: UnityEngine::Vector2) -> Self
    = extern UnityEngine.Sprite.Create(texture, rect, pivot)

  public function create(texture: UnityEngine::Texture2D, rect: UnityEngine::Rect, pivot: UnityEngine::Vector2, pixels_per_unit: f32) -> Self
    = extern UnityEngine.Sprite.Create(texture, rect, pivot, pixels_per_unit)

  public function create(texture: UnityEngine::Texture2D, rect: UnityEngine::Rect, pivot: UnityEngine::Vector2, pixels_per_unit: f32, extrude: u32) -> Self
    = extern UnityEngine.Sprite.Create(texture, rect, pivot, pixels_per_unit, extrude)

  public function create(texture: UnityEngine::Texture2D, rect: UnityEngine::Rect, pivot: UnityEngine::Vector2, pixels_per_unit: f32, extrude: u32, mesh_type: UnityEngine::SpriteMeshType) -> Self
    = extern UnityEngine.Sprite.Create(texture, rect, pivot, pixels_per_unit, extrude, mesh_type)

  public function create(texture: UnityEngine::Texture2D, rect: UnityEngine::Rect, pivot: UnityEngine::Vector2, pixels_per_unit: f32, extrude: u32, mesh_type: UnityEngine::SpriteMeshType, border: UnityEngine::Vector4) -> Self
    = extern UnityEngine.Sprite.Create(texture, rect, pivot, pixels_per_unit, extrude, mesh_type, border)

  public function create(texture: UnityEngine::Texture2D, rect: UnityEngine::Rect, pivot: UnityEngine::Vector2, pixels_per_unit: f32, extrude: u32, mesh_type: UnityEngine::SpriteMeshType, border: UnityEngine::Vector4, generate_fallback_physics_shape: bool) -> Self
    = extern UnityEngine.Sprite.Create(texture, rect, pivot, pixels_per_unit, extrude, mesh_type, border, generate_fallback_physics_shape)

  public function destroy_immediate(obj: UnityEngine::Object)
    = extern UnityEngine.Object.DestroyImmediate(obj)

  public function destroy_immediate(obj: UnityEngine::Object, allow_destroying_assets: bool)
    = extern UnityEngine.Object.DestroyImmediate(obj, allow_destroying_assets)

  public function destroy(obj: UnityEngine::Object)
    = extern UnityEngine.Object.Destroy(obj)

  public function destroy(obj: UnityEngine::Object, t: f32)
    = extern UnityEngine.Object.Destroy(obj, t)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(self, other: object) -> bool
    = extern self.Equals(other)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_instance_id(self) -> i32
    = extern self.GetInstanceID()

  public function get_physics_shape_count(self) -> i32
    = extern self.GetPhysicsShapeCount()

  public function get_physics_shape_point_count(self, shape_idx: i32) -> i32
    = extern self.GetPhysicsShapePointCount(shape_idx)

  public function get_physics_shape(self, shape_idx: i32, physics_shape: System::Collections::Generic::List<UnityEngine::Vector2>) -> i32
    = extern self.GetPhysicsShape(shape_idx, physics_shape)

  public function get_secondary_texture_count(self) -> i32
    = extern self.GetSecondaryTextureCount()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function override_geometry(self, vertices: [UnityEngine::Vector2], triangles: [u16])
    = extern self.OverrideGeometry(vertices, triangles)

  public function override_physics_shape(self, physics_shapes: System::Collections::Generic::IList<[UnityEngine::Vector2]>)
    = extern self.OverridePhysicsShape(physics_shapes)

  public function to_string(self) -> string
    = extern self.ToString()

  public function associated_alpha_split_texture(self) -> UnityEngine::Texture2D
    = extern self.associatedAlphaSplitTexture

  public function border(self) -> UnityEngine::Vector4
    = extern self.border

  public function bounds(self) -> UnityEngine::Bounds
    = extern self.bounds

  public function name(self) -> string
    = extern self.name

  public function packed(self) -> bool
    = extern self.packed

  public function packing_mode(self) -> UnityEngine::SpritePackingMode
    = extern self.packingMode

  public function packing_rotation(self) -> UnityEngine::SpritePackingRotation
    = extern self.packingRotation

  public function pivot(self) -> UnityEngine::Vector2
    = extern self.pivot

  public function pixels_per_unit(self) -> f32
    = extern self.pixelsPerUnit

  public function rect(self) -> UnityEngine::Rect
    = extern self.rect

  public function sprite_atlas_texture_scale(self) -> f32
    = extern self.spriteAtlasTextureScale

  public function texture_rect_offset(self) -> UnityEngine::Vector2
    = extern self.textureRectOffset

