public struct CombineInstance = extern UnityEngine.CombineInstance {
}

implementation CombineInstance {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function lightmap_scale_offset(self) -> UnityEngine::Vector4
    = extern self.lightmapScaleOffset

  public function mesh(self) -> UnityEngine::Mesh
    = extern self.mesh

  public function realtime_lightmap_scale_offset(self) -> UnityEngine::Vector4
    = extern self.realtimeLightmapScaleOffset

  public function sub_mesh_index(self) -> i32
    = extern self.subMeshIndex

  public function transform(self) -> UnityEngine::Matrix4x4
    = extern self.transform

  public function set_lightmap_scale_offset(self, value: UnityEngine::Vector4)
    = extern self.lightmapScaleOffset = value

  public function set_mesh(self, value: UnityEngine::Mesh)
    = extern self.mesh = value

  public function set_realtime_lightmap_scale_offset(self, value: UnityEngine::Vector4)
    = extern self.realtimeLightmapScaleOffset = value

  public function set_sub_mesh_index(self, value: i32)
    = extern self.subMeshIndex = value

  public function set_transform(self, value: UnityEngine::Matrix4x4)
    = extern self.transform = value
}
