public struct Rect = extern UnityEngine.Rect {
}

implementation Rect {
  public function new(x: f32, y: f32, width: f32, height: f32) -> Self
    = extern new Self(x, y, width, height)

  public function new(source: Self) -> Self
    = extern new Self(source)

  public function new(position: UnityEngine::Vector2, size: UnityEngine::Vector2) -> Self
    = extern new Self(position, size)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function min_max_rect(xmin: f32, ymin: f32, xmax: f32, ymax: f32) -> Self
    = extern UnityEngine.Rect.MinMaxRect(xmin, ymin, xmax, ymax)

  public function normalized_to_point(rectangle: Self, normalized_rect_coordinates: UnityEngine::Vector2) -> UnityEngine::Vector2
    = extern UnityEngine.Rect.NormalizedToPoint(rectangle, normalized_rect_coordinates)

  public function point_to_normalized(rectangle: Self, point: UnityEngine::Vector2) -> UnityEngine::Vector2
    = extern UnityEngine.Rect.PointToNormalized(rectangle, point)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function ==(self, rhs: Self) -> bool
    = extern self == rhs

  public function !=(self, rhs: Self) -> bool
    = extern self != rhs

  public function contains(self, point: UnityEngine::Vector2) -> bool
    = extern self.Contains(point)

  public function contains(self, point: UnityEngine::Vector3) -> bool
    = extern self.Contains(point)

  public function contains(self, point: UnityEngine::Vector3, allow_inverse: bool) -> bool
    = extern self.Contains(point, allow_inverse)

  public function equals(self, other: object) -> bool
    = extern self.Equals(other)

  public function equals(self, other: Self) -> bool
    = extern self.Equals(other)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function overlaps(self, other: Self) -> bool
    = extern self.Overlaps(other)

  public function overlaps(self, other: Self, allow_inverse: bool) -> bool
    = extern self.Overlaps(other, allow_inverse)

  public function set(self, x: f32, y: f32, width: f32, height: f32)
    = extern self.Set(x, y, width, height)

  public function to_string(self) -> string
    = extern self.ToString()

  public function to_string(self, format: string) -> string
    = extern self.ToString(format)

  public function to_string(self, format: string, format_provider: System::IFormatProvider) -> string
    = extern self.ToString(format, format_provider)

  public function center(self) -> UnityEngine::Vector2
    = extern self.center

  public function height(self) -> f32
    = extern self.height

  public function max(self) -> UnityEngine::Vector2
    = extern self.max

  public function min(self) -> UnityEngine::Vector2
    = extern self.min

  public function position(self) -> UnityEngine::Vector2
    = extern self.position

  public function size(self) -> UnityEngine::Vector2
    = extern self.size

  public function width(self) -> f32
    = extern self.width

  public function x_max(self) -> f32
    = extern self.xMax

  public function x_min(self) -> f32
    = extern self.xMin

  public function x(self) -> f32
    = extern self.x

  public function y_max(self) -> f32
    = extern self.yMax

  public function y_min(self) -> f32
    = extern self.yMin

  public function y(self) -> f32
    = extern self.y

  public function zero -> Self
    = extern UnityEngine.Rect.zero

  public function set_center(self, value: UnityEngine::Vector2)
    = extern self.center = value

  public function set_height(self, value: f32)
    = extern self.height = value

  public function set_max(self, value: UnityEngine::Vector2)
    = extern self.max = value

  public function set_min(self, value: UnityEngine::Vector2)
    = extern self.min = value

  public function set_position(self, value: UnityEngine::Vector2)
    = extern self.position = value

  public function set_size(self, value: UnityEngine::Vector2)
    = extern self.size = value

  public function set_width(self, value: f32)
    = extern self.width = value

  public function set_x_max(self, value: f32)
    = extern self.xMax = value

  public function set_x_min(self, value: f32)
    = extern self.xMin = value

  public function set_x(self, value: f32)
    = extern self.x = value

  public function set_y_max(self, value: f32)
    = extern self.yMax = value

  public function set_y_min(self, value: f32)
    = extern self.yMin = value

  public function set_y(self, value: f32)
    = extern self.y = value
}
