public struct Ray = extern UnityEngine.Ray {
}

implementation Ray {
  public function new(origin: UnityEngine::Vector3, direction: UnityEngine::Vector3) -> Self
    = extern new Self(origin, direction)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function get_point(self, distance: f32) -> UnityEngine::Vector3
    = extern self.GetPoint(distance)

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function to_string(self) -> string
    = extern self.ToString()

  public function to_string(self, format: string) -> string
    = extern self.ToString(format)

  public function to_string(self, format: string, format_provider: System::IFormatProvider) -> string
    = extern self.ToString(format, format_provider)

  public function direction(self) -> UnityEngine::Vector3
    = extern self.direction

  public function origin(self) -> UnityEngine::Vector3
    = extern self.origin

  public function set_direction(self, value: UnityEngine::Vector3)
    = extern self.direction = value

  public function set_origin(self, value: UnityEngine::Vector3)
    = extern self.origin = value
}
