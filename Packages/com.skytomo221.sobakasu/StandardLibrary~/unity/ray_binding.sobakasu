pub struct Ray = extern UnityEngine.Ray {
}

impl Ray {
  pub fn new(origin: UnityEngine::Vector3, direction: UnityEngine::Vector3) -> Self
    = extern new Self(origin, direction)

  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_point(self, distance: f32) -> UnityEngine::Vector3
    = extern self.GetPoint(distance)

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn to_string(self, format: string) -> string
    = extern self.ToString(format)

  pub fn to_string(self, format: string, format_provider: System::IFormatProvider) -> string
    = extern self.ToString(format, format_provider)

  pub fn direction(self) -> UnityEngine::Vector3
    = extern self.direction

  pub fn origin(self) -> UnityEngine::Vector3
    = extern self.origin

  pub fn set_direction(self, value: UnityEngine::Vector3)
    = extern self.direction = value

  pub fn set_origin(self, value: UnityEngine::Vector3)
    = extern self.origin = value
}
