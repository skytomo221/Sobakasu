pub struct Ray = extern UnityEngine.Ray {
}

impl Ray {
  pub static fn new(origin: UnityEngine.Vector3, direction: UnityEngine.Vector3) -> Self
    = extern new Self(origin, direction)

  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_point(distance: f32) -> UnityEngine.Vector3
    = extern self.GetPoint(distance)

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn to_string() -> string
    = extern self.ToString()

  pub fn to_string(format: string) -> string
    = extern self.ToString(format)

  pub fn to_string(format: string, format_provider: System.IFormatProvider) -> string
    = extern self.ToString(format, format_provider)

  pub fn direction -> UnityEngine.Vector3
    = extern self.direction

  pub fn origin -> UnityEngine.Vector3
    = extern self.origin

  pub fn set_direction(value: UnityEngine.Vector3)
    = extern self.direction = value

  pub fn set_origin(value: UnityEngine.Vector3)
    = extern self.origin = value
}
