public struct Quaternion = extern UnityEngine.Quaternion {
  w: f32 = extern w,
  x: f32 = extern x,
  y: f32 = extern y,
  z: f32 = extern z,
}

implementation Quaternion {
  public function new(x: f32, y: f32, z: f32, w: f32) -> Self
    = extern new Self(x, y, z, w)

  public function angle_axis(angle: f32, axis: UnityEngine::Vector3) -> Self
    = extern UnityEngine.Quaternion.AngleAxis(angle, axis)

  public function angle(a: Self, b: Self) -> f32
    = extern UnityEngine.Quaternion.Angle(a, b)

  public function dot(a: Self, b: Self) -> f32
    = extern UnityEngine.Quaternion.Dot(a, b)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function euler(x: f32, y: f32, z: f32) -> Self
    = extern UnityEngine.Quaternion.Euler(x, y, z)

  public function euler(euler: UnityEngine::Vector3) -> Self
    = extern UnityEngine.Quaternion.Euler(euler)

  public function from_to_rotation(from_direction: UnityEngine::Vector3, to_direction: UnityEngine::Vector3) -> Self
    = extern UnityEngine.Quaternion.FromToRotation(from_direction, to_direction)

  public function inverse(rotation: Self) -> Self
    = extern UnityEngine.Quaternion.Inverse(rotation)

  public function lerp_unclamped(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Quaternion.LerpUnclamped(a, b, t)

  public function lerp(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Quaternion.Lerp(a, b, t)

  public function look_rotation(forward: UnityEngine::Vector3) -> Self
    = extern UnityEngine.Quaternion.LookRotation(forward)

  public function look_rotation(forward: UnityEngine::Vector3, upwards: UnityEngine::Vector3) -> Self
    = extern UnityEngine.Quaternion.LookRotation(forward, upwards)

  public function normalize(q: Self) -> Self
    = extern UnityEngine.Quaternion.Normalize(q)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function rotate_towards(from: Self, to_: Self, max_degrees_delta: f32) -> Self
    = extern UnityEngine.Quaternion.RotateTowards(from, to_, max_degrees_delta)

  public function slerp_unclamped(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Quaternion.SlerpUnclamped(a, b, t)

  public function slerp(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Quaternion.Slerp(a, b, t)

  public function ==(self, rhs: Self) -> bool
    = extern self == rhs

  public function !=(self, rhs: Self) -> bool
    = extern self != rhs

  public function *(self, rhs: Self) -> Self
    = extern self * rhs

  public function *(self, rhs: UnityEngine::Vector3) -> UnityEngine::Vector3
    = extern self * rhs

  public function equals(self, other: object) -> bool
    = extern self.Equals(other)

  public function equals(self, other: Self) -> bool
    = extern self.Equals(other)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function normalize(self)
    = extern self.Normalize()

  public function set_from_to_rotation(self, from_direction: UnityEngine::Vector3, to_direction: UnityEngine::Vector3)
    = extern self.SetFromToRotation(from_direction, to_direction)

  public function set_look_rotation(self, view: UnityEngine::Vector3)
    = extern self.SetLookRotation(view)

  public function set_look_rotation(self, view: UnityEngine::Vector3, up: UnityEngine::Vector3)
    = extern self.SetLookRotation(view, up)

  public function set(self, new_x: f32, new_y: f32, new_z: f32, new_w: f32)
    = extern self.Set(new_x, new_y, new_z, new_w)

  public function to_angle_axis(self) -> (f32, UnityEngine::Vector3)
    = extern self.ToAngleAxis(out f32 angle, out UnityEngine::Vector3 axis)

  public function to_string(self) -> string
    = extern self.ToString()

  public function to_string(self, format: string) -> string
    = extern self.ToString(format)

  public function to_string(self, format: string, format_provider: System::IFormatProvider) -> string
    = extern self.ToString(format, format_provider)

  public function euler_angles(self) -> UnityEngine::Vector3
    = extern self.eulerAngles

  public function identity -> Self
    = extern UnityEngine.Quaternion.identity

  public function normalized(self) -> Self
    = extern self.normalized

  public function set_euler_angles(self, value: UnityEngine::Vector3)
    = extern self.eulerAngles = value

  public function k_epsilon -> f32
    = extern UnityEngine.Quaternion.kEpsilon
}
