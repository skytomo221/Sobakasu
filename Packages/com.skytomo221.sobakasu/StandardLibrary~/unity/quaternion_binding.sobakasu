pub struct Quaternion = extern UnityEngine.Quaternion {
  w: f32 = extern w,
  x: f32 = extern x,
  y: f32 = extern y,
  z: f32 = extern z,
}

impl Quaternion {
  pub fn new(x: f32, y: f32, z: f32, w: f32) -> Self
    = extern new Self(x, y, z, w)

  pub fn angle_axis(angle: f32, axis: UnityEngine::Vector3) -> Self
    = extern UnityEngine.Quaternion.AngleAxis(angle, axis)

  pub fn angle(a: Self, b: Self) -> f32
    = extern UnityEngine.Quaternion.Angle(a, b)

  pub fn dot(a: Self, b: Self) -> f32
    = extern UnityEngine.Quaternion.Dot(a, b)

  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn euler(x: f32, y: f32, z: f32) -> Self
    = extern UnityEngine.Quaternion.Euler(x, y, z)

  pub fn euler(euler: UnityEngine::Vector3) -> Self
    = extern UnityEngine.Quaternion.Euler(euler)

  pub fn from_to_rotation(from_direction: UnityEngine::Vector3, to_direction: UnityEngine::Vector3) -> Self
    = extern UnityEngine.Quaternion.FromToRotation(from_direction, to_direction)

  pub fn inverse(rotation: Self) -> Self
    = extern UnityEngine.Quaternion.Inverse(rotation)

  pub fn lerp_unclamped(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Quaternion.LerpUnclamped(a, b, t)

  pub fn lerp(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Quaternion.Lerp(a, b, t)

  pub fn look_rotation(forward: UnityEngine::Vector3) -> Self
    = extern UnityEngine.Quaternion.LookRotation(forward)

  pub fn look_rotation(forward: UnityEngine::Vector3, upwards: UnityEngine::Vector3) -> Self
    = extern UnityEngine.Quaternion.LookRotation(forward, upwards)

  pub fn normalize(q: Self) -> Self
    = extern UnityEngine.Quaternion.Normalize(q)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn rotate_towards(from: Self, to_: Self, max_degrees_delta: f32) -> Self
    = extern UnityEngine.Quaternion.RotateTowards(from, to_, max_degrees_delta)

  pub fn slerp_unclamped(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Quaternion.SlerpUnclamped(a, b, t)

  pub fn slerp(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Quaternion.Slerp(a, b, t)

  pub fn ==(self, rhs: Self) -> bool
    = extern self == rhs

  pub fn !=(self, rhs: Self) -> bool
    = extern self != rhs

  pub fn *(self, rhs: Self) -> Self
    = extern self * rhs

  pub fn *(self, rhs: UnityEngine::Vector3) -> UnityEngine::Vector3
    = extern self * rhs

  pub fn equals(self, other: object) -> bool
    = extern self.Equals(other)

  pub fn equals(self, other: Self) -> bool
    = extern self.Equals(other)

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn normalize(self)
    = extern self.Normalize()

  pub fn set_from_to_rotation(self, from_direction: UnityEngine::Vector3, to_direction: UnityEngine::Vector3)
    = extern self.SetFromToRotation(from_direction, to_direction)

  pub fn set_look_rotation(self, view: UnityEngine::Vector3)
    = extern self.SetLookRotation(view)

  pub fn set_look_rotation(self, view: UnityEngine::Vector3, up: UnityEngine::Vector3)
    = extern self.SetLookRotation(view, up)

  pub fn set(self, new_x: f32, new_y: f32, new_z: f32, new_w: f32)
    = extern self.Set(new_x, new_y, new_z, new_w)

  pub fn to_angle_axis(self) -> (f32, UnityEngine::Vector3)
    = extern self.ToAngleAxis(out f32 angle, out UnityEngine::Vector3 axis)

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn to_string(self, format: string) -> string
    = extern self.ToString(format)

  pub fn to_string(self, format: string, format_provider: System::IFormatProvider) -> string
    = extern self.ToString(format, format_provider)

  pub fn euler_angles(self) -> UnityEngine::Vector3
    = extern self.eulerAngles

  pub fn identity -> Self
    = extern UnityEngine.Quaternion.identity

  pub fn normalized(self) -> Self
    = extern self.normalized

  pub fn set_euler_angles(self, value: UnityEngine::Vector3)
    = extern self.eulerAngles = value

  pub fn k_epsilon -> f32
    = extern UnityEngine.Quaternion.kEpsilon
}
