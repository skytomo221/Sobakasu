public function assert(condition: bool)
  = extern UnityEngine.Debug.Assert(condition)

public function assert(condition: bool, message: object)
  = extern UnityEngine.Debug.Assert(condition, message)

public function assert(condition: bool, message: object, context: UnityEngine::Object)
  = extern UnityEngine.Debug.Assert(condition, message, context)

public function assert(condition: bool, message: string)
  = extern UnityEngine.Debug.Assert(condition, message)

public function assert(condition: bool, message: string, context: UnityEngine::Object)
  = extern UnityEngine.Debug.Assert(condition, message, context)

public function assert(condition: bool, context: UnityEngine::Object)
  = extern UnityEngine.Debug.Assert(condition, context)

public function debug_break()
  = extern UnityEngine.Debug.DebugBreak()

public function draw_line(start: UnityEngine::Vector3, end: UnityEngine::Vector3)
  = extern UnityEngine.Debug.DrawLine(start, end)

public function draw_line(start: UnityEngine::Vector3, end: UnityEngine::Vector3, color: UnityEngine::Color)
  = extern UnityEngine.Debug.DrawLine(start, end, color)

public function draw_line(start: UnityEngine::Vector3, end: UnityEngine::Vector3, color: UnityEngine::Color, duration: f32)
  = extern UnityEngine.Debug.DrawLine(start, end, color, duration)

public function draw_line(start: UnityEngine::Vector3, end: UnityEngine::Vector3, color: UnityEngine::Color, duration: f32, depth_test: bool)
  = extern UnityEngine.Debug.DrawLine(start, end, color, duration, depth_test)

public function draw_ray(start: UnityEngine::Vector3, dir: UnityEngine::Vector3)
  = extern UnityEngine.Debug.DrawRay(start, dir)

public function draw_ray(start: UnityEngine::Vector3, dir: UnityEngine::Vector3, color: UnityEngine::Color)
  = extern UnityEngine.Debug.DrawRay(start, dir, color)

public function draw_ray(start: UnityEngine::Vector3, dir: UnityEngine::Vector3, color: UnityEngine::Color, duration: f32)
  = extern UnityEngine.Debug.DrawRay(start, dir, color, duration)

public function draw_ray(start: UnityEngine::Vector3, dir: UnityEngine::Vector3, color: UnityEngine::Color, duration: f32, depth_test: bool)
  = extern UnityEngine.Debug.DrawRay(start, dir, color, duration, depth_test)

public function equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.Equals(obj_a, obj_b)

public function log_assertion(message: object)
  = extern UnityEngine.Debug.LogAssertion(message)

public function log_assertion(message: object, context: UnityEngine::Object)
  = extern UnityEngine.Debug.LogAssertion(message, context)

public function log_error(message: object)
  = extern UnityEngine.Debug.LogError(message)

public function log_error(message: object, context: UnityEngine::Object)
  = extern UnityEngine.Debug.LogError(message, context)

public function log_exception(exception: System::Exception)
  = extern UnityEngine.Debug.LogException(exception)

public function log_exception(exception: System::Exception, context: UnityEngine::Object)
  = extern UnityEngine.Debug.LogException(exception, context)

public function log_warning(message: object)
  = extern UnityEngine.Debug.LogWarning(message)

public function log_warning(message: object, context: UnityEngine::Object)
  = extern UnityEngine.Debug.LogWarning(message, context)

public function log(message: object)
  = extern UnityEngine.Debug.Log(message)

public function log(message: object, context: UnityEngine::Object)
  = extern UnityEngine.Debug.Log(message, context)

public function reference_equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.ReferenceEquals(obj_a, obj_b)
