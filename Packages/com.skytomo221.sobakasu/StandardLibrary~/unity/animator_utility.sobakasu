pub impl AnimatorUtility = extern UnityEngine.AnimatorUtility {
  pub static fn new() -> Self
    = extern new Self()

  pub static fn deoptimize_transform_hierarchy(go: UnityEngine.GameObject)
    = extern UnityEngine.AnimatorUtility.DeoptimizeTransformHierarchy(go)

  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn optimize_transform_hierarchy(go: UnityEngine.GameObject, exposed_transforms: [string])
    = extern UnityEngine.AnimatorUtility.OptimizeTransformHierarchy(go, exposed_transforms)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn equals(obj: object) -> bool
    = extern self.Equals(obj)

  pub fn get_hash_code() -> i32
    = extern self.GetHashCode()

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn to_string() -> string
    = extern self.ToString()
}
