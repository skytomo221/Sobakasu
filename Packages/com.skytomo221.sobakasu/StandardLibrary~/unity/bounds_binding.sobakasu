public struct Bounds = extern UnityEngine.Bounds {
}

implementation Bounds {
  public function new(center: UnityEngine::Vector3, size: UnityEngine::Vector3) -> Self
    = extern new Self(center, size)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function ==(self, rhs: Self) -> bool
    = extern self == rhs

  public function !=(self, rhs: Self) -> bool
    = extern self != rhs

  public function closest_point(self, point: UnityEngine::Vector3) -> UnityEngine::Vector3
    = extern self.ClosestPoint(point)

  public function contains(self, point: UnityEngine::Vector3) -> bool
    = extern self.Contains(point)

  public function encapsulate(self, bounds: Self)
    = extern self.Encapsulate(bounds)

  public function encapsulate(self, point: UnityEngine::Vector3)
    = extern self.Encapsulate(point)

  public function equals(self, other: object) -> bool
    = extern self.Equals(other)

  public function equals(self, other: Self) -> bool
    = extern self.Equals(other)

  public function expand(self, amount: f32)
    = extern self.Expand(amount)

  public function expand(self, amount: UnityEngine::Vector3)
    = extern self.Expand(amount)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function intersect_ray(self, ray: UnityEngine::Ray) -> bool
    = extern self.IntersectRay(UnityEngine::Ray ray)

  public function intersect_ray_with_distance(self, ray: UnityEngine::Ray) -> (bool, f32)
    = extern self.IntersectRay(UnityEngine::Ray ray, out f32 distance)

  public function intersects(self, bounds: Self) -> bool
    = extern self.Intersects(bounds)

  public function set_min_max(self, min: UnityEngine::Vector3, max: UnityEngine::Vector3)
    = extern self.SetMinMax(min, max)

  public function sqr_distance(self, point: UnityEngine::Vector3) -> f32
    = extern self.SqrDistance(point)

  public function to_string(self) -> string
    = extern self.ToString()

  public function to_string(self, format: string) -> string
    = extern self.ToString(format)

  public function to_string(self, format: string, format_provider: System::IFormatProvider) -> string
    = extern self.ToString(format, format_provider)

  public function center(self) -> UnityEngine::Vector3
    = extern self.center

  public function extents(self) -> UnityEngine::Vector3
    = extern self.extents

  public function max(self) -> UnityEngine::Vector3
    = extern self.max

  public function min(self) -> UnityEngine::Vector3
    = extern self.min

  public function size(self) -> UnityEngine::Vector3
    = extern self.size

  public function set_center(self, value: UnityEngine::Vector3)
    = extern self.center = value

  public function set_extents(self, value: UnityEngine::Vector3)
    = extern self.extents = value

  public function set_max(self, value: UnityEngine::Vector3)
    = extern self.max = value

  public function set_min(self, value: UnityEngine::Vector3)
    = extern self.min = value

  public function set_size(self, value: UnityEngine::Vector3)
    = extern self.size = value
}
