use maybe::Maybe;

public struct JointLimits = extern UnityEngine.JointLimits {
}

implementation JointLimits {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function bounce_min_velocity(mutable self) -> f32
    = extern self.bounceMinVelocity

  public function bounciness(mutable self) -> f32
    = extern self.bounciness

  public function contact_distance(mutable self) -> f32
    = extern self.contactDistance

  public function max(mutable self) -> f32
    = extern self.max

  public function min(mutable self) -> f32
    = extern self.min

  public function set_bounce_min_velocity(mutable self, value: f32)
    = extern self.bounceMinVelocity = value

  public function set_bounciness(mutable self, value: f32)
    = extern self.bounciness = value

  public function set_contact_distance(mutable self, value: f32)
    = extern self.contactDistance = value

  public function set_max(mutable self, value: f32)
    = extern self.max = value

  public function set_min(mutable self, value: f32)
    = extern self.min = value
}
