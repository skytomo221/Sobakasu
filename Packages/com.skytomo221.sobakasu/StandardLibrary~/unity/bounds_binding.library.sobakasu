use maybe::Maybe;

public struct Bounds = extern UnityEngine.Bounds {
}

implementation Bounds {
  public function new(center: UnityEngine::Vector3, size: UnityEngine::Vector3) -> Self
    = extern new Self(center, size)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function ==(self, rhs: Self) -> bool
    = extern self == rhs

  public function !=(self, rhs: Self) -> bool
    = extern self != rhs

  public function closest_point(mutable self, point: UnityEngine::Vector3) -> UnityEngine::Vector3
    = extern self.ClosestPoint(point)

  public function contains(mutable self, point: UnityEngine::Vector3) -> bool
    = extern self.Contains(point)

  public function encapsulate(mutable self, bounds: Self)
    = extern self.Encapsulate(bounds)

  public function encapsulate(mutable self, point: UnityEngine::Vector3)
    = extern self.Encapsulate(point)

  public function equals(mutable self, other: object) -> bool
    = extern self.Equals(other)

  public function equals(mutable self, other: Self) -> bool
    = extern self.Equals(other)

  public function expand(mutable self, amount: f32)
    = extern self.Expand(amount)

  public function expand(mutable self, amount: UnityEngine::Vector3)
    = extern self.Expand(amount)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function intersect_ray(mutable self, ray: UnityEngine::Ray) -> bool
    = extern self.IntersectRay(UnityEngine::Ray ray)

  public function intersect_ray_with_distance(mutable self, ray: UnityEngine::Ray) -> (bool, f32)
    = extern self.IntersectRay(UnityEngine::Ray ray, out f32 distance)

  public function intersects(mutable self, bounds: Self) -> bool
    = extern self.Intersects(bounds)

  public function set_min_max(mutable self, min: UnityEngine::Vector3, max: UnityEngine::Vector3)
    = extern self.SetMinMax(min, max)

  public function sqr_distance(mutable self, point: UnityEngine::Vector3) -> f32
    = extern self.SqrDistance(point)

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function to_string(mutable self, format: string) -> Maybe<string>
    = maybe extern self.ToString(format)

  public function to_string(mutable self, format: string, format_provider: System::IFormatProvider) -> Maybe<string>
    = maybe extern self.ToString(format, format_provider)

  public function center(mutable self) -> UnityEngine::Vector3
    = extern self.center

  public function extents(mutable self) -> UnityEngine::Vector3
    = extern self.extents

  public function max(mutable self) -> UnityEngine::Vector3
    = extern self.max

  public function min(mutable self) -> UnityEngine::Vector3
    = extern self.min

  public function size(mutable self) -> UnityEngine::Vector3
    = extern self.size

  public function set_center(mutable self, value: UnityEngine::Vector3)
    = extern self.center = value

  public function set_extents(mutable self, value: UnityEngine::Vector3)
    = extern self.extents = value

  public function set_max(mutable self, value: UnityEngine::Vector3)
    = extern self.max = value

  public function set_min(mutable self, value: UnityEngine::Vector3)
    = extern self.min = value

  public function set_size(mutable self, value: UnityEngine::Vector3)
    = extern self.size = value
}
