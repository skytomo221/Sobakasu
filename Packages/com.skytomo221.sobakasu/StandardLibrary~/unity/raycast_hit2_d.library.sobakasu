  public function transform(mutable self) -> Maybe<UnityEngine::Transform>
    = maybe extern self.transform

  public function set_centroid(mutable self, value: UnityEngine::Vector2)
    = extern self.centroid = value

  public function set_distance(mutable self, value: f32)
    = extern self.distance = value

  public function set_fraction(mutable self, value: f32)
