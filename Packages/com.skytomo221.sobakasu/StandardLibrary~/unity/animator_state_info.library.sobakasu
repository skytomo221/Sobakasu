use maybe::Maybe;

public struct AnimatorStateInfo = extern UnityEngine.AnimatorStateInfo {
}

implementation AnimatorStateInfo {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(mutable self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function name?(mutable self, name: string) -> bool
    = extern self.IsName(name)

  public function tag?(mutable self, tag: string) -> bool
    = extern self.IsTag(tag)

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function full_path_hash(mutable self) -> i32
    = extern self.fullPathHash

  public function length(mutable self) -> f32
    = extern self.length

  public function `loop`(mutable self) -> bool
    = extern self.`loop`

  public function normalized_time(mutable self) -> f32
    = extern self.normalizedTime

  public function short_name_hash(mutable self) -> i32
    = extern self.shortNameHash

  public function speed_multiplier(mutable self) -> f32
    = extern self.speedMultiplier

  public function speed(mutable self) -> f32
    = extern self.speed

  public function tag_hash(mutable self) -> i32
    = extern self.tagHash
}
