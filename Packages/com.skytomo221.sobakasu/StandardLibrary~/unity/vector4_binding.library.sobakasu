use maybe::Maybe;

public struct Vector4 = extern UnityEngine.Vector4 {
  w: f32 = extern w,
  x: f32 = extern x,
  y: f32 = extern y,
  z: f32 = extern z,
}

implementation Vector4 {
  public function new(x: f32, y: f32) -> Self
    = extern new Self(x, y)

  public function new(x: f32, y: f32, z: f32) -> Self
    = extern new Self(x, y, z)

  public function new(x: f32, y: f32, z: f32, w: f32) -> Self
    = extern new Self(x, y, z, w)

  public function distance(a: Self, b: Self) -> f32
    = extern UnityEngine.Vector4.Distance(a, b)

  public function dot(a: Self, b: Self) -> f32
    = extern UnityEngine.Vector4.Dot(a, b)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function lerp_unclamped(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Vector4.LerpUnclamped(a, b, t)

  public function lerp(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Vector4.Lerp(a, b, t)

  public function magnitude(a: Self) -> f32
    = extern UnityEngine.Vector4.Magnitude(a)

  public function max(lhs: Self, rhs: Self) -> Self
    = extern UnityEngine.Vector4.Max(lhs, rhs)

  public function min(lhs: Self, rhs: Self) -> Self
    = extern UnityEngine.Vector4.Min(lhs, rhs)

  public function move_towards(current: Self, target: Self, max_distance_delta: f32) -> Self
    = extern UnityEngine.Vector4.MoveTowards(current, target, max_distance_delta)

  public function normalize(a: Self) -> Self
    = extern UnityEngine.Vector4.Normalize(a)

  public function project(a: Self, b: Self) -> Self
    = extern UnityEngine.Vector4.Project(a, b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function scale(a: Self, b: Self) -> Self
    = extern UnityEngine.Vector4.Scale(a, b)

  public function sqr_magnitude(a: Self) -> f32
    = extern UnityEngine.Vector4.SqrMagnitude(a)

  public function +(self, rhs: Self) -> Self
    = extern self + rhs

  public function /(self, rhs: f32) -> Self
    = extern self / rhs

  public function ==(self, rhs: Self) -> bool
    = extern self == rhs

  public function !=(self, rhs: Self) -> bool
    = extern self != rhs

  public function *(self, rhs: f32) -> Self
    = extern self * rhs

  public function -(self, rhs: Self) -> Self
    = extern self - rhs

  public function @-(self) -> Self
    = extern -self

  public function equals(mutable self, other: object) -> bool
    = extern self.Equals(other)

  public function equals(mutable self, other: Self) -> bool
    = extern self.Equals(other)

  public function get_hash_code(mutable self) -> i32
    = extern self.GetHashCode()

  public function get_type(mutable self) -> Maybe<System::Type>
    = maybe extern self.GetType()

  public function normalize(mutable self)
    = extern self.Normalize()

  public function scale(mutable self, scale: Self)
    = extern self.Scale(scale)

  public function set(mutable self, new_x: f32, new_y: f32, new_z: f32, new_w: f32)
    = extern self.Set(new_x, new_y, new_z, new_w)

  public function calculate_sqr_magnitude(mutable self) -> f32
    = extern self.SqrMagnitude()

  public function to_string(mutable self) -> Maybe<string>
    = maybe extern self.ToString()

  public function to_string(mutable self, format: string) -> Maybe<string>
    = maybe extern self.ToString(format)

  public function to_string(mutable self, format: string, format_provider: System::IFormatProvider) -> Maybe<string>
    = maybe extern self.ToString(format, format_provider)

  public function magnitude(mutable self) -> f32
    = extern self.magnitude

  public function negative_infinity -> Self
    = extern UnityEngine.Vector4.negativeInfinity

  public function normalized(mutable self) -> Self
    = extern self.normalized

  public function one -> Self
    = extern UnityEngine.Vector4.one

  public function positive_infinity -> Self
    = extern UnityEngine.Vector4.positiveInfinity

  public function sqr_magnitude(mutable self) -> f32
    = extern self.sqrMagnitude

  public function zero -> Self
    = extern UnityEngine.Vector4.zero

  public function k_epsilon -> f32
    = extern UnityEngine.Vector4.kEpsilon
}
