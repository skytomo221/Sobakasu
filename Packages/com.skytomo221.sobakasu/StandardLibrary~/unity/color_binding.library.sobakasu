public struct Color = extern UnityEngine.Color {
  a: f32 = extern a,
  b: f32 = extern b,
  g: f32 = extern g,
  r: f32 = extern r,
}

implementation Color {
  public function new(r: f32, g: f32, b: f32) -> Self
    = extern new Self(r, g, b)

  public function new(r: f32, g: f32, b: f32, a: f32) -> Self
    = extern new Self(r, g, b, a)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function hsv_to_rgb(h: f32, s: f32, v: f32) -> Self
    = extern UnityEngine.Color.HSVToRGB(h, s, v)

  public function hsv_to_rgb(h: f32, s: f32, v: f32, hdr: bool) -> Self
    = extern UnityEngine.Color.HSVToRGB(h, s, v, hdr)

  public function lerp_unclamped(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Color.LerpUnclamped(a, b, t)

  public function lerp(a: Self, b: Self, t: f32) -> Self
    = extern UnityEngine.Color.Lerp(a, b, t)

  public function rgb_to_hsv(rgb_color: Self) -> (f32, f32, f32)
    = extern UnityEngine.Color.RGBToHSV(Self rgb_color, out f32 h, out f32 s, out f32 v)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function +(self, rhs: Self) -> Self
    = extern self + rhs

  public function /(self, rhs: f32) -> Self
    = extern self / rhs

  public function ==(self, rhs: Self) -> bool
    = extern self == rhs

  public function !=(self, rhs: Self) -> bool
    = extern self != rhs

  public function *(self, rhs: f32) -> Self
    = extern self * rhs

  public function *(self, rhs: Self) -> Self
    = extern self * rhs

  public function -(self, rhs: Self) -> Self
    = extern self - rhs

  public function equals(self, other: object) -> bool
    = extern self.Equals(other)

  public function equals(self, other: Self) -> bool
    = extern self.Equals(other)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function to_string(self) -> string
    = extern self.ToString()

  public function to_string(self, format: string) -> string
    = extern self.ToString(format)

  public function to_string(self, format: string, format_provider: System::IFormatProvider) -> string
    = extern self.ToString(format, format_provider)

  public function black -> Self
    = extern UnityEngine.Color.black

  public function blue -> Self
    = extern UnityEngine.Color.blue

  public function clear -> Self
    = extern UnityEngine.Color.clear

  public function cyan -> Self
    = extern UnityEngine.Color.cyan

  public function gamma(self) -> Self
    = extern self.gamma

  public function grayscale(self) -> f32
    = extern self.grayscale

  public function gray -> Self
    = extern UnityEngine.Color.gray

  public function green -> Self
    = extern UnityEngine.Color.green

  public function grey -> Self
    = extern UnityEngine.Color.grey

  public function linear(self) -> Self
    = extern self.linear

  public function magenta -> Self
    = extern UnityEngine.Color.magenta

  public function max_color_component(self) -> f32
    = extern self.maxColorComponent

  public function red -> Self
    = extern UnityEngine.Color.red

  public function white -> Self
    = extern UnityEngine.Color.white

  public function yellow -> Self
    = extern UnityEngine.Color.yellow
}
