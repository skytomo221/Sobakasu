public type AnimationState = extern UnityEngine.AnimationState;

implementation AnimationState {
  public function new() -> Self
    = extern new Self()

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function add_mixing_transform(self, mix: UnityEngine::Transform)
    = extern self.AddMixingTransform(mix)

  public function add_mixing_transform(self, mix: UnityEngine::Transform, recursive: bool)
    = extern self.AddMixingTransform(mix, recursive)

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function remove_mixing_transform(self, mix: UnityEngine::Transform)
    = extern self.RemoveMixingTransform(mix)

  public function to_string(self) -> string
    = extern self.ToString()

  public function blend_mode(self) -> UnityEngine::AnimationBlendMode
    = extern self.blendMode

  public function clip(self) -> UnityEngine::AnimationClip
    = extern self.clip

  public function enabled(self) -> bool
    = extern self.enabled

  public function layer(self) -> i32
    = extern self.layer

  public function length(self) -> f32
    = extern self.length

  public function name(self) -> string
    = extern self.name

  public function normalized_speed(self) -> f32
    = extern self.normalizedSpeed

  public function normalized_time(self) -> f32
    = extern self.normalizedTime

  public function speed(self) -> f32
    = extern self.speed

  public function time(self) -> f32
    = extern self.time

  public function weight(self) -> f32
    = extern self.weight

  public function wrap_mode(self) -> UnityEngine::WrapMode
    = extern self.wrapMode

  public function set_blend_mode(self, value: UnityEngine::AnimationBlendMode)
    = extern self.blendMode = value

  public function set_enabled(self, value: bool)
    = extern self.enabled = value

  public function set_layer(self, value: i32)
    = extern self.layer = value

  public function set_name(self, value: string)
    = extern self.name = value

  public function set_normalized_speed(self, value: f32)
    = extern self.normalizedSpeed = value

  public function set_normalized_time(self, value: f32)
    = extern self.normalizedTime = value

  public function set_speed(self, value: f32)
    = extern self.speed = value

  public function set_time(self, value: f32)
    = extern self.time = value

  public function set_weight(self, value: f32)
    = extern self.weight = value

  public function set_wrap_mode(self, value: UnityEngine::WrapMode)
    = extern self.wrapMode = value
}
