public type HumanPoseHandler = extern UnityEngine.HumanPoseHandler;

implementation HumanPoseHandler {
  public function new(avatar: UnityEngine::Avatar, joint_paths: [string]) -> Self
    = extern new Self(avatar, joint_paths)

  public function new(avatar: UnityEngine::Avatar, root: UnityEngine::Transform) -> Self
    = extern new Self(avatar, root)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function dispose(self)
    = extern self.Dispose()

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_human_pose(self, human_pose: UnityEngine::HumanPose) -> UnityEngine::HumanPose
    = extern self.GetHumanPose(ref UnityEngine::HumanPose human_pose)

  public function get_internal_human_pose(self, human_pose: UnityEngine::HumanPose) -> UnityEngine::HumanPose
    = extern self.GetInternalHumanPose(ref UnityEngine::HumanPose human_pose)

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function set_human_pose(self, human_pose: UnityEngine::HumanPose) -> UnityEngine::HumanPose
    = extern self.SetHumanPose(ref UnityEngine::HumanPose human_pose)

  public function set_internal_human_pose(self, human_pose: UnityEngine::HumanPose) -> UnityEngine::HumanPose
    = extern self.SetInternalHumanPose(ref UnityEngine::HumanPose human_pose)

  public function to_string(self) -> string
    = extern self.ToString()
}
