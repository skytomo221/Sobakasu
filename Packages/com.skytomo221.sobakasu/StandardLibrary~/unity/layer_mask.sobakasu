public struct LayerMask = extern UnityEngine.LayerMask {
}

implementation LayerMask {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function layer_to_name(layer: i32) -> string
    = extern UnityEngine.LayerMask.LayerToName(layer)

  public function name_to_layer(layer_name: string) -> i32
    = extern UnityEngine.LayerMask.NameToLayer(layer_name)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function value(self) -> i32
    = extern self.value

  public function set_value(self, value: i32)
    = extern self.value = value
}
