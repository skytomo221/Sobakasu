pub struct Vector2Int = extern UnityEngine.Vector2Int {
}

impl Vector2Int {
  pub fn new(x: i32, y: i32) -> Self
    = extern new Self(x, y)

  pub fn ceil_to_int(v: UnityEngine::Vector2) -> Self
    = extern UnityEngine.Vector2Int.CeilToInt(v)

  pub fn distance(a: Self, b: Self) -> f32
    = extern UnityEngine.Vector2Int.Distance(a, b)

  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn floor_to_int(v: UnityEngine::Vector2) -> Self
    = extern UnityEngine.Vector2Int.FloorToInt(v)

  pub fn max(lhs: Self, rhs: Self) -> Self
    = extern UnityEngine.Vector2Int.Max(lhs, rhs)

  pub fn min(lhs: Self, rhs: Self) -> Self
    = extern UnityEngine.Vector2Int.Min(lhs, rhs)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn round_to_int(v: UnityEngine::Vector2) -> Self
    = extern UnityEngine.Vector2Int.RoundToInt(v)

  pub fn scale(a: Self, b: Self) -> Self
    = extern UnityEngine.Vector2Int.Scale(a, b)

  pub fn +(self, rhs: Self) -> Self
    = extern self + rhs

  pub fn /(self, rhs: i32) -> Self
    = extern self / rhs

  pub fn ==(self, rhs: Self) -> bool
    = extern self == rhs

  pub fn !=(self, rhs: Self) -> bool
    = extern self != rhs

  pub fn *(self, rhs: i32) -> Self
    = extern self * rhs

  pub fn *(self, rhs: Self) -> Self
    = extern self * rhs

  pub fn -(self, rhs: Self) -> Self
    = extern self - rhs

  pub fn @-(self) -> Self
    = extern -self

  pub fn clamp(self, min: Self, max: Self)
    = extern self.Clamp(min, max)

  pub fn equals(self, other: object) -> bool
    = extern self.Equals(other)

  pub fn equals(self, other: Self) -> bool
    = extern self.Equals(other)

  pub fn get_hash_code(self) -> i32
    = extern self.GetHashCode()

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn scale(self, scale: Self)
    = extern self.Scale(scale)

  pub fn set(self, x: i32, y: i32)
    = extern self.Set(x, y)

  pub fn to_string(self) -> string
    = extern self.ToString()

  pub fn to_string(self, format: string) -> string
    = extern self.ToString(format)

  pub fn to_string(self, format: string, format_provider: System::IFormatProvider) -> string
    = extern self.ToString(format, format_provider)

  pub fn down -> Self
    = extern UnityEngine.Vector2Int.down

  pub fn left -> Self
    = extern UnityEngine.Vector2Int.left

  pub fn magnitude(self) -> f32
    = extern self.magnitude

  pub fn one -> Self
    = extern UnityEngine.Vector2Int.one

  pub fn right -> Self
    = extern UnityEngine.Vector2Int.right

  pub fn sqr_magnitude(self) -> i32
    = extern self.sqrMagnitude

  pub fn up -> Self
    = extern UnityEngine.Vector2Int.up

  pub fn x(self) -> i32
    = extern self.x

  pub fn y(self) -> i32
    = extern self.y

  pub fn zero -> Self
    = extern UnityEngine.Vector2Int.zero

  pub fn set_x(self, value: i32)
    = extern self.x = value

  pub fn set_y(self, value: i32)
    = extern self.y = value
