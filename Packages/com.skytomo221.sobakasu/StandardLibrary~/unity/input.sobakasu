pub fn equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.Equals(obj_a, obj_b)

pub fn get_axis_raw(axis_name: string) -> f32
  = extern UnityEngine.Input.GetAxisRaw(axis_name)

pub fn get_axis(axis_name: string) -> f32
  = extern UnityEngine.Input.GetAxis(axis_name)

pub fn get_button_down(button_name: string) -> bool
  = extern UnityEngine.Input.GetButtonDown(button_name)

pub fn get_button_up(button_name: string) -> bool
  = extern UnityEngine.Input.GetButtonUp(button_name)

pub fn get_button(button_name: string) -> bool
  = extern UnityEngine.Input.GetButton(button_name)

pub fn get_joystick_names() -> [string]
  = extern UnityEngine.Input.GetJoystickNames()

pub fn get_key_down(name: string) -> bool
  = extern UnityEngine.Input.GetKeyDown(name)

pub fn get_key_down(key: UnityEngine.KeyCode) -> bool
  = extern UnityEngine.Input.GetKeyDown(key)

pub fn get_key_up(name: string) -> bool
  = extern UnityEngine.Input.GetKeyUp(name)

pub fn get_key_up(key: UnityEngine.KeyCode) -> bool
  = extern UnityEngine.Input.GetKeyUp(key)

pub fn get_key(name: string) -> bool
  = extern UnityEngine.Input.GetKey(name)

pub fn get_key(key: UnityEngine.KeyCode) -> bool
  = extern UnityEngine.Input.GetKey(key)

pub fn get_mouse_button_down(button: i32) -> bool
  = extern UnityEngine.Input.GetMouseButtonDown(button)

pub fn get_mouse_button_up(button: i32) -> bool
  = extern UnityEngine.Input.GetMouseButtonUp(button)

pub fn get_mouse_button(button: i32) -> bool
  = extern UnityEngine.Input.GetMouseButton(button)

pub fn reference_equals(obj_a: object, obj_b: object) -> bool
  = extern System.Object.ReferenceEquals(obj_a, obj_b)

pub fn any_key_down -> bool
  = extern UnityEngine.Input.anyKeyDown

pub fn any_key -> bool
  = extern UnityEngine.Input.anyKey

pub fn ime_is_selected -> bool
  = extern UnityEngine.Input.imeIsSelected

pub fn input_string -> string
  = extern UnityEngine.Input.inputString
