pub enum MeshColliderCookingOptions = extern UnityEngine.MeshColliderCookingOptions {
  None = extern None,
  InflateConvexMesh = extern InflateConvexMesh,
  CookForFasterSimulation = extern CookForFasterSimulation,
  EnableMeshCleaning = extern EnableMeshCleaning,
  WeldColocatedVertices = extern WeldColocatedVertices,
  UseFastMidphase = extern UseFastMidphase,
}
