public struct GradientColorKey = extern UnityEngine.GradientColorKey {
  color: UnityEngine::Color = extern color,
  time: f32 = extern time,
}

implementation GradientColorKey {
  public function new(col: UnityEngine::Color, time: f32) -> Self
    = extern new Self(col, time)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function get_type(self) -> System::Type
    = extern self.GetType()
}
