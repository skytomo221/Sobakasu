public type Collision = extern UnityEngine.Collision;

implementation Collision {
  public function new() -> Self
    = extern new Self()

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(self, obj: object) -> bool
    = extern self.Equals(obj)

  public function get_contacts(self, contacts: System::Collections::Generic::List<UnityEngine::ContactPoint>) -> i32
    = extern self.GetContacts(contacts)

  public function get_contacts(self, contacts: [UnityEngine::ContactPoint]) -> i32
    = extern self.GetContacts(contacts)

  public function get_contact(self, index: i32) -> UnityEngine::ContactPoint
    = extern self.GetContact(index)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function to_string(self) -> string
    = extern self.ToString()

  public function articulation_body(self) -> UnityEngine::ArticulationBody
    = extern self.articulationBody

  public function body(self) -> UnityEngine::Component
    = extern self.body

  public function collider(self) -> UnityEngine::Collider
    = extern self.collider

  public function contact_count(self) -> i32
    = extern self.contactCount

  public function contacts(self) -> [UnityEngine::ContactPoint]
    = extern self.contacts

  public function game_object(self) -> UnityEngine::GameObject
    = extern self.gameObject

  public function impulse(self) -> UnityEngine::Vector3
    = extern self.impulse

  public function relative_velocity(self) -> UnityEngine::Vector3
    = extern self.relativeVelocity

  public function rigidbody(self) -> UnityEngine::Rigidbody
    = extern self.rigidbody

  public function transform(self) -> UnityEngine::Transform
    = extern self.transform
}
