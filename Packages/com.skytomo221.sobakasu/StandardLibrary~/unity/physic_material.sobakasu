public type PhysicMaterial = extern UnityEngine.PhysicMaterial;

implementation PhysicMaterial {
  public function destroy_immediate(obj: UnityEngine::Object)
    = extern UnityEngine.Object.DestroyImmediate(obj)

  public function destroy_immediate(obj: UnityEngine::Object, allow_destroying_assets: bool)
    = extern UnityEngine.Object.DestroyImmediate(obj, allow_destroying_assets)

  public function destroy(obj: UnityEngine::Object)
    = extern UnityEngine.Object.Destroy(obj)

  public function destroy(obj: UnityEngine::Object, t: f32)
    = extern UnityEngine.Object.Destroy(obj, t)

  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function equals(self, other: object) -> bool
    = extern self.Equals(other)

  public function get_hash_code(self) -> i32
    = extern self.GetHashCode()

  public function get_instance_id(self) -> i32
    = extern self.GetInstanceID()

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function to_string(self) -> string
    = extern self.ToString()

  public function bounce_combine(self) -> UnityEngine::PhysicMaterialCombine
    = extern self.bounceCombine

  public function bounciness(self) -> f32
    = extern self.bounciness

  public function dynamic_friction(self) -> f32
    = extern self.dynamicFriction

  public function friction_combine(self) -> UnityEngine::PhysicMaterialCombine
    = extern self.frictionCombine

  public function name(self) -> string
    = extern self.name

  public function static_friction(self) -> f32
    = extern self.staticFriction

  public function set_bounce_combine(self, value: UnityEngine::PhysicMaterialCombine)
    = extern self.bounceCombine = value

  public function set_bounciness(self, value: f32)
    = extern self.bounciness = value

  public function set_dynamic_friction(self, value: f32)
    = extern self.dynamicFriction = value

  public function set_friction_combine(self, value: UnityEngine::PhysicMaterialCombine)
    = extern self.frictionCombine = value

  public function set_name(self, value: string)
    = extern self.name = value

  public function set_static_friction(self, value: f32)
    = extern self.staticFriction = value
}
