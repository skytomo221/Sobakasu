use maybe::Maybe;

public enum VertexAttributeFormat = extern UnityEngine.Rendering.VertexAttributeFormat {
  Float16 = extern Float16,
  Float32 = extern Float32,
  SInt16 = extern SInt16,
  SInt32 = extern SInt32,
  SInt8 = extern SInt8,
  SNorm16 = extern SNorm16,
  SNorm8 = extern SNorm8,
  UInt16 = extern UInt16,
  UInt32 = extern UInt32,
  UInt8 = extern UInt8,
  UNorm16 = extern UNorm16,
  UNorm8 = extern UNorm8,
}
