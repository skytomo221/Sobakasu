pub enum MeshUpdateFlags = extern UnityEngine.Rendering.MeshUpdateFlags {
  Default = extern Default,
  DontValidateIndices = extern DontValidateIndices,
  DontResetBoneBounds = extern DontResetBoneBounds,
  DontNotifyMeshUsers = extern DontNotifyMeshUsers,
  DontRecalculateBounds = extern DontRecalculateBounds,
}
