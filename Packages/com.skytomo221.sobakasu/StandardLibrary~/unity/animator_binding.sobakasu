  pub fn set_update_mode(self, value: UnityEngine::AnimatorUpdateMode)
    = extern self.updateMode = value

  pub fn set_write_default_values_on_disable(self, value: bool)
    = extern self.writeDefaultValuesOnDisable = value
}
