pub struct WheelHit = extern UnityEngine.WheelHit {
}

impl WheelHit {
  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn collider(self) -> UnityEngine::Collider
    = extern self.collider

  pub fn force(self) -> f32
    = extern self.force

  pub fn forward_dir(self) -> UnityEngine::Vector3
    = extern self.forwardDir

  pub fn forward_slip(self) -> f32
    = extern self.forwardSlip

  pub fn normal(self) -> UnityEngine::Vector3
    = extern self.normal

  pub fn point(self) -> UnityEngine::Vector3
    = extern self.point

  pub fn sideways_dir(self) -> UnityEngine::Vector3
    = extern self.sidewaysDir

  pub fn sideways_slip(self) -> f32
    = extern self.sidewaysSlip

  pub fn set_collider(self, value: UnityEngine::Collider)
    = extern self.collider = value

  pub fn set_force(self, value: f32)
    = extern self.force = value

  pub fn set_forward_dir(self, value: UnityEngine::Vector3)
    = extern self.forwardDir = value

  pub fn set_forward_slip(self, value: f32)
    = extern self.forwardSlip = value

  pub fn set_normal(self, value: UnityEngine::Vector3)
    = extern self.normal = value

  pub fn set_point(self, value: UnityEngine::Vector3)
    = extern self.point = value

  pub fn set_sideways_dir(self, value: UnityEngine::Vector3)
    = extern self.sidewaysDir = value

  pub fn set_sideways_slip(self, value: f32)
    = extern self.sidewaysSlip = value
}
