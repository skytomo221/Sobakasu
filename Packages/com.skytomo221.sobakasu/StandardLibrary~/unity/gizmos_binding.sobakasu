pub impl Gizmos = extern UnityEngine.Gizmos {
  pub static fn draw_cube(center: UnityEngine.Vector3, size: UnityEngine.Vector3)
    = extern UnityEngine.Gizmos.DrawCube(center, size)

  pub static fn draw_frustum(center: UnityEngine.Vector3, fov: f32, max_range: f32, min_range: f32, aspect: f32)
    = extern UnityEngine.Gizmos.DrawFrustum(center, fov, max_range, min_range, aspect)

  pub static fn draw_gui_texture(screen_rect: UnityEngine.Rect, texture: UnityEngine.Texture)
    = extern UnityEngine.Gizmos.DrawGUITexture(screen_rect, texture)

  pub static fn draw_gui_texture(screen_rect: UnityEngine.Rect, texture: UnityEngine.Texture, left_border: i32, right_border: i32, top_border: i32, bottom_border: i32)
    = extern UnityEngine.Gizmos.DrawGUITexture(screen_rect, texture, left_border, right_border, top_border, bottom_border)

  pub static fn draw_gui_texture(screen_rect: UnityEngine.Rect, texture: UnityEngine.Texture, left_border: i32, right_border: i32, top_border: i32, bottom_border: i32, mat: UnityEngine.Material)
    = extern UnityEngine.Gizmos.DrawGUITexture(screen_rect, texture, left_border, right_border, top_border, bottom_border, mat)

  pub static fn draw_gui_texture(screen_rect: UnityEngine.Rect, texture: UnityEngine.Texture, mat: UnityEngine.Material)
    = extern UnityEngine.Gizmos.DrawGUITexture(screen_rect, texture, mat)

  pub static fn draw_icon(center: UnityEngine.Vector3, name: string)
    = extern UnityEngine.Gizmos.DrawIcon(center, name)

  pub static fn draw_icon(center: UnityEngine.Vector3, name: string, allow_scaling: bool)
    = extern UnityEngine.Gizmos.DrawIcon(center, name, allow_scaling)

  pub static fn draw_icon(center: UnityEngine.Vector3, name: string, allow_scaling: bool, tint: UnityEngine.Color)
    = extern UnityEngine.Gizmos.DrawIcon(center, name, allow_scaling, tint)

  pub static fn draw_line(from: UnityEngine.Vector3, to_: UnityEngine.Vector3)
    = extern UnityEngine.Gizmos.DrawLine(from, to_)

  pub static fn draw_ray(r: UnityEngine.Ray)
    = extern UnityEngine.Gizmos.DrawRay(r)

  pub static fn draw_ray(from: UnityEngine.Vector3, direction: UnityEngine.Vector3)
    = extern UnityEngine.Gizmos.DrawRay(from, direction)

  pub static fn draw_sphere(center: UnityEngine.Vector3, radius: f32)
    = extern UnityEngine.Gizmos.DrawSphere(center, radius)

  pub static fn draw_wire_cube(center: UnityEngine.Vector3, size: UnityEngine.Vector3)
    = extern UnityEngine.Gizmos.DrawWireCube(center, size)

  pub static fn draw_wire_mesh(mesh: UnityEngine.Mesh)
    = extern UnityEngine.Gizmos.DrawWireMesh(mesh)

  pub static fn draw_wire_mesh(mesh: UnityEngine.Mesh, submesh_index: i32)
    = extern UnityEngine.Gizmos.DrawWireMesh(mesh, submesh_index)

  pub static fn draw_wire_mesh(mesh: UnityEngine.Mesh, submesh_index: i32, position: UnityEngine.Vector3)
    = extern UnityEngine.Gizmos.DrawWireMesh(mesh, submesh_index, position)

  pub static fn draw_wire_mesh(mesh: UnityEngine.Mesh, submesh_index: i32, position: UnityEngine.Vector3, rotation: UnityEngine.Quaternion)
    = extern UnityEngine.Gizmos.DrawWireMesh(mesh, submesh_index, position, rotation)

  pub static fn draw_wire_mesh(mesh: UnityEngine.Mesh, submesh_index: i32, position: UnityEngine.Vector3, rotation: UnityEngine.Quaternion, scale: UnityEngine.Vector3)
    = extern UnityEngine.Gizmos.DrawWireMesh(mesh, submesh_index, position, rotation, scale)

  pub static fn draw_wire_mesh(mesh: UnityEngine.Mesh, position: UnityEngine.Vector3)
    = extern UnityEngine.Gizmos.DrawWireMesh(mesh, position)

  pub static fn draw_wire_mesh(mesh: UnityEngine.Mesh, position: UnityEngine.Vector3, rotation: UnityEngine.Quaternion)
    = extern UnityEngine.Gizmos.DrawWireMesh(mesh, position, rotation)

  pub static fn draw_wire_mesh(mesh: UnityEngine.Mesh, position: UnityEngine.Vector3, rotation: UnityEngine.Quaternion, scale: UnityEngine.Vector3)
    = extern UnityEngine.Gizmos.DrawWireMesh(mesh, position, rotation, scale)

  pub static fn draw_wire_sphere(center: UnityEngine.Vector3, radius: f32)
    = extern UnityEngine.Gizmos.DrawWireSphere(center, radius)

  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn equals(obj: object) -> bool
    = extern self.Equals(obj)

  pub fn get_hash_code() -> i32
    = extern self.GetHashCode()

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn to_string() -> string
    = extern self.ToString()

  pub static fn color -> UnityEngine.Color
    = extern Self.color

  pub static fn matrix -> UnityEngine.Matrix4x4
    = extern Self.matrix

  pub static fn probe_size -> f32
    = extern Self.probeSize

  pub static fn set_color(value: UnityEngine.Color)
    = extern Self.color = value

  pub static fn set_matrix(value: UnityEngine.Matrix4x4)
    = extern Self.matrix = value
}
