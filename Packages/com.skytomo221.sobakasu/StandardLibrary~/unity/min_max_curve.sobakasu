pub struct MinMaxCurve = extern UnityEngine.ParticleSystem.MinMaxCurve {
}

impl MinMaxCurve {
  pub fn new(constant: f32) -> Self
    = extern new Self(constant)

  pub fn new(min: f32, max: f32) -> Self
    = extern new Self(min, max)

  pub fn new(multiplier: f32, curve: UnityEngine::AnimationCurve) -> Self
    = extern new Self(multiplier, curve)

  pub fn new(multiplier: f32, min: UnityEngine::AnimationCurve, max: UnityEngine::AnimationCurve) -> Self
    = extern new Self(multiplier, min, max)

  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn evaluate(self, time: f32) -> f32
    = extern self.Evaluate(time)

  pub fn evaluate(self, time: f32, lerp_factor: f32) -> f32
    = extern self.Evaluate(time, lerp_factor)

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn constant_max(self) -> f32
    = extern self.constantMax

  pub fn constant_min(self) -> f32
    = extern self.constantMin

  pub fn constant(self) -> f32
    = extern self.constant

  pub fn curve_max(self) -> UnityEngine::AnimationCurve
    = extern self.curveMax

  pub fn curve_min(self) -> UnityEngine::AnimationCurve
    = extern self.curveMin

  pub fn curve_multiplier(self) -> f32
    = extern self.curveMultiplier

  pub fn curve(self) -> UnityEngine::AnimationCurve
    = extern self.curve

  pub fn mode(self) -> UnityEngine::ParticleSystemCurveMode
    = extern self.mode

  pub fn set_constant_max(self, value: f32)
    = extern self.constantMax = value

  pub fn set_constant_min(self, value: f32)
    = extern self.constantMin = value

  pub fn set_constant(self, value: f32)
    = extern self.constant = value

  pub fn set_curve_max(self, value: UnityEngine::AnimationCurve)
    = extern self.curveMax = value

  pub fn set_curve_min(self, value: UnityEngine::AnimationCurve)
    = extern self.curveMin = value

  pub fn set_curve_multiplier(self, value: f32)
    = extern self.curveMultiplier = value

  pub fn set_curve(self, value: UnityEngine::AnimationCurve)
    = extern self.curve = value

  pub fn set_mode(self, value: UnityEngine::ParticleSystemCurveMode)
    = extern self.mode = value
}
