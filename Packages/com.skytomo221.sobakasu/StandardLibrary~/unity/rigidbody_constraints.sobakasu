pub enum RigidbodyConstraints = extern UnityEngine.RigidbodyConstraints {
  None = extern None,
  FreezePositionX = extern FreezePositionX,
  FreezePositionY = extern FreezePositionY,
  FreezePositionZ = extern FreezePositionZ,
  FreezePosition = extern FreezePosition,
  FreezeRotationX = extern FreezeRotationX,
  FreezeRotationY = extern FreezeRotationY,
  FreezeRotationZ = extern FreezeRotationZ,
  FreezeRotation = extern FreezeRotation,
  FreezeAll = extern FreezeAll,
}
