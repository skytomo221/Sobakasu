pub impl Sprite = extern UnityEngine.Sprite {
  pub static fn create(texture: UnityEngine.Texture2D, rect: UnityEngine.Rect, pivot: UnityEngine.Vector2) -> Self
    = extern UnityEngine.Sprite.Create(texture, rect, pivot)

  pub static fn create(texture: UnityEngine.Texture2D, rect: UnityEngine.Rect, pivot: UnityEngine.Vector2, pixels_per_unit: f32) -> Self
    = extern UnityEngine.Sprite.Create(texture, rect, pivot, pixels_per_unit)

  pub static fn create(texture: UnityEngine.Texture2D, rect: UnityEngine.Rect, pivot: UnityEngine.Vector2, pixels_per_unit: f32, extrude: u32) -> Self
    = extern UnityEngine.Sprite.Create(texture, rect, pivot, pixels_per_unit, extrude)

  pub static fn create(texture: UnityEngine.Texture2D, rect: UnityEngine.Rect, pivot: UnityEngine.Vector2, pixels_per_unit: f32, extrude: u32, mesh_type: UnityEngine.SpriteMeshType) -> Self
    = extern UnityEngine.Sprite.Create(texture, rect, pivot, pixels_per_unit, extrude, mesh_type)

  pub static fn create(texture: UnityEngine.Texture2D, rect: UnityEngine.Rect, pivot: UnityEngine.Vector2, pixels_per_unit: f32, extrude: u32, mesh_type: UnityEngine.SpriteMeshType, border: UnityEngine.Vector4) -> Self
    = extern UnityEngine.Sprite.Create(texture, rect, pivot, pixels_per_unit, extrude, mesh_type, border)

  pub static fn create(texture: UnityEngine.Texture2D, rect: UnityEngine.Rect, pivot: UnityEngine.Vector2, pixels_per_unit: f32, extrude: u32, mesh_type: UnityEngine.SpriteMeshType, border: UnityEngine.Vector4, generate_fallback_physics_shape: bool) -> Self
    = extern UnityEngine.Sprite.Create(texture, rect, pivot, pixels_per_unit, extrude, mesh_type, border, generate_fallback_physics_shape)

  pub static fn create(texture: UnityEngine.Texture2D, rect: UnityEngine.Rect, pivot: UnityEngine.Vector2, pixels_per_unit: f32, extrude: u32, mesh_type: UnityEngine.SpriteMeshType, border: UnityEngine.Vector4, generate_fallback_physics_shape: bool, secondary_textures: [UnityEngine.SecondarySpriteTexture]) -> Self
    = extern UnityEngine.Sprite.Create(texture, rect, pivot, pixels_per_unit, extrude, mesh_type, border, generate_fallback_physics_shape, secondary_textures)

  pub static fn destroy_immediate(obj: UnityEngine.Object)
    = extern UnityEngine.Object.DestroyImmediate(obj)

  pub static fn destroy_immediate(obj: UnityEngine.Object, allow_destroying_assets: bool)
    = extern UnityEngine.Object.DestroyImmediate(obj, allow_destroying_assets)

  pub static fn destroy(obj: UnityEngine.Object)
    = extern UnityEngine.Object.Destroy(obj)

  pub static fn destroy(obj: UnityEngine.Object, t: f32)
    = extern UnityEngine.Object.Destroy(obj, t)

  pub static fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub static fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub static fn op_equality(x: UnityEngine.Object, y: UnityEngine.Object) -> bool
    = extern UnityEngine.Object.op_Equality(x, y)

  pub static fn op_implicit(exists: UnityEngine.Object) -> bool
    = extern UnityEngine.Object.op_Implicit(exists)

  pub static fn op_inequality(x: UnityEngine.Object, y: UnityEngine.Object) -> bool
    = extern UnityEngine.Object.op_Inequality(x, y)

  pub fn equals(other: object) -> bool
    = extern self.Equals(other)

  pub fn get_hash_code() -> i32
    = extern self.GetHashCode()

  pub fn get_instance_id() -> i32
    = extern self.GetInstanceID()

  pub fn get_physics_shape_count() -> i32
    = extern self.GetPhysicsShapeCount()

  pub fn get_physics_shape_point_count(shape_idx: i32) -> i32
    = extern self.GetPhysicsShapePointCount(shape_idx)

  pub fn get_secondary_texture_count() -> i32
    = extern self.GetSecondaryTextureCount()

  pub fn get_secondary_textures(secondary_texture: [UnityEngine.SecondarySpriteTexture]) -> i32
    = extern self.GetSecondaryTextures(secondary_texture)

  pub fn get_type() -> System.Type
    = extern self.GetType()

  pub fn override_geometry(vertices: [UnityEngine.Vector2], triangles: [u16])
    = extern self.OverrideGeometry(vertices, triangles)

  pub fn to_string() -> string
    = extern self.ToString()

  pub fn associated_alpha_split_texture -> UnityEngine.Texture2D
    = extern self.associatedAlphaSplitTexture

  pub fn border -> UnityEngine.Vector4
    = extern self.border

  pub fn bounds -> UnityEngine.Bounds
    = extern self.bounds

  pub fn name -> string
    = extern self.name

  pub fn packed -> bool
    = extern self.packed

  pub fn packing_mode -> UnityEngine.SpritePackingMode
    = extern self.packingMode

  pub fn packing_rotation -> UnityEngine.SpritePackingRotation
    = extern self.packingRotation

  pub fn pivot -> UnityEngine.Vector2
    = extern self.pivot

  pub fn pixels_per_unit -> f32
    = extern self.pixelsPerUnit

  pub fn rect -> UnityEngine.Rect
    = extern self.rect

  pub fn sprite_atlas_texture_scale -> f32
    = extern self.spriteAtlasTextureScale

  pub fn texture_rect_offset -> UnityEngine.Vector2
    = extern self.textureRectOffset

  pub fn texture_rect -> UnityEngine.Rect
    = extern self.textureRect

  pub fn texture -> UnityEngine.Texture2D
    = extern self.texture

  pub fn triangles -> [u16]
    = extern self.triangles

  pub fn uv -> [UnityEngine.Vector2]
    = extern self.uv

  pub fn vertices -> [UnityEngine.Vector2]
    = extern self.vertices

  pub fn set_name(value: string)
    = extern self.name = value
}
