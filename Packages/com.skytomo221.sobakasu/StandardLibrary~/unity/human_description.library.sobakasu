public struct HumanDescription = extern UnityEngine.HumanDescription {
  human: [UnityEngine::HumanBone] = extern human,
  skeleton: [UnityEngine::SkeletonBone] = extern skeleton,
}

implementation HumanDescription {
  public function equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  public function reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  public function get_type(self) -> System::Type
    = extern self.GetType()

  public function arm_stretch(self) -> f32
    = extern self.armStretch

  public function feet_spacing(self) -> f32
    = extern self.feetSpacing

  public function has_translation_do_f(self) -> bool
    = extern self.hasTranslationDoF

  public function leg_stretch(self) -> f32
    = extern self.legStretch

  public function lower_arm_twist(self) -> f32
    = extern self.lowerArmTwist

  public function lower_leg_twist(self) -> f32
    = extern self.lowerLegTwist

  public function upper_arm_twist(self) -> f32
    = extern self.upperArmTwist

  public function upper_leg_twist(self) -> f32
    = extern self.upperLegTwist

  public function set_arm_stretch(self, value: f32)
    = extern self.armStretch = value

  public function set_feet_spacing(self, value: f32)
    = extern self.feetSpacing = value

  public function set_has_translation_do_f(self, value: bool)
    = extern self.hasTranslationDoF = value

  public function set_leg_stretch(self, value: f32)
    = extern self.legStretch = value

  public function set_lower_arm_twist(self, value: f32)
    = extern self.lowerArmTwist = value

  public function set_lower_leg_twist(self, value: f32)
    = extern self.lowerLegTwist = value

  public function set_upper_arm_twist(self, value: f32)
    = extern self.upperArmTwist = value

  public function set_upper_leg_twist(self, value: f32)
    = extern self.upperLegTwist = value
}
