pub struct HumanLimit = extern UnityEngine.HumanLimit {
}

impl HumanLimit {
  pub fn equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.Equals(obj_a, obj_b)

  pub fn reference_equals(obj_a: object, obj_b: object) -> bool
    = extern System.Object.ReferenceEquals(obj_a, obj_b)

  pub fn get_type(self) -> System::Type
    = extern self.GetType()

  pub fn axis_length(self) -> f32
    = extern self.axisLength

  pub fn center(self) -> UnityEngine::Vector3
    = extern self.center

  pub fn max(self) -> UnityEngine::Vector3
    = extern self.max

  pub fn min(self) -> UnityEngine::Vector3
    = extern self.min

  pub fn use_default_values(self) -> bool
    = extern self.useDefaultValues

  pub fn set_axis_length(self, value: f32)
    = extern self.axisLength = value

  pub fn set_center(self, value: UnityEngine::Vector3)
    = extern self.center = value

  pub fn set_max(self, value: UnityEngine::Vector3)
    = extern self.max = value

  pub fn set_min(self, value: UnityEngine::Vector3)
    = extern self.min = value

  pub fn set_use_default_values(self, value: bool)
    = extern self.useDefaultValues = value
}
