state {
  public count = 1;
}

behavior {
  on interact(state) {
    if state.count % 15 == 0 {
      log("FizzBuzz");
    } else if state.count % 3 == 0 {
      log("Fizz");
    } else if state.count % 5 == 0 {
      log("Buzz");
    } else {
      log(state.count);
    }

    state.count += 1;
  }
}
