use unity::GameObject;

state {
  public target: Maybe<GameObject> = field;
}

behavior {
  on interact(state) {
    send event to all;
  }

  receive event(state) {
    match state.target {
      Maybe::Just(target) => target.set_active(!target.active_self),
      Maybe::Nothing => log_warning("Target GameObject is not set."),
    }
  }
}
